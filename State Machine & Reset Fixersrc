/**
 * COMPLETE GAME RESET
 * Clears every transient object, restores player to Threshold spawn,
 * rebuilds the spatial hash, and forces the store back to a clean
 * “playing” state. Prevents memory leaks and dirty zone variables.
 */
resetGame() {
  // 1. Destroy all live enemies / projectiles / particles
  this.enemies.forEach(e => {
    if (e.mesh) this.scene.remove(e.mesh);
    e.mesh = null;
  });
  this.enemies.length = 0;
  this.projectiles.length = 0;
  this.particles.length = 0;

  // 2. Reset player vitals & position (Threshold spawn)
  this.runes.clear();
  this.health = 100;
  this.kills = 0;
  this.px = 0;
  this.py = 0.35;
  this.pz = 68;
  this.vx = this.vy = this.vz = 0;
  this.yaw = 0;
  this.pitch = -0.08;

  // 3. Reset camera & viewmodel
  this.yawObj.position.set(0, 1.58, 68);
  this.yawObj.rotation.y = 0;
  this.camera.rotation.set(-0.08, 0, 0);
