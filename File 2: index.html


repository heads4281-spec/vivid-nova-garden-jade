<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CRIMSON SOVEREIGN · AUTO-UPDATE GAME SERVER</title>
<style>
  :root {
    --bg: #0a0508;
    --crimson: #c41e3a;
    --blood: #8b0000;
    --fog: #2a1a2e;
    --gold: #d4af37;
    --text: #f0e6e6;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: radial-gradient(ellipse at center, #1a0a12 0%, var(--bg) 70%);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    min-height: 100vh;
    line-height: 1.5;
  }
  .container { max-width: 960px; margin: 0 auto; padding: 1.5rem; }
  header {
    text-align: center;
    padding: 2rem 0 1rem;
    border-bottom: 1px solid var(--crimson);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 2.2rem;
    letter-spacing: 0.12em;
    color: var(--crimson);
    text-shadow: 0 0 18px rgba(196,30,58,0.55);
  }
  .subtitle { color: var(--gold); font-size: 0.9rem; margin-top: 0.3rem; letter-spacing: 0.18em; }
  .status-bar {
    background: rgba(0,0,0,0.4);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .lore {
    background: rgba(42,26,46,0.75);
    border-left: 4px solid var(--crimson);
    padding: 1.1rem 1.4rem;
    margin: 1.2rem 0;
    font-style: italic;
  }
  .panel {
    background: rgba(20,10,15,0.88);
    border: 1px solid #3a1a25;
    border-radius: 8px;
    padding: 1.1rem;
    margin-bottom: 1.1rem;
  }
  .panel h2 { color: var(--gold); font-size: 1.05rem; margin-bottom: 0.7rem; }
  button, .btn {
    background: linear-gradient(135deg, var(--crimson), var(--blood));
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.88rem;
    margin: 0.2rem;
    transition: 0.15s;
  }
  button:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(196,30,58,0.4); }
  input, select {
    background: #1a0f14;
    border: 1px solid #4a2a35;
    color: var(--text);
    padding: 0.4rem 0.65rem;
    border-radius: 4px;
    margin: 0.2rem;
  }
  .classes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
  .class-card {
    background: #1a0a10;
    border: 1px solid #3a1a25;
    padding: 0.55rem 0.9rem;
    border-radius: 5px;
    cursor: pointer;
    min-width: 110px;
    text-align: center;
    font-size: 0.9rem;
  }
  .class-card.active { border-color: var(--crimson); box-shadow: 0 0 8px rgba(196,30,58,0.35); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 0.5rem; }
  .stat { background: #12080c; padding: 0.5rem; border-radius: 4px; text-align: center; }
  .stat span { display: block; font-size: 1.25rem; color: var(--gold); }
  #masterPanel { display: none; border: 2px solid var(--gold); }
  #log {
    background: #0d0609;
    height: 160px;
    overflow-y: auto;
    padding: 0.7rem;
    font-family: monospace;
    font-size: 0.82rem;
    border-radius: 4px;
    margin-top: 0.7rem;
  }
  .news-item { padding: 0.3rem 0; border-bottom: 1px solid #2a1520; }
  .footer { text-align: center; margin-top: 1.8rem; font-size: 0.78rem; color: #666; }
  .auto-badge {
    background: #1a5c1a;
    color: #a0ffa0;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-size: 0.75rem;
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>CRIMSON SOVEREIGN</h1>
    <div class="subtitle">TYPE VII · FULL COLOUR CYCLE · AUTO GAME SERVER</div>
  </header>

  <div class="status-bar">
    <span>Version: <strong id="version">...</strong></span>
    <span>Auto-Update: <span class="auto-badge" id="updateStatus">CHECKING...</span></span>
    <span>Last sync: <span id="lastSync">—</span></span>
  </div>

  <div class="lore" id="loreText">Loading lore...</div>

  <div class="panel">
    <h2>Threshold Access</h2>
    <p>Code · <span id="mythCycles">...</span> galactic myth cycles</p>
    <p id="identifier">Loading...</p>
    <p id="codeFlavour">...</p>
    <div>
      <input type="text" id="codeInput" placeholder="Enter access code" value="63821">
      <button onclick="validateCode()">ENTER THE PALACE</button>
      <button onclick="showLore()">FULL LORE CODEX</button>
      <button onclick="thresholdBriefing()">THRESHOLD BRIEFING</button>
      <button onclick="forceUpdate()">Force Update Now</button>
    </div>
  </div>

  <div class="panel">
    <h2>Classes</h2>
    <div class="classes" id="classList"></div>
  </div>

  <div class="panel">
    <h2>Resources</h2>
    <div class="stats" id="statsPanel"></div>
  </div>

  <div class="panel">
    <h2>Live News / Server Feed</h2>
    <div id="newsFeed"></div>
  </div>

  <div class="panel">
    <h2>Commands</h2>
    <button onclick="runCmd('newcode')">New code</button>
    <button onclick="runCmd('sharecycle')">Share cycle</button>
    <button onclick="runCmd('settings')">Settings</button>
    <button onclick="runCmd('master')">Master Panel</button>
    <button onclick="runCmd('server')">Server Status</button>
    <button onclick="exportUpdate()">Export Current Build</button>
  </div>

  <div class="panel" id="masterPanel">
    <h2>⚡ MASTER SERVER CONTROLS (Auto-Synced)</h2>
    <p>Online players: <span id="playerCount">1</span> · Fog: <span id="fogLevel">42%</span> · Blood canals: <span id="bloodLevel">67%</span></p>
    <div>
      <input type="text" id="broadcastMsg" placeholder="Broadcast message">
      <button onclick="broadcast()">Broadcast</button>
    </div>
    <div>
      <select id="grantStat">
        <option value="strength">strength</option>
        <option value="magic">magic</option>
        <option value="attack">attack</option>
        <option value="minerals">minerals</option>
      </select>
      <input type="number" id="grantAmount" value="5" style="width:70px">
      <button onclick="grantResource()">Grant Resource</button>
    </div>
    <button onclick="toggleLoreMode()">Toggle Lore Mode</button>
    <div id="log"></div>
  </div>

  <div class="footer">
    CRIMSON SOVEREIGN · One Game Server · All Codes Active · Automatic GitHub Updates<br>
    Change config.json on GitHub → every open client updates itself
  </div>
</div>

<script>
// ============== CONFIG ==============
// Change this to your own GitHub raw URL after you push the files
const CONFIG_URL = "https://raw.githubusercontent.com/YOUR-USERNAME/crimson-sovereign/main/config.json";
// For testing you can temporarily use a local file or keep the above and replace YOUR-USERNAME

let config = null;
let currentCode = "63821";
let currentClass = null;
let stats = { strength: 12, magic: 8, attack: 15, minerals: 40 };
let updateInterval = null;

// ============== AUTO UPDATE ENGINE ==============
async function fetchConfig() {
  try {
    document.getElementById("updateStatus").textContent = "UPDATING...";
    document.getElementById("updateStatus").style.background = "#5c4a1a";

    const res = await fetch(CONFIG_URL + "?t=" + Date.now()); // cache-bust
    if (!res.ok) throw new Error("Network error");
    const newConfig = await res.json();

    // Apply the new config
    config = newConfig;
    applyConfig();

    document.getElementById("updateStatus").textContent = "LIVE";
    document.getElementById("updateStatus").style.background = "#1a5c1a";
    document.getElementById("lastSync").textContent = new Date().toLocaleTimeString();
    log("Auto-update successful · v" + config.version);
  } catch (err) {
    document.getElementById("updateStatus").textContent = "OFFLINE";
    document.getElementById("updateStatus").style.background = "#5c1a1a";
    log("Update failed: " + err.message + " (using last known config)");
  }
}

function applyConfig() {
  if (!config) return;

  document.getElementById("version").textContent = config.version;
  document.getElementById("mythCycles").textContent = config.mythCycles.toLocaleString();
  document.getElementById("identifier").textContent = config.identifier;
  document.getElementById("codeFlavour").textContent = config.codeFlavour;
  document.getElementById("loreText").innerHTML = config.loreText.replace(/\n/g, "<br>");
  document.getElementById("playerCount").textContent = config.playersOnline;
  document.getElementById("fogLevel").textContent = config.fog + "%";
  document.getElementById("bloodLevel").textContent = config.blood + "%";

  // Classes
  const classList = document.getElementById("classList");
  classList.innerHTML = "";
  config.classes.forEach(c => {
    const div = document.createElement("div");
    div.className = "class-card";
    div.dataset.class = c;
    div.textContent = c;
    div.onclick = () => {
      document.querySelectorAll(".class-card").forEach(el => el.classList.remove("active"));
      div.classList.add("active");
      currentClass = c;
      log("Class selected: " + c);
    };
    classList.appendChild(div);
  });

  // Stats
  stats = { ...config.defaultStats };
  renderStats();

  // News
  const newsFeed = document.getElementById("newsFeed");
  newsFeed.innerHTML = "";
  (config.news || []).forEach(n => {
    const d = document.createElement("div");
    d.className = "news-item";
    d.textContent = "• " + n;
    newsFeed.appendChild(d);
  });
}

function renderStats() {
  const panel = document.getElementById("statsPanel");
  panel.innerHTML = "";
  for (const [key, val] of Object.entries(stats)) {
    const div = document.createElement("div");
    div.className = "stat";
    div.innerHTML = `${key}<br><span id="stat-${key}">${val}</span>`;
    panel.appendChild(div);
  }
}

// Start auto-update every 30 seconds
function startAutoUpdate() {
  fetchConfig(); // immediate
  if (updateInterval) clearInterval(updateInterval);
  updateInterval = setInterval(fetchConfig, 30000);
}

// ============== CORE GAME FUNCTIONS ==============
function validateCode() {
  const code = document.getElementById("codeInput").value.trim();
  if (config && config.validCodes.includes(code)) {
    currentCode = code;
    log("Access granted with code " + code);
    alert("Threshold crossed. Welcome, Sovereign.");
  } else {
    alert("Invalid code. The rift rejects you.");
    log("Failed access attempt: " + code);
  }
}

function showLore() {
  alert("FULL LORE CODEX\n\n" + (config ? config.loreText : "Loading..."));
  log("Full Lore Codex opened");
}

function thresholdBriefing() {
  alert(`THRESHOLD BRIEFING\n\nCode: ${currentCode}\nVersion: ${config ? config.version : "?"}\nClass: ${currentClass || "None"}\nAll scripts ON · Auto-update active`);
  log("Threshold Briefing delivered");
}

function runCmd(cmd) {
  switch (cmd) {
    case "newcode":
      const newC = prompt("Set new primary code (must be in validCodes):", currentCode);
      if (newC) {
        currentCode = newC;
        document.getElementById("codeInput").value = newC;
        log("Primary code set to " + newC);
      }
      break;
    case "sharecycle":
      const shareUrl = window.location.origin + window.location.pathname + "?code=" + currentCode;
      navigator.clipboard.writeText(shareUrl).then(() => {
        alert("Share link copied:\n" + shareUrl);
        log("Share cycle link copied");
      });
      break;
    case "settings":
      alert("Settings\n• Auto-update: ON (30s)\n• All codes active\n• One game server\n• GitHub config driven");
      log("Settings viewed");
      break;
    case "master":
      document.getElementById("masterPanel").style.display = "block";
      log("Master panel opened");
      break;
    case "server":
      alert(`SERVER STATUS\nPlayers: ${config ? config.playersOnline : 1}\nFog: ${config ? config.fog : 42}%\nBlood: ${config ? config.blood : 67}%\nVersion: ${config ? config.version : "?"}`);
      log("Server status checked");
      break;
  }
}

function log(msg) {
  const el = document.getElementById("log");
  const time = new Date().toLocaleTimeString();
  el.innerHTML += `[${time}] ${msg}<br>`;
  el.scrollTop = el.scrollHeight;
}

function broadcast() {
  const msg = document.getElementById("broadcastMsg").value;
  if (msg) {
    log("BROADCAST: " + msg);
    alert("Broadcast sent to the game server.");
  }
}

function grantResource() {
  const stat = document.getElementById("grantStat").value;
  const amount = parseInt(document.getElementById("grantAmount").value) || 0;
  stats[stat] = (stats[stat] || 0) + amount;
  document.getElementById("stat-" + stat).textContent = stats[stat];
  log("Granted +" + amount + " " + stat);
}

function toggleLoreMode() {
  if (!config) return;
  config.loreMode = config.loreMode === "blood" ? "fog" : "blood";
  if (config.loreMode === "blood") {
    config.codeFlavour = "This code thickens blood in the canals. The Milky Way hungers with the palace.";
    config.identifier = "CNLMMR · SOVEREIGN LV 6294 · 10 000 OPEN-WORLD MOMENTS";
  } else {
    config.codeFlavour = "This code stills the fog. The galaxy turns slow and polite.";
    config.identifier = "TKNYRT · SOVEREIGN LV 4793 · 10 000 OPEN-WORLD MOMENTS";
  }
  applyConfig();
  log("Lore mode switched to " + config.loreMode);
}

function forceUpdate() {
  fetchConfig();
}

function exportUpdate() {
  const html = document.documentElement.outerHTML;
  const blob = new Blob([html], { type: "text/html" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "crimson-sovereign-auto.html";
  a.click();
  log("Current build exported");
}

// URL code support
const urlParams = new URLSearchParams(window.location.search);
if (urlParams.get("code")) {
  document.getElementById("codeInput").value = urlParams.get("code");
}

// Start everything
startAutoUpdate();
</script>
</body>
</html>