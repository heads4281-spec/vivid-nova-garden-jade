// Inside the Worker
self.onmessage = (e) => {
  if (e.data.type === 'init') {
    // Receive the SharedArrayBuffer once
    const sab = e.data.sab;
    // ... create the same views ...
    startWorkerLoop();
  }
};

function startWorkerLoop() {
  while (true) {
    // Wait until there is work
    Atomics.wait(meta, HEAD, Atomics.load(meta, TAIL));

    const tail = Atomics.load(meta, TAIL);
    const head = Atomics.load(meta, HEAD);

    if (tail === head) continue;                   // spurious wake

    const cx = queue[tail];
    const cz = queue[tail + 1];
    Atomics.store(meta, TAIL, (tail + 2) % queue.length);

    // Generate the chunk (Perlin + fBm)
    const tiles = generateChunk(cx, cz);           // Uint8Array

    // Write result into shared memory (or postMessage the small metadata)
    // For simplicity we still postMessage the tiles (or write into a larger shared region)
    Atomics.store(meta, RESULT_CX, cx);
    Atomics.store(meta, RESULT_CZ, cz);
    Atomics.store(meta, RESULT_READY, 1);
    Atomics.notify(meta, RESULT_READY);

    // Optionally copy tiles into a shared tile buffer here
  }
}