class MeshLoader {
public:
    static bool loadOBJ(const std::string& filepath, Mesh& outMesh);
    static std::shared_ptr<Mesh> loadOBJShared(const std::string& filepath);

private:
    struct Vertex  { float x, y, z; };
    struct TexCoord{ float u, v; };
    struct Normal  { float x, y, z; };
    struct FaceIndex {
        int v  = -1;
        int vt = -1;
        int vn = -1;
    };

    static bool parseFace(const std::string& token, FaceIndex& out);

    // New: generate smooth vertex normals from triangle geometry
    static void generateNormals(
        const std::vector<Vertex>& positions,
        const std::vector<std::array<int, 3>>& triIndices, // pure vertex indices
        std::vector<Normal>& outNormals);
};

