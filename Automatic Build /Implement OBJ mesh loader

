#pragma once
#include "GameEntities.hpp"
#include <string>
#include <vector>
#include <memory>

class MeshLoader {
public:
    // Load a .obj file into a Mesh.
    // Returns true on success. The Mesh is fully populated and ready for OpenGLRHI.
    static bool loadOBJ(const std::string& filepath, Mesh& outMesh);

    // Convenience: load and return a shared_ptr (useful for Entity ownership)
    static std::shared_ptr<Mesh> loadOBJShared(const std::string& filepath);

private:
    struct Vertex {
        float x, y, z;
    };
    struct TexCoord {
        float u, v;
    };
    struct Normal {
        float x, y, z;
    };
    struct FaceIndex {
        int v = -1;   // vertex
        int vt = -1;  // texcoord
        int vn = -1;  // normal
    };

    static bool parseFace(const std::string& token, FaceIndex& out);
};
// Old (8 floats)
// glVertexAttribPointer(0, 3, ..., 8*sizeof(float), (void*)0);
// glVertexAttribPointer(1, 3, ..., 8*sizeof(float), (void*)(3*sizeof(float)));
// glVertexAttribPointer(2, 2, ..., 8*sizeof(float), (void*)(6*sizeof(float)));

// New (12 floats)
const size_t stride = 12 * sizeof(float);

glEnableVertexAttribArray(0); // position
glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, stride, (void*)0);

glEnableVertexAttribArray(1); // normal
glVertexAttribPointer(1, 3, GL_FLOAT, GL_FALSE, stride, (void*)(3 * sizeof(float)));

glEnableVertexAttribArray(2); // uv
glVertexAttribPointer(2, 2, GL_FLOAT, GL_FALSE, stride, (void*)(6 * sizeof(float)));

glEnableVertexAttribArray(3); // tangent (xyz + handedness)
glVertexAttribPointer(3, 4, GL_FLOAT, GL_FALSE, stride, (void*)(8 * sizeof(float)));