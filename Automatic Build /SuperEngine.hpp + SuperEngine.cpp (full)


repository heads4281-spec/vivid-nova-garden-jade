// SuperEngine.hpp
#pragma once
#include "MathTypes.hpp"
#include "GameEntities.hpp"
#include "LivesAPI.hpp"
#include <memory>
#include <vector>
#include <string>

enum class GraphicsAPI { OpenGL, Vulkan, DirectX12, Metal, ThreeJS };

class IRHI {
public:
    virtual ~IRHI() = default;
    virtual bool init(void* window, int w, int h) = 0;
    virtual void beginFrame() = 0;
    virtual void draw(const Entity& e, const mat4_t& model, const mat4_t& viewProj) = 0;
    virtual void endFrame() = 0;
    virtual void shutdown() = 0;
};

class SuperEngine {
public:
    bool init(GraphicsAPI api, void* nativeWindow, int width, int height);
    void update(float dt);
    void render();
    void shutdown();

    LivesAPI& getLivesAPI() { return livesAPI; }
    Entity* getPlayer() { return player; }
    void claimGate(int index);          // call when player reaches a Gate

private:
    std::unique_ptr<IRHI> rhi;
    std::vector<Entity> entities;
    Entity* player = nullptr;
    LivesAPI livesAPI;

    mat4_t view, proj;
    vec3_t cameraPos{0.f, 3.5f, 12.f};
    vec3_t cameraTarget{0.f, 1.f, 0.f};
    int width = 1920, height = 1080;
    float time = 0.f;

    void spawnSovereign();
    void spawnWave(int count);
};