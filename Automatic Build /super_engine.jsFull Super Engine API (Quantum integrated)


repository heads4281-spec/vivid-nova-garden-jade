class SuperEngine {
    constructor(canvasId) {
        this.canvas = document.getElementById(canvasId);
        this.ctx = this.canvas.getContext("2d");
        this.width = this.canvas.width = 1280;
        this.height = this.canvas.height = 720;

        this.entities = [];
        this.gates = [];
        this.player = null;
        this.config = null;
        this.time = 0;
        this.camera = { x: 0, y: 0 };
        this.keys = {};
        this.livesCount = 3;

        this.api = window.QuantumLive;
        this.setupInput();
    }

    async loadFormation(url = "game_formation.json") {
        const res = await fetch(url);
        this.config = await res.json();
        this.buildFromConfig();
        console.log("[SuperEngine] Quantum Formation loaded:", this.config.meta.title);
    }

    buildFromConfig() {
        this.entities = [];
        this.gates = [];

        const p = this.config.player;
        this.player = {
            type: "Sovereign",
            name: p.name,
            x: p.position[0],
            y: p.position[1],
            health: p.health,
            maxHealth: p.health,
            crimsonPower: p.crimsonPower,
            speed: p.speed,
            radius: 18,
            color: "#ff2244"
        };
        this.livesCount = p.lives || 3;

        (this.config.gates || []).forEach(g => {
            this.gates.push({ ...g, radius: 26, color: "#cc1144" });
        });

        (this.config.entities || []).forEach(e => {
            this.entities.push({
                ...e,
                radius: e.type === "Boss" ? 38 : 14,
                color: e.type === "Boss" ? "#ff0066" : "#bb2233",
                state: "idle",
                attackTimer: 0,
                maxHealth: e.health
            });
        });

        if (this.config.systems) {
            this.api.set("ai", this.config.systems.ai_enabled ?? 1);
            this.api.set("lives", this.config.systems.lives_enabled ? 1 : 0);
            this.api.set("formations", 1);
        }
    }

    setupInput() {
        window.addEventListener("keydown", e => {
            this.keys[e.key.toLowerCase()] = true;

            if (e.key === "F1") this.api.toggle("ai");
            if (e.key === "F2") this.api.toggle("formations");
            if (e.key === "F3") this.api.toggle("lives");
            if (e.key === "0")  this.api.set("ai", 0);
            if (e.key === "1")  this.api.set("ai", 1);
            if (e.key === "q" || e.key === "Q") this.api.cycleMode();
            if (e.key === "p" || e.key === "P") this.api.enableAutoPulse(!this.api.autoPulse);
        });
        window.addEventListener("keyup", e => {
            this.keys[e.key.toLowerCase()] = false;
        });
    }

    updateAI(dt) {
        if (!this.api.isOn("ai")) return;

        this.entities.forEach(e => {
            if (e.health <= 0) return;

            const dx = this.player.x - e.x;
            const dy = this.player.y - e.y;
            const dist = Math.hypot(dx, dy) || 1;
            const dirX = dx / dist;
            const dirY = dy / dist;
            const healthPct = e.health / (e.maxHealth || 100);

            if (healthPct < 0.25 && dist < 310) {
                e.x -= dirX * e.speed * 1.7 * dt * 60;
                e.y -= dirY * e.speed * 1.7 * dt * 60;
                e.state = "flee";
            } else if (dist < 42) {
                e.attackTimer -= dt;
                if (e.attackTimer <= 0) {
                    this.player.health -= (e.damage || 12);
                    e.attackTimer = 0.9;
                    e.state = "attack";
                }
            } else if (dist < 360) {
                e.x += dirX * e.speed * dt * 60;
                e.y += dirY * e.speed * dt * 60;
                e.state = "chase";
            } else {
                e.state = "idle";
            }
            e.crimsonPower = (e.crimsonPower + dt * 18) % 100;
        });
    }

    updatePlayer(dt) {
        let mx = 0, my = 0;
        if (this.keys["w"] || this.keys["arrowup"])    my -= 1;
        if (this.keys["s"] || this.keys["arrowdown"])  my += 1;
        if (this.keys["a"] || this.keys["arrowleft"])  mx -= 1;
        if (this.keys["d"] || this.keys["arrowright"]) mx += 1;

        const len = Math.hypot(mx, my) || 1;
        this.player.x += (mx / len) * this.player.speed * dt * 60;
        this.player.y += (my / len) * this.player.speed * dt * 60;

        this.camera.x += (this.player.x - this.camera.x) * 0.09;
        this.camera.y += (this.player.y - this.camera.y) * 0.09;

        if (this.api.isOn("lives") && this.player.health <= 0) {
            this.livesCount--;
            if (this.livesCount > 0) {
                this.player.health = this.player.maxHealth * 0.7;
                this.player.x = 0;
                this.player.y = 0;
            } else {
                this.player.health = 0;
            }
        }
    }

    update(dt) {
        this.time += dt;
        this.api.update(dt);               // Quantum live update
        this.updatePlayer(dt);
        this.updateAI(dt);
    }

    drawCircle(x, y, r, color, glow = false) {
        const sx = x - this.camera.x + this.width / 2;
        const sy = y - this.camera.y + this.height / 2;
        if (glow) {
            this.ctx.shadowBlur = 22;
            this.ctx.shadowColor = color;
        }
        this.ctx.beginPath();
        this.ctx.arc(sx, sy, r, 0, Math.PI * 2);
        this.ctx.fillStyle = color;
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
    }

    render() {
        this.ctx.fillStyle = this.config?.world?.background || "#0a0508";
        this.ctx.fillRect(0, 0, this.width, this.height);

        const formAlpha = this.api.isOn("formations") ? 1.0 : 0.22;
        this.ctx.globalAlpha = formAlpha;
        this.gates.forEach(g => this.drawCircle(g.x, g.y, g.radius, g.color, true));
        this.ctx.globalAlpha = 1.0;

        this.entities.forEach(e => {
            if (e.health <= 0) return;
            this.drawCircle(e.x, e.y, e.radius, e.color, e.state === "attack");
        });

        this.drawCircle(this.player.x, this.player.y, this.player.radius, this.player.color, true);

        // HUD
        this.ctx.fillStyle = "#ffccdd";
        this.ctx.font = "16px monospace";
        this.ctx.fillText(`Quantum Mode: ${this.api.mode}`, 20, 28);
        this.ctx.fillText(`AI: ${this.api.isOn("ai") ? "ON" : "OFF"} (key ${this.api.get("ai")})`, 20, 54);
        this.ctx.fillText(`Formations: ${this.api.isOn("formations") ? "ON" : "OFF"}`, 20, 80);
        this.ctx.fillText(`Lives: ${this.api.isOn("lives") ? "ON" : "OFF"} | ${this.livesCount}`, 20, 106);
        this.ctx.fillText(`Health: ${Math.max(0, Math.floor(this.player.health))}`, 20, 132);
        this.ctx.fillText(`Crimson Power: ${Math.floor(this.player.crimsonPower)}`, 20, 158);
        this.ctx.fillText(`Auto Pulse: ${this.api.autoPulse ? "ON" : "OFF"}`, 20, 184);

        if (this.config) {
            this.ctx.fillText(this.config.meta.title, 20, this.height - 24);
        }
    }

    start() {
        let last = performance.now();
        const loop = (now) => {
            const dt = Math.min((now - last) / 1000, 0.05);
            last = now;
            this.update(dt);
            this.render();
            requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
    }
}

window.SuperEngine = SuperEngine;
