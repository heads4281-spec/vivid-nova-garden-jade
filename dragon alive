def _validate_args(args: argparse.Namespace) -> None:
    """Validate and fill missing arguments with sensible defaults."""
    assert args.ckpt_dir is not None, "Please specify the checkpoint directory (--ckpt_dir)."
    assert args.task in WAN_CONFIGS, f"Unsupported task: {args.task}"
    assert args.task in EXAMPLE_PROMPT, f"Unsupported task: {args.task}"

    # Fill missing prompt / image / audio from examples
    if args.prompt is None:
        args.prompt = EXAMPLE_PROMPT[args.task]["prompt"]

    example = EXAMPLE_PROMPT[args.task]
    if args.image is None and "image" in example:
        args.image = example["image"]

    if args.audio is None and not args.enable_tts and "audio" in example:
        args.audio = example["audio"]

    if args.enable_tts and (args.tts_prompt_audio is None or args.tts_text is None):
        if "tts_prompt_audio" in example:
            args.tts_prompt_audio = example["tts_prompt_audio"]
            args.tts_prompt_text = example.get("tts_prompt_text")
            args.tts_text = example["tts_text"]

    if args.task == "i2v-A14B":
        assert args.image is not None, "Please specify --image for i2v task."

    cfg = WAN_CONFIGS[args.task]

    # Fill sampling defaults from config
    if args.sample_steps is None:
        args.sample_steps = cfg.sample_steps
    if args.sample_shift is None:
        args.sample_shift = cfg.sample_shift
    if args.sample_guide_scale is None:
        args.sample_guide_scale = cfg.sample_guide_scale
    if args.frame_num is None:
        args.frame_num = cfg.frame_num

    # Seed
    args.base_seed = (
        args.base_seed if args.base_seed >= 0 else random.randint(0, sys.maxsize)
    )

    # Size check (s2v is flexible)
    if "s2v" not in args.task:
        assert args.size in SUPPORTED_SIZES[args.task], (
            f"Unsupported size {args.size} for task {args.task}. "
            f"Supported: {', '.join(SUPPORTED_SIZES[args.task])}"
        )


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate image or video from text / image / audio using Wan models"
    )

    # Core
    parser.add_argument(
        "--task",
        type=str,
        default="t2v-A14B",
        choices=list(WAN_CONFIGS.keys()),
        help="Task to run",
    )
    parser.add_argument(
        "--size",
        type=str,
        default="1280*720",
        choices=list(SIZE_CONFIGS.keys()),
        help="Resolution (width*height). For I2V the aspect ratio follows the input image.",
    )
    parser.add_argument(
        "--frame_num",
        type=int,
        default=None,
        help="Number of frames (must be 4n+1)",
    )
    parser.add_argument(
        "--ckpt_dir",
        type=str,
        default=None,
        help="Path to the checkpoint directory",
    )
    parser.add_argument(
        "--offload_model",
        type=str2bool,
        default=None,
        help="Offload models to CPU after each forward to save VRAM",
    )
    parser.add_argument(
        "--ulysses_size",
        type=int,
        default=1,
        help="Sequence-parallel (Ulysses) size for DiT",
    )
    parser.add_argument("--t5_fsdp", action="store_true", help="Enable FSDP for T5")
    parser.add_argument("--t5_cpu", action="store_true", help="Keep T5 on CPU")
    parser.add_argument("--dit_fsdp", action="store_true", help="Enable FSDP for DiT")
    parser.add_argument(
        "--save_file",
        type=str,
        default=None,
        help="Output video path (auto-generated if omitted)",
    )
    parser.add_argument("--prompt", type=str, default=None, help="Text prompt")
    parser.add_argument(
        "--use_prompt_extend",
        action="store_true",
        help="Enable prompt expansion",
    )
    parser.add_argument(
        "--prompt_extend_method",
        type=str,
        default="local_qwen",
        choices=["dashscope", "local_qwen"],
        help="Prompt expansion backend",
    )
    parser.add_argument(
        "--prompt_extend_model",
        type=str,
        default=None,
        help="Model name for prompt expansion",
    )
    parser.add_argument(
        "--prompt_extend_target_lang",
        type=str,
        default="zh",
        choices=["zh", "en"],
        help="Target language for prompt expansion",
    )
    parser.add_argument(
        "--base_seed",
        type=int,
        default=-1,
        help="Random seed (-1 = random)",
    )
    parser.add_argument("--image", type=str, default=None, help="Input image path")
    parser.add_argument(
        "--sample_solver",
        type=str,
        default="unipc",
        choices=["unipc", "dpm++"],
        help="Diffusion solver",
    )
    parser.add_argument("--sample_steps", type=int, default=None, help="Sampling steps")
    parser.add_argument(
        "--sample_shift",
        type=float,
        default=None,
        help="Flow-matching shift factor",
    )
    parser.add_argument(
        "--sample_guide_scale",
        type=float,
        default=None,
        help="Classifier-free guidance scale",
    )
    parser.add_argument(
        "--convert_model_dtype",
        action="store_true",
        help="Convert DiT parameters to config.param_dtype",
    )

    # Animate-specific
    parser.add_argument("--src_root_path", type=str, default=None)
    parser.add_argument(
        "--refert_num",
        type=int,
        default=77,
        help="Frames used for temporal guidance (recommend 1 or 5)",
    )
    parser.add_argument("--replace_flag", action="store_true")
    parser.add_argument("--use_relighting_lora", action="store_true")

    # S2V-specific
    parser.add_argument(
        "--num_clip",
        type=int,
        default=None,
        help="Number of video clips (capped by audio length)",
    )
    parser.add_argument("--audio", type=str, default=None, help="Audio file path")
    parser.add_argument(
        "--enable_tts",
        action="store_true",
        help="Synthesize audio with CosyVoice",
    )
    parser.add_argument(
        "--tts_prompt_audio",
        type=str,
        default=None,
        help="TTS reference audio (16 kHz+, 5-15 s)",
    )
    parser.add_argument(
        "--tts_prompt_text",
        type=str,
        default=None,
        help="Exact transcript of tts_prompt_audio",
    )
    parser.add_argument("--tts_text", type=str, default=None, help="Text to synthesize")
    parser.add_argument(
        "--pose_video",
        type=str,
        default=None,
        help="DW-Pose sequence for pose-driven generation",
    )
    parser.add_argument(
        "--start_from_ref",
        action="store_true",
        help="Use reference image as the first frame",
    )
    parser.add_argument(
        "--infer_frames",
        type=int,
        default=80,
        help="Frames per clip (multiple of 4) for s2v-14B",
    )

    args = parser.parse_args()
    _validate_args(args)
    return args


def _init_logging(rank: int) -> None:
    if rank == 0:
        logging.basicConfig(
            level=logging.INFO,
            format="[%(asctime)s] %(levelname)s: %(message)s",
            handlers=[logging.StreamHandler(sys.stdout)],
        )
    else:
        logging.basicConfig(level=logging.ERROR)


def generate(args: argparse.Namespace) -> None:
    rank = int(os.getenv("RANK", 0))
    world_size = int(os.getenv("WORLD_SIZE", 1))
    local_rank = int(os.getenv("LOCAL_RANK", 0))
    device = local_rank

    _init_logging(rank)

    # Auto-enable offload when running single-GPU
    if args.offload_model is None:
        args.offload_model = world_size == 1
        logging.info(f"offload_model not specified → set to {args.offload_model}")

    # Distributed setup
    if world_size > 1:
        torch.cuda.set_device(local_rank)
        dist.init_process_group(
            backend="nccl",
            init_method="env://",
            rank=rank,
            world_size=world_size,
        )
    else:
        assert not (args.t5_fsdp or args.dit_fsdp), (
            "FSDP is only supported in distributed mode"
        )
        assert args.ulysses_size <= 1, (
            "Sequence parallel requires distributed launch"
        )

    if args.ulysses_size > 1:
        assert args.ulysses_size == world_size, (
            "ulysses_size must equal world_size"
        )
        init_distributed_group()

    # Prompt expander
    prompt_expander = None
    if args.use_prompt_extend:
        if args.prompt_extend_method == "dashscope":
            prompt_expander = DashScopePromptExpander(
                model_name=args.prompt_extend_model,
                task=args.task,
                is_vl=args.image is not None,
            )
        elif args.prompt_extend_method == "local_qwen":
            prompt_expander = QwenPromptExpander(
                model_name=args.prompt_extend_model,
                task=args.task,
                is_vl=args.image is not None,
                device=rank,
            )
        else:
            raise NotImplementedError(
                f"Unknown prompt_extend_method: {args.prompt_extend_method}"
            )

    cfg = WAN_CONFIGS[args.task]
    if args.ulysses_size > 1:
        assert cfg.num_heads % args.ulysses_size == 0, (
            f"num_heads ({cfg.num_heads}) must be divisible by ulysses_size "
            f"({args.ulysses_size})"
        )

    logging.info(f"Generation args: {args}")
    logging.info(f"Model config: {cfg}")

    # Broadcast seed
    if dist.is_initialized():
        seed_list = [args.base_seed] if rank == 0 else [None]
        dist.broadcast_object_list(seed_list, src=0)
        args.base_seed = seed_list[0]

    logging.info(f"Input prompt: {args.prompt}")
    img = None
    if args.image is not None:
        img = Image.open(args.image).convert("RGB")
        logging.info(f"Input image: {args.image}")

    # Prompt expansion
    if args.use_prompt_extend and prompt_expander is not None:
        logging.info("Extending prompt ...")
        if rank == 0:
            result = prompt_expander(
                args.prompt,
                image=img,
                tar_lang=args.prompt_extend_target_lang,
                seed=args.base_seed,
            )
            if not result.status:
                logging.warning(f"Prompt extension failed: {result.message}")
                logging.warning("Falling back to original prompt.")
                extended = args.prompt
            else:
                extended = result.prompt
            prompt_list = [extended]
        else:
            prompt_list = [None]

        if dist.is_initialized():
            dist.broadcast_object_list(prompt_list, src=0)
        args.prompt = prompt_list[0]
        logging.info(f"Extended prompt: {args.prompt}")

    # ------------------------------------------------------------------ #
    # Dispatch to the correct pipeline
    # ------------------------------------------------------------------ #
    common_kwargs = dict(
        config=cfg,
        checkpoint_dir=args.ckpt_dir,
        device_id=device,
        rank=rank,
        t5_fsdp=args.t5_fsdp,
        dit_fsdp=args.dit_fsdp,
        use_sp=(args.ulysses_size > 1),
        t5_cpu=args.t5_cpu,
        convert_model_dtype=args.convert_model_dtype,
    )

    if "t2v" in args.task:
        logging.info("Creating WanT2V pipeline")
        pipeline = wan.WanT2V(**common_kwargs)
        video = pipeline.generate(
            args.prompt,
            size=SIZE_CONFIGS[args.size],
            frame_num=args.frame_num,
            shift=args.sample_shift,
            sample_solver=args.sample_solver,
            sampling_steps=args.sample_steps,
            guide_scale=args.sample_guide_scale,
            seed=args.base_seed,
            offload_model=args.offload_model,
        )

    elif "ti2v" in args.task:
        logging.info("Creating WanTI2V pipeline")
        pipeline = wan.WanTI2V(**common_kwargs)
        video = pipeline.generate(
            args.prompt,
            img=img,
            size=SIZE_CONFIGS[args.size],
            max_area=MAX_AREA_CONFIGS[args.size],
            frame_num=args.frame_num,
            shift=args.sample_shift,
            sample_solver=args.sample_solver,
            sampling_steps=args.sample_steps,
            guide_scale=args.sample_guide_scale,
            seed=args.base_seed,
            offload_model=args.offload_model,
        )

    elif "animate" in args.task:
        logging.info("Creating Wan-Animate pipeline")
        pipeline = wan.WanAnimate(
            **common_kwargs,
            use_relighting_lora=args.use_relighting_lora,
        )
        video = pipeline.generate(
            src_root_path=args.src_root_path,
            replace_flag=args.replace_flag,
            refert_num=args.refert_num,
            clip_len=args.frame_num,
            shift=args.sample_shift,
            sample_solver=args.sample_solver,
            sampling_steps=args.sample_steps,
            guide_scale=args.sample_guide_scale,
            seed=args.base_seed,
            offload_model=args.offload_model,
        )

    elif "s2v" in args.task:
        logging.info("Creating WanS2V pipeline")
        pipeline = wan.WanS2V(**common_kwargs)
        video = pipeline.generate(
            input_prompt=args.prompt,
            ref_image_path=args.image,
            audio_path=args.audio,
            enable_tts=args.enable_tts,
            tts_prompt_audio=args.tts_prompt_audio,
            tts_prompt_text=args.tts_prompt_text,
            tts_text=args.tts_text,
            num_repeat=args.num_clip,
            pose_video=args.pose_video,
            max_area=MAX_AREA_CONFIGS[args.size],
            infer_frames=args.infer_frames,
            shift=args.sample_shift,
            sample_solver=args.sample_solver,
            sampling_steps=args.sample_steps,
            guide_scale=args.sample_guide_scale,
            seed=args.base_seed,
            offload_model=args.offload_model,
            init_first_frame=args.start_from_ref,
        )

    else:  # i2v
        logging.info("Creating WanI2V pipeline")
        pipeline = wan.WanI2V(**common_kwargs)
        video = pipeline.generate(
            args.prompt,
            img,
            max_area=MAX_AREA_CONFIGS[args.size],
            frame_num=args.frame_num,
            shift=args.sample_shift,
            sample_solver=args.sample_solver,
            sampling_steps=args.sample_steps,
            guide_scale=args.sample_guide_scale,
            seed=args.base_seed,
            offload_model=args.offload_model,
        )

    # ------------------------------------------------------------------ #
    # Save result (rank 0 only)
    # ------------------------------------------------------------------ #
    if rank == 0 and video is not None:
        if args.save_file is None:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            safe_prompt = (
                args.prompt.replace(" ", "_").replace("/", "_")[:50]
            )
            size_str = args.size.replace("*", "x") if sys.platform == "win32" else args.size
            args.save_file = (
                f"{args.task}_{size_str}_{args.ulysses_size}_"
                f"{safe_prompt}_{timestamp}.mp4"
            )

        logging.info(f"Saving generated video → {args.save_file}")
        save_video(
            tensor=video[None],
            save_file=args.save_file,
            fps=cfg.sample_fps,
            nrow=1,
            normalize=True,
            value_range=(-1, 1),
        )

        # Optional audio merge for s2v
        if "s2v" in args.task and args.audio is not None and not args.enable_tts:
            logging.info("Merging original audio into the video ...")
            merge_video_audio(args.save_file, args.audio)

        logging.info("Generation finished successfully.")


if __name__ == "__main__":
    args = _parse_args()
    generate(args)