function spawnMath() {
  if (mathActive || state !== 'idle') return;
  const types = [
    () => { const a = randInt(4, 15), b = randInt(3, 12); return { q: `${a} + ${b}`, ans: a + b }; },
    () => { const a = randInt(12, 24), b = randInt(2, 10); return { q: `${a} − ${b}`, ans: a - b }; },
    () => { const a = randInt(3, 9), b = randInt(2, 8); return { q: `${a} × ${b}`, ans: a * b }; }
  ];
  currentMath = types[randInt(0, 2)]();
  document.getElementById('mathQ').textContent = currentMath.q + ' = ?';
  document.getElementById('mathAns').value = '';
  document.getElementById('mathBox').style.display = 'block';
  document.getElementById('mathAns').focus();
  mathActive = true;
}

function checkMath() {
  const val = parseInt(document.getElementById('mathAns').value);
  if (val === currentMath.ans) {
    power = Math.min(100, power + 25);
    score += 200 * level;
    combo++;
    showMsg('A.I. POWER BOOST!\n+' + 25 + ' Power', '#0ff');
    if (power >= 100) {
      level++;
      power = 40;
      showMsg('LEVEL UP!\nDouble Flip Unlocked', '#ffd700');
    }
  } else {
    showMsg('Wrong', '#f66');
    power = Math.max(0, power - 8);
    combo = 0;
  }
  document.getElementById('mathBox').style.display = 'none';
  mathActive = false;
  currentMath = null;
  updateUI();
}

document.getElementById('mathAns').addEventListener('keydown', e => {
