<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>336-lb Standing Backflip – Full Moments + Math</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #0a1628;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #eee;
    overflow: hidden;
  }
  #wrapper {
    position: relative;
    box-shadow: 0 0 60px rgba(0, 180, 255, 0.35);
    border-radius: 12px;
    overflow: hidden;
  }
  canvas { display: block; background: #87CEEB; }
  #ui {
    position: absolute;
    top: 12px;
    left: 0;
    width: 100%;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    text-shadow: 0 2px 6px #000;
    z-index: 10;
  }
  .stat { font-size: 16px; font-weight: bold; }
  #score { color: #ffd700; font-size: 22px; }
  #power { color: #0ff; }
  #message {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 32px;
    font-weight: bold;
    color: #fff;
    text-shadow: 0 0 20px #000;
    display: none;
    text-align: center;
    pointer-events: none;
    z-index: 20;
  }
  #mathBox {
    position: absolute;
    top: 70px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.88);
    border: 3px solid #00e5ff;
    border-radius: 12px;
    padding: 14px 24px;
    display: none;
    text-align: center;
    z-index: 15;
    box-shadow: 0 0 25px rgba(0,229,255,0.5);
  }
  #mathQ { font-size: 24px; margin-bottom: 10px; color: #0ff; }
  #mathAns {
    width: 80px;
    font-size: 22px;
    text-align: center;
    padding: 6px;
    border-radius: 6px;
    border: 2px solid #00e5ff;
    background: #111;
    color: #fff;
  }
  #mathBox button {
    margin-left: 10px;
    padding: 6px 16px;
    font-size: 18px;
    background: #00e5ff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
  }
  #controls {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    color: #ddd;
    text-align: center;
    pointer-events: none;
    text-shadow: 0 1px 4px #000;
  }
</style>
</head>
<body>
<div id="wrapper">
  <canvas id="game" width="900" height="560"></canvas>
  <div id="ui">
    <div class="stat">Power: <span id="powerVal">0</span>%</div>
    <div id="score">Score: 0</div>
    <div class="stat">Level: <span id="level">1</span> | Flips: <span id="flips">0</span></div>
  </div>
  <div id="message"></div>
  <div id="mathBox">
    <div id="mathQ">9 + 7 = ?</div>
    <input type="number" id="mathAns" placeholder="?">
    <button onclick="checkMath()">FLIP!</button>
  </div>
  <div id="controls">
    SPACE = Charge & Launch Standing Backflip &nbsp;|&nbsp; Correct Math = Power Boost + Bigger Flip
  </div>
</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;

// ========== STATE ==========
let score = 0;
let power = 0;          // 0-100
let level = 1;
let flips = 0;
let mathActive = false;
let mathTimer = 0;
let particles = [];
let sandParticles = [];
let frame = 0;
let screenShake = 0;

// Flip animation state machine
let state = 'idle';     // idle, crouch, launch, flip, land, recover
let flipProgress = 0;   // 0→1 during flip
let crouchAmount = 0;
let yOffset = 0;        // vertical position during jump
let rotation = 0;       // radians
let scaleX = 1;         // for landing squash

// ========== MATH ==========
let currentMath = null;
function rand(min, max) { return Math.floor(Math.random()*(max-min+1))+min; }
function spawnMath() {
  if (mathActive || state !== 'idle') return;
  const ops = [
    () => { const a=rand(5,15), b=rand(3,12); return {q:`${a} + ${b}`, ans:a+b}; },
    () => { const a=rand(10,22), b=rand(2,9); return {q:`${a} - ${b}`, ans:a-b}; },
    () => { const a=rand(3,9), b=rand(2,8); return {q:`${a} × ${b}`, ans:a*b}; }
  ];
  currentMath = ops[Math.floor(Math.random()*ops.length)]();
  document.getElementById('mathQ').textContent = currentMath.q + " = ?";
  document.getElementById('mathAns').value = '';
  document.getElementById('mathBox').style.display = 'block';
  document.getElementById('mathAns').focus();
  mathActive = true;
}
function checkMath() {
  const val = parseInt(document.getElementById('mathAns').value);
  if (val === currentMath.ans) {
    power = Math.min(100, power + 22);
    score += 150 * level;
    showMsg("POWER UP! Ready for bigger flip!", "#0f0");
    if (power >= 100) {
      level++;
      power = 30;
      showMsg("LEVEL UP! Stronger Flip Unlocked", "#ff0");
    }
  } else {
    showMsg("Wrong!", "#f44");
    power = Math.max(0, power - 8);
  }
  document.getElementById('mathBox').style.display = 'none';
  mathActive = false;
  currentMath = null;
  updateUI();
}
document.getElementById('mathAns').addEventListener('keydown', e => {
  if (e.key === 'Enter') checkMath();
});

// ========== INPUT ==========
let charging = false;
window.addEventListener('keydown', e => {
  if ((e.key === ' ' || e.key === 'Spacebar') && state === 'idle' && !mathActive) {
    e.preventDefault();
    charging = true;
    state = 'crouch';
  }
});
window.addEventListener('keyup', e => {
  if ((e.key === ' ' || e.key === 'Spacebar') && state === 'crouch') {
    charging = false;
    // Launch!
    state = 'launch';
    flipProgress = 0;
    // power affects height & success feel
    const boost = 0.7 + (power / 100) * 0.6;
    yOffset = 0;
  }
});

// ========== PARTICLES ==========
function addSand(x, y, count=12) {
  for (let i=0; i<count; i++) {
    sandParticles.push({
      x, y,
      vx: (Math.random()-0.5)*8,
      vy: -Math.random()*6 - 2,
      life: 40 + Math.random()*30,
      size: 2 + Math.random()*3,
      color: `hsl(35, 60%, ${40+Math.random()*30}%)`
    });
  }
}
function addSpark(x, y, color='#fff') {
  for (let i=0; i<10; i++) {
    particles.push({
      x, y,
      vx: (Math.random()-0.5)*10,
      vy: (Math.random()-0.5)*10 - 3,
      life: 25 + Math.random()*20,
      color,
      size: 2 + Math.random()*3
    });
  }
}

// ========== DRAW BEACH ==========
function drawBeach() {
  // sky gradient already on canvas bg, add sun
  ctx.fillStyle = '#FFF7A0';
  ctx.beginPath();
  ctx.arc(780, 90, 45, 0, Math.PI*2);
  ctx.fill();

  // ocean
  ctx.fillStyle = '#1E90FF';
  ctx.fillRect(0, H-160, W, 80);
  // waves
  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  for (let i=0; i<6; i++) {
    const wx = (frame*1.5 + i*160) % (W+100) - 50;
    ctx.beginPath();
    ctx.ellipse(wx, H-145, 70, 8, 0, 0, Math.PI*2);
    ctx.fill();
  }

  // sand
  ctx.fillStyle = '#E8C47A';
  ctx.fillRect(0, H-90, W, 90);
  // sand texture lines
  ctx.strokeStyle = 'rgba(160,120,60,0.3)';
  ctx.lineWidth = 1;
  for (let i=0; i<12; i++) {
    ctx.beginPath();
    ctx.moveTo(0, H-85 + i*7);
    ctx.lineTo(W, H-80 + i*7);
    ctx.stroke();
  }
}

// ========== DRAW BIG ATHLETE (bulky for 336 lb look) ==========
function drawAthlete() {
  ctx.save();
  ctx.translate(W/2, H - 95 + yOffset);
  ctx.scale(scaleX, 1);
  ctx.rotate(rotation);

  const skin = '#c68642';
  const shirt = '#C5050C'; // Wisconsin red
  const shorts = '#fff';

  // === LEGS ===
  ctx.strokeStyle = skin;
  ctx.lineWidth = 22;
  ctx.lineCap = 'round';

  // Left leg
  ctx.beginPath();
  ctx.moveTo(-18, 10);
  ctx.lineTo(-28 - crouchAmount*15, 55 + crouchAmount*10);
  ctx.stroke();
  // Left foot
  ctx.beginPath();
  ctx.moveTo(-28 - crouchAmount*15, 55 + crouchAmount*10);
  ctx.lineTo(-45 - crouchAmount*10, 60 + crouchAmount*8);
  ctx.stroke();

  // Right leg
  ctx.beginPath();
  ctx.moveTo(18, 10);
  ctx.lineTo(28 + crouchAmount*15, 55 + crouchAmount*10);
  ctx.stroke();
  // Right foot
  ctx.beginPath();
  ctx.moveTo(28 + crouchAmount*15, 55 + crouchAmount*10);
  ctx.lineTo(45 + crouchAmount*10, 60 + crouchAmount*8);
  ctx.stroke();

  // === TORSO (thick) ===
  ctx.fillStyle = shirt;
  ctx.beginPath();
  ctx.roundRect(-32, -70, 64, 80, 12);
  ctx.fill();

  // Abs / core definition (visible power)
  ctx.strokeStyle = 'rgba(0,0,0,0.25)';
  ctx.lineWidth = 2;
  for (let i=0; i<3; i++) {
    ctx.beginPath();
    ctx.moveTo(-18, -40 + i*14);
    ctx.lineTo(18, -40 + i*14);
    ctx.stroke();
  }

  // === ARMS ===
  ctx.strokeStyle = skin;
  ctx.lineWidth = 16;
  // Left arm
  ctx.beginPath();
  ctx.moveTo(-32, -50);
  ctx.quadraticCurveTo(-60 - crouchAmount*20, -20, -55, 20 + crouchAmount*15);
  ctx.stroke();
  // Right arm
  ctx.beginPath();
  ctx.moveTo(32, -50);
  ctx.quadraticCurveTo(60 + crouchAmount*20, -20, 55, 20 + crouchAmount*15);
  ctx.stroke();

  // === HEAD ===
  ctx.fillStyle = skin;
  ctx.beginPath();
  ctx.arc(0, -95, 22, 0, Math.PI*2);
  ctx.fill();
  // Hair / short
  ctx.fillStyle = '#2a1a0a';
  ctx.beginPath();
  ctx.arc(0, -100, 18, Math.PI, 0);
  ctx.fill();

  // Number or logo hint
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 18px Arial';
  ctx.textAlign = 'center';
  ctx.fillText('99', 0, -30);

  ctx.restore();
}

// ========== UPDATE FLIP STATE MACHINE ==========
function updateFlip() {
  if (state === 'crouch') {
    crouchAmount = Math.min(1, crouchAmount + 0.06);
    // sand dust while charging
    if (frame % 4 === 0) addSand(W/2 + (Math.random()-0.5)*40, H-90, 3);
  }
  else if (state === 'launch') {
    crouchAmount = Math.max(0, crouchAmount - 0.15);
    flipProgress += 0.035 + (power/100)*0.015;
    // jump height curve
    yOffset = -Math.sin(flipProgress * Math.PI) * (140 + power*1.2);
    rotation = flipProgress * Math.PI * 2; // full 360 backflip

    // mid-air sparks
    if (frame % 3 === 0) addSpark(W/2, H-95 + yOffset - 40, '#fff');

    if (flipProgress >= 1) {
      state = 'land';
      flipProgress = 1;
      yOffset = 0;
      rotation = Math.PI * 2;
      scaleX = 1.25; // squash
      screenShake = 12;
      addSand(W/2, H-85, 35);
      addSpark(W/2, H-90, '#E8C47A');
      flips++;
      score += 200 + Math.floor(power * 2);
      showMsg("PERFECT LANDING!", "#0f0");
      power = Math.max(0, power - 15);
    }
  }
  else if (state === 'land') {
    scaleX += (1 - scaleX) * 0.15;
    if (Math.abs(scaleX - 1) < 0.02) {
      scaleX = 1;
      state = 'recover';
      setTimeout(() => {
        state = 'idle';
        rotation = 0;
        crouchAmount = 0;
      }, 400);
    }
  }

  // screen shake decay
  if (screenShake > 0) screenShake *= 0.85;
}

// ========== UI & MESSAGES ==========
function updateUI() {
  document.getElementById('powerVal').textContent = Math.round(power);
  document.getElementById('score').textContent = 'Score: ' + score;
  document.getElementById('level').textContent = level;
  document.getElementById('flips').textContent = flips;
}
function showMsg(txt, color='#fff') {
  const m = document.getElementById('message');
  m.textContent = txt;
  m.style.color = color;
  m.style.display = 'block';
  setTimeout(() => m.style.display = 'none', 1600);
}

// ========== MAIN LOOP ==========
function loop() {
  frame++;
  ctx.save();
  // screen shake
  if (screenShake > 0.5) {
    ctx.translate((Math.random()-0.5)*screenShake, (Math.random()-0.5)*screenShake);
  }

  ctx.clearRect(-20, -20, W+40, H+40);
  drawBeach();

  // update & draw particles
  for (let i = sandParticles.length-1; i>=0; i--) {
    const p = sandParticles[i];
    p.x += p.vx; p.y += p.vy; p.vy += 0.25; p.life--;
    ctx.globalAlpha = Math.min(1, p.life/30);
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x, p.y, p.size, p.size);
    if (p.life <= 0) sandParticles.splice(i,1);
  }
  for (let i = particles.length-1; i>=0; i--) {
    const p = particles[i];
    p.x += p.vx; p.y += p.vy; p.life--;
    ctx.globalAlpha = p.life/40;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
    ctx.fill();
    if (p.life <= 0) particles.splice(i,1);
  }
  ctx.globalAlpha = 1;

  updateFlip();
  drawAthlete();

  // math timer
  mathTimer++;
  if (mathTimer > 380 + Math.random()*100 && !mathActive && state === 'idle') {
    mathTimer = 0;
    spawnMath();
  }

  // passive power drain/regen
  if (state === 'idle' && !mathActive) {
    power = Math.min(100, power + 0.04);
  }

  updateUI();
  ctx.restore();
  requestAnimationFrame(loop);
}

// start
showMsg("Hold SPACE to crouch & launch\nthe standing backflip!\nAnswer Math for POWER", "#0ff");
setTimeout(() => showMsg(""), 3200);
loop();
</script>
</body>
</html>
