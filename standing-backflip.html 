// -------------------- MAIN LOOP (A.I. Super Engine style) --------------------
function loop(now) {
  // Delta time capping (prevents huge jumps on lag)
  let dt = (now - lastTime) / 1000;
  dt = Math.min(dt, 0.05);          // hard cap like advanced engines
  lastTime = now;

  frame++;

  ctx.save();
  if (screenShake > 0.5) {
    ctx.translate(rand(-screenShake, screenShake), rand(-screenShake, screenShake));
  }

  ctx.clearRect(-40, -40, W + 80, H + 80);
  drawBeach();

  // Particles
  for (let i = sand.length - 1; i >= 0; i--) {
    const p = sand[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.3;
    p.life--;
    ctx.globalAlpha = Math.min(1, p.life / 35);
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x, p.y, p.size, p.size);
    if (p.life <= 0) sand.splice(i, 1);
  }
  for (let i = sparks.length - 1; i >= 0; i--) {
    const p = sparks[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    ctx.globalAlpha = p.life / 35;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
    if (p.life <= 0) sparks.splice(i, 1);
  }
  ctx.globalAlpha = 1;

  // Core systems
  updateFlip(dt);
  aiCoach(dt);
  drawAthlete();

  // Math timer
  mathTimer += dt;
  if (mathTimer > 7.5 && !mathActive && state === 'idle') {
    mathTimer = 0;
    spawnMath();
  }

  // Slow power regen
  if (state === 'idle' && !mathActive) {
    power = Math.min(100, power + 0.04 * dt * 60);
  }

  updateUI();
  ctx.restore();
  requestAnimationFrame(loop);
}

