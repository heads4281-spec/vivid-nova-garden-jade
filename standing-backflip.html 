      <input type="number" id="mathAns" placeholder="?">
      <button onclick="checkMath()">POWER UP</button>
    </div>

    <div id="controls">
      Hold SPACE to crouch &amp; launch the standing backflip &nbsp;•&nbsp; Solve Math for Power
    </div>
  </div>

<script>
/* ============================================================
   336-lb STANDING BACKFLIP – FULL HTML5 GAME
   Complete mechanics + smooth animation + math power system
   ============================================================ */

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width;
const H = canvas.height;

// -------------------- GAME STATE --------------------
let score = 0;
let power = 0;               // 0 – 100
let level = 1;
let flips = 0;
let combo = 0;

let mathActive = false;
let mathTimer = 0;
let frame = 0;
let screenShake = 0;

// Flip state machine
let state = 'idle';          // idle | crouch | launch | land | recover
let flipT = 0;              // 0 → 1 progress of the flip
let crouch = 0;             // 0 → 1 crouch depth
let y = 0;                  // vertical offset during jump
let rot = 0;                // rotation in radians
let squash = 1;             // landing squash factor

// Particle arrays
let sand = [];
let sparks = [];

// -------------------- UTILITY --------------------
function rand(min, max) {
  return Math.random() * (max - min) + min;
}
function randInt(min, max) {
  return Math.floor(rand(min, max + 1));
}
function lerp(a, b, t) {
  return a + (b - a) * t;
}
function easeOutCubic(t) {
  return 1 - Math.pow(1 - t, 3);
}

// -------------------- MATH SYSTEM --------------------
let currentMath = null;

function spawnMath() {
  if (mathActive || state !== 'idle') return;

  const types = [
    () => {
      const a = randInt(4, 16), b = randInt(3, 12);
      return { q: `${a} + ${b}`, ans: a + b };
    },
    () => {
      const a = randInt(12, 25), b = randInt(2, 10);
      return { q: `${a} − ${b}`, ans: a - b };
    },
    () => {
      const a = randInt(3, 9), b = randInt(2, 8);
      return { q: `${a} × ${b}`, ans: a * b };
    }
  ];

  currentMath = types[randInt(0, 2)]();
  document.getElementById('mathQ').textContent = currentMath.q + ' = ?';
  document.getElementById('mathAns').value = '';
  document.getElementById('mathBox').style.display = 'block';
  document.getElementById('mathAns').focus();
  mathActive = true;
}

function checkMath() {
  const val = parseInt(document.getElementById('mathAns').value);
  if (val === currentMath.ans) {
    power = Math.min(100, power + 24);
    score += 180 * level;
    combo++;
    showMsg('POWER BOOST!\n+' + (24) + ' Power', '#0ff');
    if (power >= 100) {
      level++;
      power = 35;
      showMsg('LEVEL UP!\nStronger Flip Unlocked', '#ffd700');
    }
  } else {
    showMsg('Wrong answer', '#f66');
    power = Math.max(0, power - 10);
    combo = 0;
  }
  document.getElementById('mathBox').style.display = 'none';
  mathActive = false;
  currentMath = null;
  updateUI();
}

document.getElementById('mathAns').addEventListener('keydown', e => {
  if (e.key === 'Enter') checkMath();
});

// -------------------- INPUT --------------------
let holdingSpace = false;

window.addEventListener('keydown', e => {
  if (e.code === 'Space' && state === 'idle' && !mathActive) {
    e.preventDefault();
    holdingSpace = true;
    state = 'crouch';
  }
});

window.addEventListener('keyup', e => {
  if (e.code === 'Space' && state === 'crouch') {
    holdingSpace = false;
    // Launch the flip
    state = 'launch';
    flipT = 0;
    y = 0;
    rot = 0;
  }
});

// -------------------- PARTICLES --------------------
function addSand(x, y, count = 14) {
  for (let i = 0; i < count; i++) {
    sand.push({
      x, y,
      vx: rand(-6, 6),
      vy: rand(-8, -2),
      life: rand(35, 65),
      size: rand(2, 4.5),
      color: `hsl(35, 55%, ${45 + rand(0, 25)}%)`
    });
  }
}

function addSpark(x, y, color = '#fff') {
  for (let i = 0; i < 9; i++) {
    sparks.push({
      x, y,
      vx: rand(-8, 8),
      vy: rand(-9, 2),
      life: rand(20, 40),
      size: rand(1.8, 3.5),
      color
    });
  }
}

// -------------------- DRAWING FUNCTIONS --------------------
function drawBeach() {
  // Ocean waves
  ctx.fillStyle = 'rgba(255,255,255,0.22)';
