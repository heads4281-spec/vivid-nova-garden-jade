  else if (state === 'launch') {
    crouch = Math.max(0, crouch - 0.18);
    flipT += 0.028 + (power / 100) * 0.018;   // power makes flip faster & higher

    // Jump height curve (sine for smooth arc)
    const height = 155 + power * 1.35;
    y = -Math.sin(flipT * Math.PI) * height;

    // Full 360° backflip
    rot = flipT * Math.PI * 2;

    // Mid-air particles
    if (frame % 3 === 0) {
      addSpark(W / 2 + rand(-20, 20), H - 105 + y - 50, '#fff');
    }

    // Landing
    if (flipT >= 1) {
      state = 'land';
      flipT = 1;
