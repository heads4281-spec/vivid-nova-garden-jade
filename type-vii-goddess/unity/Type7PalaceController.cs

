using UnityEngine;

public class Type7PalaceController : MonoBehaviour
{
    [Header("360° Alive Control")]
    public float rotateSpeed = 12f;
    public float energySpeed = 1.4f;

    public Color blue  = new Color(0f, 0.94f, 1f);
    public Color red   = new Color(1f, 0.08f, 0.24f);
    public Color purple= new Color(0.7f, 0f, 1f);

    public Material energyMat;
    private float angle;

    void Update()
    {
        // Full 360° alive rotation
        angle += rotateSpeed * Time.deltaTime;
        transform.rotation = Quaternion.Euler(18f, angle, 0f);

        // Triune energy pulse
        float t = Mathf.PingPong(Time.time * energySpeed, 1f);
        Color c = Color.Lerp(Color.Lerp(blue, red, t), purple, t);
        if (energyMat) energyMat.SetColor("_EmissionColor", c * 5f);

        // Realm hotkeys 1-6
        for (int i = 1; i <= 6; i++)
            if (Input.GetKeyDown(KeyCode.Alpha0 + i))
                Debug.Log($"Live Animation → Realm {i} activated");
    }
}