// CCD PLAYER MOVEMENT
// Prevents falling through the glowing red floor and clipping
// the geometric arches / palace walls, even when dt is large.
// ---------------------------------------------------------------
const RADIUS = 0.38; // player capsule radius (matches character scale)

// Only test nearby colliders (SpatialHash makes this cheap)
const candidates = this.hash.query(this.px, this.pz, RADIUS + 2);

// Desired new position after this frame’s velocity
let nx = this.px + this.vx * dt;
let ny = this.py + this.vy * dt;
let nz = this.pz + this.vz * dt;

// Find the earliest collision along the movement ray
let hitT = 1;
for (const box of candidates) {
  const t = sweepSphereAABB(this.px, this.py, this.pz, nx, ny, nz, RADIUS, box);
  if (t !== null && t < hitT) hitT = t;
}

// Move only up to the hit point (or full distance if no hit)
this.px = lerp(this.px, nx, hitT);
this.py = lerp(this.py, ny, hitT);
this.pz = lerp(this.pz, nz, hitT);

// Hard ground snap (the red floor is at y ≈ 0)
if (this.py < 0.35) {
  this.py = 0.35;
  this.vy = 0;
  this.grounded = true;
