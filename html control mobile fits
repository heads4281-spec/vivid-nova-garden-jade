<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Space Shooter – Mobile Ready</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
    font-family: 'Segoe UI', system-ui, sans-serif;
    touch-action: none;
  }
  body {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  canvas {
    background: #050510;
    display: block;
    box-shadow: 0 0 40px rgba(0,150,255,0.25);
    max-width: 100vw;
    max-height: 100vh;
  }
  #ui {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 18px;
    color: #fff;
    font-size: 18px;
    text-shadow: 0 0 8px #0af;
    pointer-events: none;
    z-index: 10;
  }
  #gameOver {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0,0,20,0.93);
    border: 2px solid #0af;
    border-radius: 14px;
    padding: 36px 48px;
    text-align: center;
    color: #fff;
    display: none;
    z-index: 30;
    box-shadow: 0 0 30px rgba(0,170,255,0.4);
  }
  #gameOver h1 {
    font-size: 34px;
    color: #f44;
    margin-bottom: 8px;
    text-shadow: 0 0 12px #f44;
  }
  #gameOver p { font-size: 20px; margin-bottom: 24px; }
  #restartBtn {
    background: #0af;
    color: #000;
    border: none;
    padding: 14px 36px;
    font-size: 18px;
    font-weight: 700;
    border-radius: 8px;
    cursor: pointer;
  }

  /* ===== TOUCH CONTROLS ===== */
  #touchLayer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }
  .joy-base {
    position: absolute;
    left: 30px;
    bottom: 30px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: rgba(0,140,255,0.12);
    border: 2px solid rgba(0,180,255,0.45);
    pointer-events: auto;
  }
  .joy-knob {
    position: absolute;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(0,180,255,0.75);
    top: 38px;
    left: 38px;
    pointer-events: none;
  }
  .fire-btn {
    position: absolute;
    right: 30px;
    bottom: 40px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255,50,50,0.3);
    border: 3px solid rgba(255,80,80,0.75);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    user-select: none;
  }
  .fire-btn.active {
    background: rgba(255,70,70,0.7);
    transform: scale(0.93);
  }
  @media (min-width: 900px) {
    .joy-base, .fire-btn { opacity: 0.4; }
  }
</style>
</head>
<body>
  <div id="ui">
    <div>Score: <span id="score">0</span></div>
    <div>Lives: <span id="lives">3</span></div>
  </div>

  <canvas id="c" width="800" height="600"></canvas>

  <div id="touchLayer">
    <div class="joy-base" id="joy">
      <div class="joy-knob" id="knob"></div>
    </div>
    <div class="fire-btn" id="fire">FIRE</div>
  </div>

  <div id="gameOver">
    <h1>GAME OVER</h1>
    <p>Final Score: <span id="finalScore">0</span></p>
    <button id="restartBtn">Play Again</button>
  </div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const livesEl = document.getElementById('lives');
const goScreen = document.getElementById('gameOver');
const finalScoreEl = document.getElementById('finalScore');
const restartBtn = document.getElementById('restartBtn');
const joy = document.getElementById('joy');
const knob = document.getElementById('knob');
const fireBtn = document.getElementById('fire');

let score = 0, lives = 3, running = true;
let keys = {};
let bullets = [], asteroids = [], particles = [], stars = [];
let shootCD = 0, invuln = 0;

// Touch state
let joyActive = false;
let joyX = 0, joyY = 0;          // -1 … 1
let fireHeld = false;
const JOY_MAX = 38;

const player = { x: 400, y: 520, r: 14, speed: 5.5 };

// Stars
for (let i = 0; i < 110; i++) {
  stars.push({
    x: Math.random() * 800,
    y: Math.random() * 600,
    s: Math.random() * 2 + 0.4,
    sp: Math.random() * 1.4 + 0.3
  });
}

// ---------- Keyboard ----------
window.addEventListener('keydown', e => {
  keys[e.code] = true;
  if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)) e.preventDefault();
});
window.addEventListener('keyup', e => keys[e.code] = false);

// ---------- Touch Joystick ----------
function joyPos(e) {
  const rect = joy.getBoundingClientRect();
  const t = e.touches[0] || e.changedTouches[0];
  return { x: t.clientX - rect.left, y: t.clientY - rect.top };
}

joy.addEventListener('touchstart', e => {
  e.preventDefault();
  joyActive = true;
  moveJoy(e);
}, {passive:false});

joy.addEventListener('touchmove', e => {
  e.preventDefault();
  if (joyActive) moveJoy(e);
}, {passive:false});

joy.addEventListener('touchend', e => {
  e.preventDefault();
  joyActive = false;
  joyX = joyY = 0;
  knob.style.left = '38px';
  knob.style.top  = '38px';
}, {passive:false});

function moveJoy(e) {
  const p = joyPos(e);
  let dx = p.x - 65;
  let dy = p.y - 65;
  const d = Math.hypot(dx, dy);
  if (d > JOY_MAX) {
    dx = dx / d * JOY_MAX;
    dy = dy / d * JOY_MAX;
  }
  joyX = dx / JOY_MAX;
  joyY = dy / JOY_MAX;
  knob.style.left = (38 + dx) + 'px';
  knob.style.top  = (38 + dy) + 'px';
}

// ---------- Fire Button ----------
fireBtn.addEventListener('touchstart', e => {
  e.preventDefault();
  fireHeld = true;
  fireBtn.classList.add('active');
}, {passive:false});

fireBtn.addEventListener('touchend', e => {
  e.preventDefault();
  fireHeld = false;
  fireBtn.classList.remove('active');
}, {passive:false});

fireBtn.addEventListener('touchcancel', () => {
  fireHeld = false;
  fireBtn.classList.remove('active');
});

// Prevent page scroll
document.body.addEventListener('touchmove', e => e.preventDefault(), {passive:false});

// Restart
restartBtn.addEventListener('click', reset);
restartBtn.addEventListener('touchend', e => { e.preventDefault(); reset(); });

function reset() {
  score = 0; lives = 3; running = true;
  bullets = []; asteroids = []; particles = [];
  player.x = 400; player.y = 520;
  invuln = 0; joyX = joyY = 0; fireHeld = false;
  scoreEl.textContent = '0';
  livesEl.textContent = '3';
  goScreen.style.display = 'none';
  spawnWave();
}

function spawnAsteroid(x, y, r) {
  const a = Math.random() * Math.PI * 2;
  const sp = (Math.random() * 1.5 + 0.7) * (40 / r);
  asteroids.push({
    x: x ?? Math.random() * 800,
    y: y ?? -r - 20,
    vx: Math.cos(a) * sp * (Math.random() < 0.5 ? 1 : -1),
    vy: Math.abs(Math.sin(a) * sp) + 0.6,
    r, rot: 0, rs: (Math.random() - 0.5) * 0.06
  });
}
function spawnWave() {
  for (let i = 0; i < 4; i++) spawnAsteroid(null, null, 40);
}

function explode(x, y, n, col) {
  for (let i = 0; i < n; i++) {
    const a = Math.random() * Math.PI * 2;
    const s = Math.random() * 4 + 1;
    particles.push({
      x, y, vx: Math.cos(a)*s, vy: Math.sin(a)*s,
      life: 45 + Math.random()*20, max: 65,
      col: col || '#ffaa00', sz: Math.random()*3+1
    });
  }
}

function update() {
  if (!running) return;

  // stars
  stars.forEach(s => {
    s.y += s.sp;
    if (s.y > 600) { s.y = 0; s.x = Math.random()*800; }
  });

  // movement (keyboard + joystick)
  let mx = 0, my = 0;
  if (keys['ArrowLeft'] || keys['KeyA']) mx -= 1;
  if (keys['ArrowRight']|| keys['KeyD']) mx += 1;
  if (keys['ArrowUp']   || keys['KeyW']) my -= 1;
  if (keys['ArrowDown'] || keys['KeyS']) my += 1;
  mx += joyX;
  my += joyY;
  const len = Math.hypot(mx, my);
  if (len > 1) { mx /= len; my /= len; }
  player.x += mx * player.speed;
  player.y += my * player.speed;
  player.x = Math.max(player.r, Math.min(800 - player.r, player.x));
  player.y = Math.max(player.r, Math.min(600 - player.r, player.y));

  // shooting
  if (shootCD > 0) shootCD--;
  if ((keys['Space'] || keys['KeyZ'] || fireHeld) && shootCD <= 0) {
    bullets.push({ x: player.x, y: player.y - 18, vy: -9.5, r: 3 });
    shootCD = 11;
  }

  // bullets
  for (let i = bullets.length - 1; i >= 0; i--) {
    bullets[i].y += bullets[i].vy;
    if (bullets[i].y < -15) bullets.splice(i, 1);
  }

  // asteroids
  for (let i = asteroids.length - 1; i >= 0; i--) {
    const a = asteroids[i];
    a.x += a.vx; a.y += a.vy; a.rot += a.rs;
    if (a.x < -a.r) a.x = 800 + a.r;
    if (a.x > 800 + a.r) a.x = -a.r;
    if (a.y > 650) { asteroids.splice(i, 1); continue; }

    for (let j = bullets.length - 1; j >= 0; j--) {
      const b = bullets[j];
      if (Math.hypot(a.x - b.x, a.y - b.y) < a.r + b.r) {
        bullets.splice(j, 1);
        explode(a.x, a.y, a.r / 2, '#ff8800');
        score += a.r >= 35 ? 20 : a.r >= 20 ? 50 : 100;
        scoreEl.textContent = score;
        if (a.r > 18) {
          const nr = a.r * 0.55;
          spawnAsteroid(a.x, a.y, nr);
          spawnAsteroid(a.x, a.y, nr);
        }
        asteroids.splice(i, 1);
        break;
      }
    }
  }

  // player hit
  if (invuln > 0) invuln--;
  else {
    for (const a of asteroids) {
      if (Math.hypot(a.x - player.x, a.y - player.y) < a.r + player.r) {
        lives--;
        livesEl.textContent = lives;
        invuln = 90;
        explode(player.x, player.y, 28, '#0af');
        if (lives <= 0) {
          running = false;
          finalScoreEl.textContent = score;
          goScreen.style.display = 'block';
        }
        break;
      }
    }
  }

  // particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx; p.y += p.vy; p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }

  if (asteroids.length < 5 && Math.random() < 0.02)
    spawnAsteroid(null, null, Math.random() > 0.55 ? 40 : 26);
}

function draw() {
  ctx.fillStyle = '#050510';
  ctx.fillRect(0, 0, 800, 600);

  // stars
  stars.forEach(s => {
    ctx.globalAlpha = 0.35 + s.s / 3;
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.s, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  // particles
  particles.forEach(p => {
    ctx.globalAlpha = p.life / p.max;
    ctx.fillStyle = p.col;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.sz, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  // asteroids
  asteroids.forEach(a => {
    ctx.save();
    ctx.translate(a.x, a.y);
    ctx.rotate(a.rot);
    ctx.strokeStyle = '#aaa';
    ctx.lineWidth = 2;
    ctx.beginPath();
    const sides = 7 + Math.floor(a.r / 9);
    for (let i = 0; i < sides; i++) {
      const ang = (i / sides) * Math.PI * 2;
      const rad = a.r * (0.78 + Math.sin(i * 4.1) * 0.22);
      const px = Math.cos(ang) * rad;
      const py = Math.sin(ang) * rad;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.stroke();
    ctx.fillStyle = 'rgba(70,70,95,0.35)';
    ctx.fill();
    ctx.restore();
  });

  // bullets
  ctx.fillStyle = '#0ff';
  bullets.forEach(b => {
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.r, 0, Math.PI*2);
    ctx.fill();
  });

  // player
  if (invuln === 0 || Math.floor(invuln / 4) % 2 === 0) {
    ctx.save();
    ctx.translate(player.x, player.y);
    ctx.fillStyle = '#0af';
    ctx.beginPath();
    ctx.moveTo(0, -16);
    ctx.lineTo(12, 12);
    ctx.lineTo(0, 6);
    ctx.lineTo(-12, 12);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#f80';
    ctx.beginPath();
    ctx.moveTo(-5, 10);
    ctx.lineTo(0, 18 + Math.random()*5);
    ctx.lineTo(5, 10);
    ctx.fill();
    ctx.restore();
  }
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

spawnWave();
loop();
</script>
</body>
</html>