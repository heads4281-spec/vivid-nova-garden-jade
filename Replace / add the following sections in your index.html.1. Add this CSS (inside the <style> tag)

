#### 3. Add this JavaScript (place near the bottom of your `<script>`, after the WebSocket code)

```js
// ==================== COLLISION DETECTION + ARENA ====================
const canvas = document.getElementById("arena");
const ctx = canvas.getContext("2d");

const player = {
  x: 350,
  y: 210,
  radius: 18,
  color: "#c41e3a",
  speed: 3.2,
  vx: 0,
  vy: 0
};

let obstacles = [];
let otherPlayers = {};          // from WebSocket
let keys = {};
let lastCollisionTime = 0;

// Create initial obstacles
function initObstacles() {
  obstacles = [
    { x: 120, y: 100, w: 70, h: 40, type: "rect" },
    { x: 500, y: 80,  w: 50, h: 90, type: "rect" },
    { x: 300, y: 300, r: 28, type: "circle" },
    { x: 580, y: 280, r: 22, type: "circle" },
    { x: 180, y: 320, w: 90, h: 30, type: "rect" }
  ];
}
initObstacles();

// Keyboard
window.addEventListener("keydown", e => keys[e.key.toLowerCase()] = true);
window.addEventListener("keyup",   e => keys[e.key.toLowerCase()] = false);

// ===== COLLISION FUNCTIONS =====
function circleCircle(c1, c2) {
  const dx = c1.x - c2.x;
  const dy = c1.y - c2.y;
  const dist = Math.sqrt(dx * dx + dy * dy);
  return dist < c1.radius + c2.radius;
}

function circleRect(circle, rect) {
  // Find the closest point on the rectangle to the circle center
  const closestX = Math.max(rect.x, Math.min(circle.x, rect.x + rect.w));
  const closestY = Math.max(rect.y, Math.min(circle.y, rect.y + rect.h));

  const dx = circle.x - closestX;
  const dy = circle.y - closestY;
  return (dx * dx + dy * dy) < (circle.radius * circle.radius);
}

// Resolve circle-circle collision (simple separation)
function resolveCircleCircle(c1, c2) {
  const dx = c1.x - c2.x;
  const dy = c1.y - c2.y;
  const dist = Math.sqrt(dx * dx + dy * dy) || 1;
  const overlap = c1.radius + c2.radius - dist;
  if (overlap > 0) {
    const nx = dx / dist;
    const ny = dy / dist;
    c1.x += nx * overlap * 0.6;
    c1.y += ny * overlap * 0.6;
  }
}

// ===== MAIN GAME LOOP =====
function updateArena() {
  // Movement
  player.vx = 0;
  player.vy = 0;
  if (keys["w"] || keys["arrowup"])    player.vy = -player.speed;
  if (keys["s"] || keys["arrowdown"])  player.vy =  player.speed;
  if (keys["a"] || keys["arrowleft"])  player.vx = -player.speed;
  if (keys["d"] || keys["arrowright"]) player.vx =  player.speed;

  player.x += player.vx;
  player.y += player.vy;

  // Keep player inside canvas
  player.x = Math.max(player.radius, Math.min(canvas.width  - player.radius, player.x));
  player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));

  // Collision with obstacles
  obstacles.forEach(obs => {
    let hit = false;
    if (obs.type === "circle") {
      const c2 = { x: obs.x, y: obs.y, radius: obs.r };
      if (circleCircle(player, c2)) {
        hit = true;
        resolveCircleCircle(player, c2);
      }
    } else {
      if (circleRect(player, obs)) {
        hit = true;
        // Simple push-out
        const closestX = Math.max(obs.x, Math.min(player.x, obs.x + obs.w));
        const closestY = Math.max(obs.y, Math.min(player.y, obs.y + obs.h));
        const dx = player.x - closestX;
        const dy = player.y - closestY;
        const dist = Math.sqrt(dx*dx + dy*dy) || 1;
        const overlap = player.radius - dist;
        if (overlap > 0) {
          player.x += (dx / dist) * overlap;
          player.y += (dy / dist) * overlap;
        }
      }
    }

    if (hit && Date.now() - lastCollisionTime > 400) {
      lastCollisionTime = Date.now();
      const dmg = Math.floor((stats.attack || 15) * 0.4 + (stats.strength || 12) * 0.2);
      log(`Collision! Impact force ~${dmg}`);
      // Optional: reduce minerals or health here
    }
  });

  // Collision with other players (from WebSocket)
  Object.values(otherPlayers).forEach(op => {
    if (circleCircle(player, op)) {
      resolveCircleCircle(player, op);
      if (Date.now() - lastCollisionTime > 500) {
        lastCollisionTime = Date.now();
        log(`Collided with ${op.name || "another Sovereign"}`);
      }
    }
  });

  // Send position to server (for multiplayer)
  if (socket && socket.readyState === WebSocket.OPEN) {
    sendWS({
      type: "position",
      x: player.x,
      y: player.y,
      radius: player.radius
    });
  }

  drawArena();
  requestAnimationFrame(updateArena);
}

function drawArena() {
  ctx.fillStyle = "#0d0609";
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Grid
  ctx.strokeStyle = "#1a0a10";
  ctx.lineWidth = 1;
  for (let x = 0; x < canvas.width; x += 40) {
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
  }
  for (let y = 0; y < canvas.height; y += 40) {
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
  }

  // Obstacles
  obstacles.forEach(obs => {
    ctx.fillStyle = "#3a1a25";
    if (obs.type === "circle") {
      ctx.beginPath();
      ctx.arc(obs.x, obs.y, obs.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = "#c41e3a";
      ctx.lineWidth = 2;
      ctx.stroke();
    } else {
      ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
      ctx.strokeStyle = "#c41e3a";
      ctx.lineWidth = 2;
      ctx.strokeRect(obs.x, obs.y, obs.w, obs.h);
    }
  });

  // Other players
  Object.values(otherPlayers).forEach(op => {
    ctx.beginPath();
    ctx.arc(op.x, op.y, op.radius || 16, 0, Math.PI * 2);
    ctx.fillStyle = "#4a90d9";
    ctx.fill();
    ctx.strokeStyle = "#fff";
    ctx.lineWidth = 2;
    ctx.stroke();
  });

  // Local player
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
  ctx.fillStyle = player.color;
  ctx.fill();
  ctx.strokeStyle = "#ff6b6b";
  ctx.lineWidth = 3;
  ctx.stroke();

  // Direction indicator
  ctx.beginPath();
  ctx.moveTo(player.x, player.y);
  ctx.lineTo(player.x + player.vx * 6, player.y + player.vy * 6);
  ctx.strokeStyle = "#ffd700";
  ctx.lineWidth = 2;
  ctx.stroke();
}

function resetArena() {
  player.x = 350;
  player.y = 210;
  initObstacles();
  log("Arena reset");
}

function spawnObstacle() {
  const type = Math.random() > 0.5 ? "circle" : "rect";
  if (type === "circle") {
    obstacles.push({
      x: 80 + Math.random() * 540,
      y: 60 + Math.random() * 300,
      r: 16 + Math.random() * 20,
      type: "circle"
    });
  } else {
    obstacles.push({
      x: 60 + Math.random() * 500,
      y: 40 + Math.random() * 300,
      w: 40 + Math.random() * 60,
      h: 25 + Math.random() * 50,
      type: "rect"
    });
  }
  log("Obstacle spawned");
}

// Start the arena loop
updateArena();
```

#### 4. Small WebSocket addition (so other players appear)

In your existing `socket.onmessage` handler, add:

```js
case "position":
  if (msg.id !== myId) {
    otherPlayers[msg.id] = {
      x: msg.x,
      y: msg.y,
      radius: msg.radius || 16,
      name: msg.name || "Sovereign"
    };
  }
  break;

case "playerLeft":
  delete otherPlayers[msg.id];
  break;
```

And on the server side (in `server.js`), when you receive a `position` message, broadcast it to others:

```js
case "position":
  if (world.players[id]) {
    world.players[id].x = msg.x;
    world.players[id].y = msg.y;
    world.players[id].radius = msg.radius;
  }
  broadcast({ type: "position", id, x: msg.x, y: msg.y, radius: msg.radius, name: world.players[id]?.name }, ws);
  break;
```

