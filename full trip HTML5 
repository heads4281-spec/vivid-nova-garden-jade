<title>CRIMSON SOVEREIGN — Full Round | Cycle 63821</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:#050308;overflow:hidden;font-family:system-ui,sans-serif;color:#e8d5c4}
  #c{display:block;width:100vw;height:100vh}
  #ui{position:absolute;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between}
  .hud{pointer-events:auto;background:rgba(20,8,12,.88);border:1px solid #8b1a2b66;
       backdrop-filter:blur(8px);padding:10px 16px;border-radius:6px}
  #top{display:flex;gap:12px;padding:12px;align-items:center;flex-wrap:wrap}
  h1{font-size:1.05rem;letter-spacing:2px;color:#ff6b7a;text-shadow:0 0 10px #ff2a4a88}
  .stat{font-size:.82rem;opacity:.9}
  #bottom{display:flex;gap:8px;padding:12px;justify-content:center;flex-wrap:wrap}
  button{background:#2a0a12;border:1px solid #8b1a2b;color:#ffb3bc;padding:9px 16px;
         cursor:pointer;font-family:inherit;border-radius:4px;letter-spacing:1px}
  button:hover{background:#4a1220;box-shadow:0 0 10px #ff2a4a55}
  #cross{position:absolute;top:50%;left:50%;width:16px;height:16px;margin:-8px 0 0 -8px;
         border:2px solid #ff6b7a77;border-radius:50%;pointer-events:none}
  #panel{position:absolute;top:70px;right:14px;width:270px;max-height:55vh;overflow:auto;display:none}
  #panel h2{color:#ff6b7a;margin-bottom:8px;font-size:.95rem}
  .item{padding:7px;margin:3px 0;background:#1a080c;border-left:3px solid #8b1a2b}
