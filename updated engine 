```cpp
// PlayerController.cpp  (full implementation)
#include "PlayerController.h"
#include "InputSystem.h"   // from original DX3D style

void PlayerController::Initialize(const XMFLOAT3& startPos)
{
    m_position = startPos;
    m_velocity = {0,0,0};
}

void PlayerController::Update(float deltaTime, InputSystem* input)
{
    // Mouse look already handled by camera; we only need movement
    float moveX = 0.0f, moveZ = 0.0f;

    if (input->IsKeyDown(KeyCode::W)) moveZ += 1.0f;
    if (input->IsKeyDown(KeyCode::S)) moveZ -= 1.0f;
    if (input->IsKeyDown(KeyCode::A)) moveX -= 1.0f;
    if (input->IsKeyDown(KeyCode::D)) moveX += 1.0f;

    m_isSprinting = input->IsKeyDown(KeyCode::LeftShift);

    // Transform movement into world space using camera yaw
    float cosY = cosf(m_yaw);
    float sinY = sinf(m_yaw);

    XMFLOAT3 forward = { sinY, 0, cosY };
    XMFLOAT3 right   = { cosY, 0, -sinY };

    XMFLOAT3 wishDir = {
        forward.x * moveZ + right.x * moveX,
        0,
        forward.z * moveZ + right.z * moveX
    };

    float len = sqrtf(wishDir.x*wishDir.x + wishDir.z*wishDir.z);
    if (len > 0.001f)
    {
        wishDir.x /= len;
        wishDir.z /= len;
    }

    float currentSpeed = m_isSprinting ? m_speed * m_sprintMultiplier : m_speed;
    m_velocity.x = wishDir.x * currentSpeed;
    m_velocity.z = wishDir.z * currentSpeed;

    // Jump
    if (input->IsKeyDown(KeyCode::Space) && m_isGrounded)
    {
        m_velocity.y = m_jumpForce;
        m_isGrounded = false;
    }

    ApplyGravityAndCollision(deltaTime);
}

void PlayerController::ApplyGravityAndCollision(float deltaTime)
{
    // Simple gravity
    m_velocity.y -= 25.0f * deltaTime;

    m_position.x += m_velocity.x * deltaTime;
    m_position.y += m_velocity.y * deltaTime;
    m_position.z += m_velocity.z * deltaTime;

    // Ground plane
    if (m_position.y < 0.0f)
    {
        m_position.y = 0.0f;
        m_velocity.y = 0.0f;
        m_isGrounded = true;
    }
}
