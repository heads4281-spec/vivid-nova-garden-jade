// ThirdPersonCamera.h  – 1000× better camera
#pragma once
#include <DirectXMath.h>
using namespace DirectX;

class ThirdPersonCamera
{
public:
    void Initialize(float distance = 8.0f, float height = 2.5f);
    void Update(float deltaTime, const XMFLOAT3& targetPos, float targetYaw);
    void SetMouseDelta(float dx, float dy);
    XMMATRIX GetViewMatrix() const;
    XMFLOAT3 GetPosition() const { return m_position; }

private:
    XMFLOAT3 m_position;
    XMFLOAT3 m_target;
    float m_yaw = 0.0f;
    float m_pitch = 0.3f;
    float m_desiredDistance = 8.0f;
    float m_currentDistance = 8.0f;
    float m_heightOffset = 2.5f;
    float m_mouseSensitivity = 0.0025f;
    float m_lagSpeed = 12.0f;
};
```

```cpp
// ThirdPersonCamera.cpp
#include "ThirdPersonCamera.h"

void ThirdPersonCamera::Initialize(float distance, float height)
{
    m_desiredDistance = distance;
    m_currentDistance = distance;
    m_heightOffset = height;
}

void ThirdPersonCamera::SetMouseDelta(float dx, float dy)
{
    m_yaw   -= dx * m_mouseSensitivity;
    m_pitch -= dy * m_mouseSensitivity;
    m_pitch = max(-1.2f, min(1.2f, m_pitch));
}

void ThirdPersonCamera::Update(float deltaTime, const XMFLOAT3& targetPos, float targetYaw)
{
    // Desired position behind the player
    float cosYaw = cosf(m_yaw);
    float sinYaw = sinf(m_yaw);
    float cosPitch = cosf(m_pitch);
    float sinPitch = sinf(m_pitch);

    XMFLOAT3 desiredOffset;
    desiredOffset.x = sinYaw * cosPitch * m_desiredDistance;
    desiredOffset.y = sinPitch * m_desiredDistance + m_heightOffset;
    desiredOffset.z = cosYaw * cosPitch * m_desiredDistance;

    XMFLOAT3 desiredPos;
    desiredPos.x = targetPos.x + desiredOffset.x;
    desiredPos.y = targetPos.y + desiredOffset.y;
    desiredPos.z = targetPos.z + desiredOffset.z;

    // Smooth lag
    float t = 1.0f - expf(-m_lagSpeed * deltaTime);
    m_position.x += (desiredPos.x - m_position.x) * t;
    m_position.y += (desiredPos.y - m_position.y) * t;
    m_position.z += (desiredPos.z - m_position.z) * t;

    m_target = targetPos;
    m_target.y += 1.6f; // look at chest/head height
}

XMMATRIX ThirdPersonCamera::GetViewMatrix() const
{
    XMVECTOR eye = XMLoadFloat3(&m_position);
    XMVECTOR at  = XMLoadFloat3(&m_target);
    XMVECTOR up  = XMVectorSet(0, 1, 0, 0);
    return XMMatrixLookAtLH(eye, at, up);
}
