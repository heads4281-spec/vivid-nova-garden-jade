def generate_vortex_spell(
    image_path: str = "vortex_spell.jpg",
    ckpt_dir: str = "path/to/Wan2.1-I2V-A14B",
    output_path: str = "public/effects/crimson_vortex_spell.mp4",
    quality: str = "ultra",
    seed: int = 42,
):
    from wan.configs import WAN_CONFIGS, MAX_AREA_CONFIGS

    img = Image.open(image_path).convert("RGB")

    prompt = (
        "Epic cinematic spell animation, the dark armored figure raises his hand and unleashes a massive swirling "
        "crimson red energy vortex made of molten lava and glowing ancient runes. The vortex grows, rotates powerfully, "
        "runes pulse and flow along the surface, liquid fire and energy particles fly, gothic cathedral background, "
        "dramatic lighting, highly detailed, mythic Crimson Sovereign style, smooth powerful motion, 8k masterpiece"
    )
    negative = "blurry, static, deformed, extra limbs, low detail, cartoon, text, watermark"

    cfg = WAN_CONFIGS["i2v-A14B"]
    area = MAX_AREA_CONFIGS.get("1280*720", 1280*720)
    presets = {
        "game": dict(steps=40, guide=6.5, frames=81),
        "ultra": dict(steps=50, guide=7.5, frames=81),
        "cinematic": dict(steps=60, guide=8.0, frames=97),
    }
    p = presets.get(quality, presets["ultra"])

    pipeline = WanI2V(config=cfg, checkpoint_dir=ckpt_dir, t5_cpu=True, init_on_cpu=True, convert_model_dtype=True)

    video = pipeline.generate(
        input_prompt=prompt, img=img, max_area=area,
        frame_num=p["frames"], sampling_steps=p["steps"], guide_scale=p["guide"],
        n_prompt=negative, seed=seed, offload_model=True,
        progress_desc="Summoning Crimson Vortex"
    )

    if video is not None:
        os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
        save_video(tensor=video[None], save_file=output_path, fps=cfg.sample_fps, nrow=1, normalize=True, value_range=(-1,1))
        print(f"✓ Vortex spell animation saved → {output_path}")
        return output_path
    return None