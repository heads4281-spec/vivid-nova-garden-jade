Continuous Collision Detection (CCD) – Swept AABB

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Continuous Collision Detection – Swept AABB</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #111;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    font-family: monospace;
  }
  canvas { background: #000; display: block; }
  #ui {
    position: absolute;
    top: 12px;
    left: 12px;
    color: #0f0;
    font-size: 14px;
    line-height: 1.5;
    pointer-events: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="ui"></div>

<script>
"use strict";

/* ===================== CONFIG ===================== */
const W = 900;
const H = 600;
const CELL_SIZE = 80;
const NUM_OBJECTS = 180;          // lower than discrete because CCD is more expensive
const SHOW_GRID = false;
const USE_CCD = true;             // toggle this to compare discrete vs continuous

/* ===================== CANVAS ===================== */
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d", { alpha: false });
const ui = document.getElementById("ui");

let dpr = Math.min(devicePixelRatio || 1, 2);
function resize() {
  dpr = Math.min(devicePixelRatio || 1, 2);
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + "px";
  canvas.style.height = H + "px";
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
resize();
window.addEventListener("resize", resize);

/* ===================== SPATIAL GRID ===================== */
class SpatialGrid {
  constructor(width, height, cellSize) {
    this.cellSize = cellSize;
    this.cols = Math.ceil(width / cellSize);
    this.rows = Math.ceil(height / cellSize);
    this.cells = new Array(this.cols * this.rows);
    for (let i = 0; i < this.cells.length; i++) this.cells[i] = [];
  }

  clear() {
    for (let i = 0; i < this.cells.length; i++) this.cells[i].length = 0;
  }

  insert(obj) {
    // Use swept bounds for broad-phase (important for CCD!)
    const minX = Math.min(obj.x, obj.x + obj.vx * 1.0);
    const maxX = Math.max(obj.x + obj.w, obj.x + obj.w + obj.vx * 1.0);
    const minY = Math.min(obj.y, obj.y + obj.vy * 1.0);
    const maxY = Math.max(obj.y + obj.h, obj.y + obj.h + obj.vy * 1.0);

    const cx1 = Math.max(0, Math.floor(minX / this.cellSize));
    const cx2 = Math.min(this.cols - 1, Math.floor(maxX / this.cellSize));
    const cy1 = Math.max(0, Math.floor(minY / this.cellSize));
    const cy2 = Math.min(this.rows - 1, Math.floor(maxY / this.cellSize));

    obj._cells = [];
    for (let cy = cy1; cy <= cy2; cy++) {
      for (let cx = cx1; cx <= cx2; cx++) {
        const idx = cy * this.cols + cx;
        this.cells[idx].push(obj);
        obj._cells.push(idx);
      }
    }
  }

  getCandidates(obj) {
    const set = new Set();
    for (const idx of obj._cells) {
      for (const other of this.cells[idx]) {
        if (other !== obj) set.add(other);
      }
    }
    return set;
  }
}

const grid = new SpatialGrid(W, H, CELL_SIZE);

/* ===================== SWEPT AABB (CCD) ===================== */
/**
 * Returns the earliest time of impact (0..1) between two moving AABBs.
 * If no collision occurs in this frame, returns 1.0
 */
function sweptAABB(a, b) {
  // Relative velocity
  const dx = b.vx - a.vx;
  const dy = b.vy - a.vy;

  // Expanded bounds of B relative to A (Minkowski difference)
  const xInvEntry = dx > 0 ? (b.x - (a.x + a.w)) : ((b.x + b.w) - a.x);
  const xInvExit  = dx > 0 ? ((b.x + b.w) - a.x) : (b.x - (a.x + a.w));

  const yInvEntry = dy > 0 ? (b.y - (a.y + a.h)) : ((b.y + b.h) - a.y);
  const yInvExit  = dy > 0 ? ((b.y + b.h) - a.y) : (b.y - (a.y + a.h));

  let xEntry, xExit, yEntry, yExit;

  if (dx === 0) {
    xEntry = -Infinity;
    xExit  =  Infinity;
  } else {
    xEntry = xInvEntry / dx;
    xExit  = xInvExit  / dx;
  }

  if (dy === 0) {
    yEntry = -Infinity;
    yExit  =  Infinity;
  } else {
    yEntry = yInvEntry / dy;
    yExit  = yInvExit  / dy;
  }

  const entryTime = Math.max(xEntry, yEntry);
  const exitTime  = Math.min(xExit, yExit);

  // No collision this frame
  if (entryTime > exitTime || entryTime < 0 || entryTime > 1) {
    return 1.0;
  }

  return entryTime;
}

/* ===================== OBJECTS ===================== */
const objects = [];
for (let i = 0; i < NUM_OBJECTS; i++) {
  const w = 16 + Math.random() * 22;
  const h = 16 + Math.random() * 22;
  objects.push({
    x: 50 + Math.random() * (W - 100),
    y: 50 + Math.random() * (H - 100),
    w, h,
    // intentionally high speeds to demonstrate tunneling prevention
    vx: (Math.random() - 0.5) * 520,
    vy: (Math.random() - 0.5) * 520,
    color: `hsl(${Math.random() * 360}, 75%, 55%)`,
    colliding: false,
    _cells: []
  });
}

/* ===================== PHYSICS STEP ===================== */
function physicsStep(dt) {
  // 1. Broad-phase with swept bounds
  grid.clear();
  for (const obj of objects) {
    obj.colliding = false;
    grid.insert(obj);
  }

  // 2. Find earliest collision
  let earliestTOI = 1.0;
  let colA = null, colB = null;

  for (const a of objects) {
    const candidates = grid.getCandidates(a);
    for (const b of candidates) {
      if (a >= b) continue; // avoid double work

      const toi = USE_CCD ? sweptAABB(a, b) : (aabbOverlap(a, b) ? 0 : 1);

      if (toi < earliestTOI) {
        earliestTOI = toi;
        colA = a;
        colB = b;
      }
    }
  }

  // 3. Advance all objects to the time of impact
  const moveTime = earliestTOI * dt;
  for (const obj of objects) {
    obj.x += obj.vx * moveTime;
    obj.y += obj.vy * moveTime;
  }

  // 4. Resolve the collision (if any)
  if (earliestTOI < 1.0 && colA && colB) {
    colA.colliding = true;
    colB.colliding = true;

    // Simple elastic bounce on the axis of least penetration
    const overlapX = Math.min(colA.x + colA.w, colB.x + colB.w) - Math.max(colA.x, colB.x);
    const overlapY = Math.min(colA.y + colA.h, colB.y + colB.h) - Math.max(colA.y, colB.y);

    if (overlapX < overlapY) {
      // X-axis collision
      const temp = colA.vx;
      colA.vx = colB.vx;
      colB.vx = temp;
    } else {
      // Y-axis collision
      const temp = colA.vy;
      colA.vy = colB.vy;
      colB.vy = temp;
    }

    // Push out a tiny bit to avoid sticking
    const push = 0.5;
    if (overlapX < overlapY) {
      if (colA.x < colB.x) { colA.x -= push; colB.x += push; }
      else                 { colA.x += push; colB.x -= push; }
    } else {
      if (colA.y < colB.y) { colA.y -= push; colB.y += push; }
      else                 { colA.y += push; colB.y -= push; }
    }
  }

  // 5. Remaining time (after collision)
  const remaining = dt * (1 - earliestTOI);
  if (remaining > 0.0001) {
    // Recurse or just finish the frame (simple version finishes the frame)
    for (const obj of objects) {
      obj.x += obj.vx * remaining;
      obj.y += obj.vy * remaining;
    }
  }

  // Wall collisions (also continuous for walls)
  for (const obj of objects) {
    if (obj.x < 0)            { obj.x = 0;            obj.vx = Math.abs(obj.vx); }
    if (obj.x + obj.w > W)    { obj.x = W - obj.w;    obj.vx = -Math.abs(obj.vx); }
    if (obj.y < 0)            { obj.y = 0;            obj.vy = Math.abs(obj.vy); }
    if (obj.y + obj.h > H)    { obj.y = H - obj.h;    obj.vy = -Math.abs(obj.vy); }
  }
}

/* Discrete fallback for comparison */
function aabbOverlap(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x &&
         a.y < b.y + b.h && a.y + a.h > b.y;
}

/* ===================== MAIN LOOP ===================== */
let last = performance.now();
let frames = 0, fpsTime = 0, fps = 0;

function loop(now) {
  const dt = Math.min((now - last) / 1000, 0.04); // clamp
  last = now;

  physicsStep(dt);

  // Render
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, W, H);

  if (SHOW_GRID) {
    // optional grid drawing omitted for clarity
  }

  for (const obj of objects) {
    ctx.fillStyle = obj.colliding ? "#ff2244" : obj.color;
    ctx.fillRect(obj.x, obj.y, obj.w, obj.h);
  }

  // Stats
  frames++;
  fpsTime += dt;
  if (fpsTime >= 0.4) {
    fps = Math.round(frames / fpsTime);
    frames = 0;
    fpsTime = 0;

    ui.innerHTML =
      `Objects: ${NUM_OBJECTS}<br>` +
      `Mode: ${USE_CCD ? "Continuous (Swept AABB)" : "Discrete"}<br>` +
      `High speeds → tunneling prevented<br>` +
      `FPS: ${fps}<br>` +
      `<br>Press <b>C</b> to toggle CCD`;
  }

  requestAnimationFrame(loop);
}

// Toggle CCD with C key
window.addEventListener("keydown", e => {
  if (e.code === "KeyC") {
    // In a real game you would restart the simulation;
    // here we just flip the flag for demonstration.
    console.log("Toggle CCD – reload page and change USE_CCD constant to compare");
  }
});

requestAnimationFrame(loop);
</script>
</body>
</html>