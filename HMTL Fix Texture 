<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Space Shooter</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
    font-family: 'Segoe UI', Arial, sans-serif;
  }
  canvas {
    background: #050510;
    display: block;
    box-shadow: 0 0 40px rgba(0, 150, 255, 0.3);
  }
  #ui {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 22px;
    text-shadow: 0 0 8px #0af;
    pointer-events: none;
    width: 800px;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
  }
  #gameOver {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 20, 0.92);
    border: 2px solid #0af;
    border-radius: 12px;
    padding: 40px 60px;
    text-align: center;
    color: #fff;
    display: none;
    box-shadow: 0 0 30px rgba(0, 170, 255, 0.4);
  }
  #gameOver h1 {
    font-size: 42px;
    margin-bottom: 10px;
    color: #f44;
    text-shadow: 0 0 15px #f44;
  }
  #gameOver p {
    font-size: 24px;
    margin-bottom: 30px;
  }
  #restartBtn {
    background: #0af;
    color: #000;
    border: none;
    padding: 12px 40px;
    font-size: 20px;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.2s;
  }
  #restartBtn:hover {
    background: #0cf;
    transform: scale(1.05);
  }
</style>
</head>
<body>
  <div id="ui">
    <div>Score: <span id="score">0</span></div>
    <div>Lives: <span id="lives">3</span></div>
  </div>
  <canvas id="gameCanvas" width="800" height="600"></canvas>
  <div id="gameOver">
    <h1>GAME OVER</h1>
    <p>Final Score: <span id="finalScore">0</span></p>
    <button id="restartBtn">Play Again</button>
  </div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const livesEl = document.getElementById('lives');
const gameOverScreen = document.getElementById('gameOver');
const finalScoreEl = document.getElementById('finalScore');
const restartBtn = document.getElementById('restartBtn');

// Game state
let score = 0;
let lives = 3;
let gameRunning = true;
let keys = {};
let bullets = [];
let asteroids = [];
let particles = [];
let stars = [];
let shootCooldown = 0;
let invulnTimer = 0;

// Player
const player = {
  x: canvas.width / 2,
  y: canvas.height - 80,
  radius: 14,
  speed: 5.5,
  angle: -Math.PI / 2
};

// Create starfield
for (let i = 0; i < 120; i++) {
  stars.push({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height,
    size: Math.random() * 2 + 0.5,
    speed: Math.random() * 1.5 + 0.3
  });
}

// Keyboard
window.addEventListener('keydown', e => {
  keys[e.code] = true;
  if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)) {
    e.preventDefault();
  }
});
window.addEventListener('keyup', e => keys[e.code] = false);

restartBtn.addEventListener('click', resetGame);

function resetGame() {
  score = 0;
  lives = 3;
  gameRunning = true;
  bullets = [];
  asteroids = [];
  particles = [];
  player.x = canvas.width / 2;
  player.y = canvas.height - 80;
  invulnTimer = 0;
  scoreEl.textContent = '0';
  livesEl.textContent = '3';
  gameOverScreen.style.display = 'none';
  spawnAsteroidWave();
}

function spawnAsteroid(x, y, radius) {
  const angle = Math.random() * Math.PI * 2;
  const speed = (Math.random() * 1.5 + 0.8) * (40 / radius);
  asteroids.push({
    x: x ?? Math.random() * canvas.width,
    y: y ?? -radius - 10,
    vx: Math.cos(angle) * speed * (Math.random() > 0.5 ? 1 : -1),
    vy: Math.abs(Math.sin(angle) * speed) + 0.5,
    radius: radius,
    rotation: 0,
    rotSpeed: (Math.random() - 0.5) * 0.05
  });
}

function spawnAsteroidWave() {
  for (let i = 0; i < 4; i++) {
    spawnAsteroid(null, null, 40);
  }
}

function createExplosion(x, y, count, color) {
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = Math.random() * 4 + 1;
    particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 40 + Math.random() * 20,
      maxLife: 60,
      color: color || '#ffaa00',
      size: Math.random() * 3 + 1
    });
  }
}

function update() {
  if (!gameRunning) return;

  // Stars
  stars.forEach(s => {
    s.y += s.speed;
    if (s.y > canvas.height) {
      s.y = 0;
      s.x = Math.random() * canvas.width;
    }
  });

  // Player movement
  if (keys['ArrowLeft'] || keys['KeyA']) player.x -= player.speed;
  if (keys['ArrowRight'] || keys['KeyD']) player.x += player.speed;
  if (keys['ArrowUp'] || keys['KeyW']) player.y -= player.speed;
  if (keys['ArrowDown'] || keys['KeyS']) player.y += player.speed;

  player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));
  player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));

  // Shooting
  if (shootCooldown > 0) shootCooldown--;
  if ((keys['Space'] || keys['KeyZ']) && shootCooldown <= 0) {
    bullets.push({
      x: player.x,
      y: player.y - 18,
      vy: -9,
      radius: 3
    });
    shootCooldown = 12;
  }

  // Bullets
  for (let i = bullets.length - 1; i >= 0; i--) {
    bullets[i].y += bullets[i].vy;
    if (bullets[i].y < -10) bullets.splice(i, 1);
  }

  // Asteroids
  for (let i = asteroids.length - 1; i >= 0; i--) {
    const a = asteroids[i];
    a.x += a.vx;
    a.y += a.vy;
    a.rotation += a.rotSpeed;

    // Wrap horizontally
    if (a.x < -a.radius) a.x = canvas.width + a.radius;
    if (a.x > canvas.width + a.radius) a.x = -a.radius;

    // Remove if off bottom
    if (a.y > canvas.height + a.radius + 50) {
      asteroids.splice(i, 1);
      continue;
    }

    // Bullet collision
    for (let j = bullets.length - 1; j >= 0; j--) {
      const b = bullets[j];
      const dx = a.x - b.x;
      const dy = a.y - b.y;
      if (Math.sqrt(dx * dx + dy * dy) < a.radius + b.radius) {
        bullets.splice(j, 1);
        createExplosion(a.x, a.y, a.radius / 2, '#ff8800');

        // Score
        if (a.radius >= 35) score += 20;
        else if (a.radius >= 20) score += 50;
        else score += 100;
        scoreEl.textContent = score;

        // Split
        if (a.radius > 18) {
          const newR = a.radius * 0.55;
          spawnAsteroid(a.x, a.y, newR);
          spawnAsteroid(a.x, a.y, newR);
        }
        asteroids.splice(i, 1);
        break;
      }
    }
  }

  // Player-asteroid collision
  if (invulnTimer > 0) invulnTimer--;
  else {
    for (let i = asteroids.length - 1; i >= 0; i--) {
      const a = asteroids[i];
      const dx = a.x - player.x;
      const dy = a.y - player.y;
      if (Math.sqrt(dx * dx + dy * dy) < a.radius + player.radius) {
        lives--;
        livesEl.textContent = lives;
        invulnTimer = 90;
        createExplosion(player.x, player.y, 30, '#0af');
        if (lives <= 0) {
          gameRunning = false;
          finalScoreEl.textContent = score;
          gameOverScreen.style.display = 'block';
        }
        break;
      }
    }
  }

  // Particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }

  // Spawn more asteroids if few remain
  if (asteroids.length < 5 && Math.random() < 0.02) {
    spawnAsteroid(null, null, Math.random() > 0.6 ? 40 : 28);
  }
}

function draw() {
  // Background
  ctx.fillStyle = '#050510';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Stars
  ctx.fillStyle = '#fff';
  stars.forEach(s => {
    ctx.globalAlpha = 0.4 + s.size / 3;
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  // Particles
  particles.forEach(p => {
    ctx.globalAlpha = p.life / p.maxLife;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;

  // Asteroids
  asteroids.forEach(a => {
    ctx.save();
    ctx.translate(a.x, a.y);
    ctx.rotate(a.rotation);
    ctx.strokeStyle = '#aaa';
    ctx.lineWidth = 2;
    ctx.beginPath();
    const sides = 8 + Math.floor(a.radius / 10);
    for (let i = 0; i < sides; i++) {
      const ang = (i / sides) * Math.PI * 2;
      const r = a.radius * (0.8 + Math.sin(i * 3.7) * 0.2);
      const px = Math.cos(ang) * r;
      const py = Math.sin(ang) * r;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.stroke();
    ctx.fillStyle = 'rgba(80, 80, 100, 0.3)';
    ctx.fill();
    ctx.restore();
  });

  // Bullets
  ctx.fillStyle = '#0ff';
  bullets.forEach(b => {
    ctx.beginPath();
    ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 10;
    ctx.shadowColor = '#0ff';
    ctx.fill();
    ctx.shadowBlur = 0;
  });

  // Player
  if (invulnTimer === 0 || Math.floor(invulnTimer / 4) % 2 === 0) {
    ctx.save();
    ctx.translate(player.x, player.y);
    ctx.fillStyle = '#0af';
    ctx.beginPath();
    ctx.moveTo(0, -16);
    ctx.lineTo(12, 12);
    ctx.lineTo(0, 6);
    ctx.lineTo(-12, 12);
    ctx.closePath();
    ctx.fill();
    // Engine glow
    ctx.fillStyle = '#f80';
    ctx.beginPath();
    ctx.moveTo(-5, 10);
    ctx.lineTo(0, 18 + Math.random() * 4);
    ctx.lineTo(5, 10);
    ctx.fill();
    ctx.restore();
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}

// Start
spawnAsteroidWave();
gameLoop();
</script>
</body>
</html>
