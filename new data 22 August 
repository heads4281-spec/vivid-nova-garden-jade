for (const box of allBoxes) grid.insert(box);

for (const box of allBoxes) {
  for (const other of grid.getCandidates(box)) {
    if (box === other) continue;
    if (aabbOverlap(box, other)) {
      // resolve with aabbPenetration() or your own physics
    }
  }
}
