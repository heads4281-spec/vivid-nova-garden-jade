using UnityEngine;
using System.Collections.Generic;
using System.IO;
using System;

public enum PityTrack { Blue, Red, Purple, Triune, Global }

[System.Serializable]
public class PityCounter
{
    public string tableID;
    public PityTrack track = PityTrack.Global;
    public int currentPity = 0;
    public int softPityStart = 40;
    public int hardPity = 70;
    public ItemRarity pityRarity = ItemRarity.Legendary;
}

[System.Serializable]
public class PitySaveData
{
    public List<PityCounter> counters = new List<PityCounter>();
    public string lastSaved;
    public long timestamp;          // for multi-device conflict
}

public class PitySystem : MonoBehaviour
{
    public static PitySystem Instance { get; private set; }

    [Header("Type VII Pity")]
    public List<PityCounter> counters = new List<PityCounter>();

    [Header("Defaults")]
    public int defaultSoftPity = 40;
    public int defaultHardPity = 70;
    public ItemRarity defaultPityRarity = ItemRarity.Legendary;

    [Header("Save")]
    public bool autoSaveOnChange = true;
    public bool autoLoadOnStart = true;
    public string saveFileName = "TypeVII_PitySave.json";

    [Header("Debug")]
    public bool showPityLogs = true;

    public System.Action OnPityChanged;

    private string SavePath => Path.Combine(Application.persistentDataPath, saveFileName);

    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else { Destroy(gameObject); return; }

        if (autoLoadOnStart) LoadPity();
    }

    void OnApplicationQuit() => SavePity();
    void OnApplicationPause(bool p) { if (p) SavePity(); }

    // -------------------- PUBLIC API --------------------
    public bool RegisterRoll(string tableID, PityTrack track, out bool hardPityTriggered)
    {
        hardPityTriggered = false;
        var c = GetOrCreate(tableID, track);
        c.currentPity++;
        OnPityChanged?.Invoke();

        if (showPityLogs)
            Debug.Log($"[Pity-{track}] {tableID} → {c.currentPity}/{c.hardPity}");

        if (autoSaveOnChange) SavePity();

        if (c.currentPity >= c.hardPity)
        {
            hardPityTriggered = true;
            return true;
        }
        return false;
    }

    public bool RegisterRoll(string tableID, out bool hard) =>
        RegisterRoll(tableID, PityTrack.Global, out hard);

    public void RegisterRareDrop(string tableID, PityTrack track, ItemRarity rarity)
    {
        var c = GetOrCreate(tableID, track);
        if (rarity >= c.pityRarity)
        {
            c.currentPity = 0;
            OnPityChanged?.Invoke();
            if (autoSaveOnChange) SavePity();
        }
    }

    public void RegisterRareDrop(string tableID, ItemRarity rarity) =>
        RegisterRareDrop(tableID, PityTrack.Global, rarity);

    public float GetSoftPityMultiplier(string tableID, PityTrack track = PityTrack.Global)
    {
        var c = GetOrCreate(tableID, track);
        if (c.currentPity < c.softPityStart) return 1f;
        float p = (float)(c.currentPity - c.softPityStart) / (c.hardPity - c.softPityStart);
        return 1f + (p * p * 4f);
    }

    public int GetCurrentPity(string tableID, PityTrack track = PityTrack.Global) =>
        GetOrCreate(tableID, track).currentPity;

    public float GetPityProgress(string tableID, PityTrack track = PityTrack.Global)
    {
        var c = GetOrCreate(tableID, track);
        return Mathf.Clamp01((float)c.currentPity / c.hardPity);
    }

    public PityCounter GetCounter(string tableID, PityTrack track) =>
        GetOrCreate(tableID, track);

    // -------------------- SAVE / LOAD --------------------
    public void SavePity()
    {
        var data = new PitySaveData
        {
            counters = new List<PityCounter>(counters),
            lastSaved = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
            timestamp = DateTimeOffset.UtcNow.ToUnixTimeSeconds()
        };

        string json = JsonUtility.ToJson(data, true);

        // Encrypt
        string encrypted = CloudSaveManager.Encrypt(json);
        File.WriteAllText(SavePath, encrypted);

        // Push to cloud
        if (CloudSaveManager.Instance != null)
            CloudSaveManager.Instance.SavePityData(encrypted);
    }

    public void LoadPity()
    {
        if (CloudSaveManager.Instance != null)
        {
            CloudSaveManager.Instance.LoadPityData(ApplyData);
        }
        else
        {
            LoadLocal();
        }
    }

    private void LoadLocal()
    {
        if (!File.Exists(SavePath)) return;
        string encrypted = File.ReadAllText(SavePath);
        string json = CloudSaveManager.Decrypt(encrypted);
        ApplyData(json);
    }

    private void ApplyData(string json)
    {
        if (string.IsNullOrEmpty(json)) return;

        try
        {
            // If still encrypted, decrypt
            if (!json.TrimStart().StartsWith("{"))
                json = CloudSaveManager.Decrypt(json);

            var data = JsonUtility.FromJson<PitySaveData>(json);
            if (data?.counters != null)
            {
                counters = data.counters;
                OnPityChanged?.Invoke();
            }
        }
        catch (Exception e)
        {
            Debug.LogError($"[Pity] Apply failed: {e.Message}");
        }
    }

    public void ResetAllPity()
    {
        foreach (var c in counters) c.currentPity = 0;
        OnPityChanged?.Invoke();
        SavePity();
    }

    private PityCounter GetOrCreate(string tableID, PityTrack track)
    {
        foreach (var c in counters)
            if (c.tableID == tableID && c.track == track) return c;

        var n = new PityCounter
        {
            tableID = tableID,
            track = track,
            softPityStart = defaultSoftPity,
            hardPity = defaultHardPity,
            pityRarity = defaultPityRarity
        };
        counters.Add(n);
        return n;
    }
}
