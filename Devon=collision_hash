import random
import json
import math

class Type7PalaceGenerator:
    def __init__(self, width=1000, height=1000, seed=63821):
        """
        1000×1000 Type VII Palace generator with multi-octave noise.
        Uses the supplied formula:
        f(x,y) = Σ amplitude_i × noise(frequency_i × x, frequency_i × y)
        """
        self.width = width
        self.height = height
        self.seed = seed
        random.seed(self.seed)

        # Tile IDs
        self.TILE_VOID = 0
        self.TILE_WALL = 1
        self.TILE_FLOOR = 2
        self.TILE_RUNESTONE = 3
        self.TILE_THRESHOLD_GATE = 4

        # Noise octaves (classic fBm parameters)
        self.octaves = [
            {"amplitude": 1.00, "frequency": 0.004},
            {"amplitude": 0.50, "frequency": 0.008},
            {"amplitude": 0.25, "frequency": 0.016},
            {"amplitude": 0.125, "frequency": 0.032},
            {"amplitude": 0.0625, "frequency": 0.064},
        ]

        # Initialize solid
        self.grid = [[self.TILE_WALL for _ in range(self.width)] for _ in range(self.height)]
        self.rooms = []
        self.noise_cache = {}   # simple cache for speed

    # ------------------------------------------------------------------
    # Value-noise implementation (deterministic, seed-aware)
    # ------------------------------------------------------------------
    def _hash(self, x, y):
        """Fast deterministic hash → [0,1)"""
        n = int(x * 374761393 + y * 668265263 + self.seed * 1274126177) & 0x7fffffff
        n = (n ^ (n >> 13)) * 1274126177
        return (n & 0x7fffffff) / 0x7fffffff

    def _smooth(self, t):
        return t * t * (3 - 2 * t)          # smoothstep

    def _noise(self, x, y):
        """2-D value noise"""
        x0, y0 = math.floor(x), math.floor(y)
        fx, fy = x - x0, y - y0
        sx, sy = self._smooth(fx), self._smooth(fy)

        n00 = self._hash(x0,     y0)
        n10 = self._hash(x0 + 1, y0)
        n01 = self._hash(x0,     y0 + 1)
        n11 = self._hash(x0 + 1, y0 + 1)

        nx0 = n00 + (n10 - n00) * sx
        nx1 = n01 + (n11 - n01) * sx
        return nx0 + (nx1 - nx0) * sy

    def fbm(self, x, y):
        """
        Exact formula you supplied:
        f(x,y) = Σ amplitude_i × noise(frequency_i × x, frequency_i × y)
        """
        key = (round(x, 3), round(y, 3))
        if key in self.noise_cache:
            return self.noise_cache[key]

        value = 0.0
        for oct in self.octaves:
            value += oct["amplitude"] * self._noise(
                oct["frequency"] * x,
                oct["frequency"] * y
            )
        self.noise_cache[key] = value
        return value

    # ------------------------------------------------------------------
    # Generation
    # ------------------------------------------------------------------
    def generate(self, num_rooms=80, min_size=20, max_size=50):
        print(f"[Type VII] Noise-augmented generation on {self.width}×{self.height} …")

        # 1. Noise-driven base terrain (organic voids / soft floors)
        for y in range(self.height):
            for x in range(self.width):
                n = self.fbm(x, y)
                if n > 0.62:
                    self.grid[y][x] = self.TILE_FLOOR
                elif n < 0.28:
                    self.grid[y][x] = self.TILE_VOID

        # 2. Carve discrete palace chambers (gameplay structure)
        for _ in range(num_rooms):
            w = random.randint(min_size, max_size)
            h = random.randint(min_size, max_size)
            x = random.randint(8, self.width - w - 8)
            y = random.randint(8, self.height - h - 8)

            new_room = {"x": x, "y": y, "w": w, "h": h}

            # Overlap test
            overlap = False
            for other in self.rooms:
                if (x < other["x"] + other["w"] + 4 and
                    x + w + 4 > other["x"] and
                    y < other["y"] + other["h"] + 4 and
                    y + h + 4 > other["y"]):
                    overlap = True
                    break

            if not overlap:
                self._carve_room(new_room)
                if self.rooms:
                    prev = self.rooms[-1]
                    self._carve_corridor(
                        prev["x"] + prev["w"] // 2,
                        prev["y"] + prev["h"] // 2,
                        x + w // 2,
                        y + h // 2
                    )
                self.rooms.append(new_room)

        # 3. Inject living features guided by residual noise
        self._inject_palace_features()
        print(f"[Type VII] {len(self.rooms)} chambers + noise field finalized.")
        return self.grid

    def _carve_room(self, room):
        for yy in range(room["y"], room["y"] + room["h"]):
            for xx in range(room["x"], room["x"] + room["w"]):
                self.grid[yy][xx] = self.TILE_FLOOR

    def _carve_corridor(self, x1, y1, x2, y2):
        # L-shaped corridor
        for x in range(min(x1, x2), max(x1, x2) + 1):
            self.grid[y1][x] = self.TILE_FLOOR
        for y in range(min(y1, y2), max(y1, y2) + 1):
            self.grid[y][x2] = self.TILE_FLOOR

    def _inject_palace_features(self):
        if not self.rooms:
            return

        # Threshold Gate – first chamber centre
        start = self.rooms[0]
        gx = start["x"] + start["w"] // 2
        gy = start["y"] + start["h"] // 2
        self.grid[gy][gx] = self.TILE_THRESHOLD_GATE

        # Living Runestones – prefer high-noise wall-adjacent cells
        for room in self.rooms[1:]:
            attempts = random.randint(3, 7)
            for _ in range(attempts):
                rx = random.randint(room["x"] + 1, room["x"] + room["w"] - 2)
                ry = random.randint(room["y"] + 1, room["y"] + room["h"] - 2)
                if self.fbm(rx, ry) > 0.55:          # noise bias
                    self.grid[ry][rx] = self.TILE_RUNESTONE

    def export_to_json(self, filename="procedural_palace_map.json"):
        data = {
            "seed": self.seed,
            "width": self.width,
            "height": self.height,
            "noise_octaves": self.octaves,
            "formula": "f(x,y) = Σ amplitude_i × noise(frequency_i × x, frequency_i × y)",
            "layers": {
                "structural_grid": self.grid
            },
            "rooms": self.rooms
        }
        with open(filename, "w") as f:
            json.dump(data, f)
        print(f"[System] Exported → {filename}")

