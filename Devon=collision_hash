</div>

<script>
/* ============================================================
   DEVON ENGINE v2 – Land Area 2590 sq mi | Glitch-Free Scale
   + Spatial Hash Collision Auto-Fix (new modular file ready)
   ============================================================ */

const REAL_AREA_SQ_MI = 2590;
const REAL_AREA_SQ_KM = 6700;

const canvas = document.getElementById('map');
const ctx = canvas.getContext('2d');
const mini = document.getElementById('mini');
const mctx = mini.getContext('2d');

let W, H;
let scale = 1.0;          // glitch-free continuous scale
let offsetX = 0, offsetY = 0;
let holo = true;
let resources = 1500;
let selected = null;
let roomLevel = 1;

/* Approximate bounding box of Devon in miles (real geography) */
const DEVON_WIDTH_MI  = 72;   // E-W
const DEVON_HEIGHT_MI = 68;   // N-S
const PX_PER_MI = 11.5;       // base pixel density so total area ≈ 2590 sq mi

/* Hundreds – positions normalised 0-1 from original Cary map */
const hundreds = [
  {id:1,name:"Braunton",x:0.18,y:0.22,r:0.065,color:"#4a90a4"},
  {id:2,name:"Shirwell",x:0.28,y:0.18,r:0.055,color:"#3d7a8c"},
  {id:3,name:"Fremington",x:0.22,y:0.32,r:0.05,color:"#5ba3b8"},
  {id:4,name:"South Molton",x:0.38,y:0.28,r:0.065,color:"#6bb8cc"},
  {id:5,name:"Hartland",x:0.12,y:0.38,r:0.055,color:"#2e6b7a"},
  {id:6,name:"Shebbear",x:0.25,y:0.42,r:0.048,color:"#4a9aab"},
  {id:7,name:"North Tawton",x:0.42,y:0.38,r:0.055,color:"#5aa8bc"},
  {id:8,name:"Winkleigh",x:0.48,y:0.32,r:0.048,color:"#6ab6c8"},
