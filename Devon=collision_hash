  {id:14,name:"Bampton",x:0.55,y:0.28,r:0.048,color:"#4a90a4"},
  {id:15,name:"Halberton",x:0.62,y:0.35,r:0.04,color:"#5ba3b8"},
  {id:16,name:"Tiverton",x:0.58,y:0.42,r:0.05,color:"#6bb8cc"},
  {id:17,name:"Cliston",x:0.72,y:0.42,r:0.048,color:"#2e6b7a"},
  {id:18,name:"Axminster",x:0.82,y:0.48,r:0.055,color:"#4a9aab"},
  {id:19,name:"Lifton",x:0.32,y:0.55,r:0.055,color:"#5aa8bc"},
  {id:20,name:"Tavistock",x:0.28,y:0.65,r:0.065,color:"#6ab6c8"},
  {id:21,name:"Roborough",x:0.38,y:0.68,r:0.055,color:"#7ac4d4"},
  {id:22,name:"Plympton",x:0.42,y:0.78,r:0.048,color:"#4a8c9e"},
  {id:23,name:"Ermington",x:0.48,y:0.82,r:0.048,color:"#5a9cae"},
