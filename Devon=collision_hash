  {id:28,name:"Exminster",x:0.72,y:0.62,r:0.05,color:"#6bb8cc"},
  {id:29,name:"Wonford",x:0.78,y:0.58,r:0.04,color:"#2e6b7a"},
  {id:30,name:"Black Torrington",x:0.35,y:0.48,r:0.055,color:"#4a9aab"},
  {id:31,name:"Westleigh",x:0.18,y:0.48,r:0.048,color:"#5aa8bc"},
  {id:32,name:"Northam",x:0.15,y:0.28,r:0.04,color:"#6ab6c8"}
];

hundreds.forEach(h=>{
  h.level=1; h.income=9+Math.floor(Math.random()*7); h.upgrades=0;
  h.px = h.x * DEVON_WIDTH_MI * PX_PER_MI;
  h.py = h.y * DEVON_HEIGHT_MI * PX_PER_MI;
  h.pr = h.r * Math.min(DEVON_WIDTH_MI,DEVON_HEIGHT_MI) * PX_PER_MI;
});

/* ========== NEW FILE: Spatial Hash Collision Module ========== */
class SpatialHash {
  constructor(cellSize=80){
    this.cellSize=cellSize;
    this.grid=new Map();
  }
  key(cx,cy){return `${cx},${cy}`;}
  insert(obj){
    const minX=Math.floor((obj.px-obj.pr)/this.cellSize);
    const maxX=Math.floor((obj.px+obj.pr)/this.cellSize);
    const minY=Math.floor((obj.py-obj.pr)/this.cellSize);
    const maxY=Math.floor((obj.py+obj.pr)/this.cellSize);
    for(let x=minX;x<=maxX;x++)
      for(let y=minY;y<=maxY;y++){
        const k=this.key(x,y);
        if(!this.grid.has(k)) this.grid.set(k,[]);
        this.grid.get(k).push(obj);
      }
  }
  clear(){this.grid.clear();}
  query(obj){
    const near=new Set();
    const minX=Math.floor((obj.px-obj.pr)/this.cellSize);
    const maxX=Math.floor((obj.px+obj.pr)/this.cellSize);
    const minY=Math.floor((obj.py-obj.pr)/this.cellSize);
    const maxY=Math.floor((obj.py+obj.pr)/this.cellSize);
    for(let x=minX;x<=maxX;x++)
      for(let y=minY;y<=maxY;y++){
        const list=this.grid.get(this.key(x,y))||[];
        list.forEach(o=>near.add(o));
      }
    return [...near];
  }
}

const spatial = new SpatialHash(90);

function autoFixCollisions(){
  spatial.clear();
  hundreds.forEach(h=>spatial.insert(h));
  let fixed=0;
  for(let i=0;i<hundreds.length;i++){
    const a=hundreds[i];
    const candidates=spatial.query(a);
    candidates.forEach(b=>{
      if(a===b) return;
      const dx=b.px-a.px, dy=b.py-a.py;
      const dist=Math.sqrt(dx*dx+dy*dy);
      const minDist=a.pr+b.pr+4;
      if(dist<minDist && dist>0){
        const push=(minDist-dist)/2;
        const nx=dx/dist, ny=dy/dist;
        a.px-=nx*push; a.py-=ny*push;
        b.px+=nx*push; b.py+=ny*push;
        fixed++;
      }
    });
  }
  // re-normalise after fix so they stay inside map bounds
  hundreds.forEach(h=>{
    h.x=h.px/(DEVON_WIDTH_MI*PX_PER_MI);
    h.y=h.py/(DEVON_HEIGHT_MI*PX_PER_MI);
  });
  document.getElementById('infoText').innerHTML=
    `Auto-collision fix complete • ${fixed} overlaps resolved<br>Land area still locked at 2,590 sq mi`;
  updateUI();
}

/* Glitch-free coordinate helpers */
function toScreen(px,py){
  return {
    x: px*scale + offsetX + W*0.5 - (DEVON_WIDTH_MI*PX_PER_MI*scale)/2,
    y: py*scale + offsetY + H*0.5 - (DEVON_HEIGHT_MI*PX_PER_MI*scale)/2
  };
}

function resize(){
  W=canvas.width=window.innerWidth;
  H=canvas.height=window.innerHeight;
}
window.addEventListener('resize',resize);
resize();

/* Draw loop – glitch-free */
function draw(){
  ctx.fillStyle='#050a14';
  ctx.fillRect(0,0,W,H);

  // water
  ctx.fillStyle='#0b2433';
  ctx.beginPath();
  ctx.moveTo(0,H*0.78);
  ctx.quadraticCurveTo(W*0.45,H*0.88,W,H*0.72);
  ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.fill();

  // Devon outline
  ctx.strokeStyle=holo?'#00e5ff':'#2a5a6a';
  ctx.lineWidth=2.8*scale;
  if(holo){ctx.shadowColor='#00e5ff';ctx.shadowBlur=14;}
  ctx.beginPath();
  const outline=[
    [0.08,0.25],[0.12,0.15],[0.25,0.08],[0.45,0.12],[0.65,0.18],
    [0.82,0.28],[0.92,0.42],[0.88,0.58],[0.78,0.72],[0.65,0.85],
    [0.48,0.92],[0.32,0.88],[0.18,0.75],[0.10,0.55],[0.08,0.35]
  ];
  outline.forEach((p,i)=>{
    const s=toScreen(p[0]*DEVON_WIDTH_MI*PX_PER_MI,p[1]*DEVON_HEIGHT_MI*PX_PER_MI);
    i===0?ctx.moveTo(s.x,s.y):ctx.lineTo(s.x,s.y);
  });
  ctx.closePath();ctx.stroke();
  ctx.shadowBlur=0;

  // Hundreds
  hundreds.forEach(h=>{
    const s=toScreen(h.px,h.py);
    const r=h.pr*scale*(1+h.level*0.07);
    ctx.beginPath();
    ctx.arc(s.x,s.y,r,0,Math.PI*2);
    ctx.fillStyle=h===selected?'#00e5ff66':h.color+'cc';
    ctx.fill();
    if(holo){ctx.strokeStyle='#7df9ff';ctx.lineWidth=1.6;ctx.stroke();}
    if(h.level>1){
      ctx.beginPath();ctx.arc(s.x,s.y,r+7*scale,0,Math.PI*2);
      ctx.strokeStyle='#ffd700';ctx.lineWidth=2.2;ctx.stroke();
    }
    if(scale>0.55){
      ctx.fillStyle='#e8f7ff';
      ctx.font=`${Math.max(10,11*scale)}px Share Tech Mono`;
      ctx.textAlign='center';
      ctx.fillText(h.name,s.x,s.y+3);
      ctx.font=`${Math.max(9,9*scale)}px Share Tech Mono`;
      ctx.fillText(`Lv.${h.level}`,s.x,s.y+16*scale);
    }
  });

  // holographic grid (glitch-free)
  if(holo){
    ctx.strokeStyle='#00e5ff15';ctx.lineWidth=1;
    for(let i=0;i<24;i++){const x=i/24*W;ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
    for(let i=0;i<16;i++){const y=i/16*H;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  }

  // minimap
  mctx.fillStyle='#050a14';mctx.fillRect(0,0,240,170);
  mctx.strokeStyle='#00e5ff';mctx.strokeRect(2,2,236,166);
  hundreds.forEach(h=>{
    mctx.beginPath();
    mctx.arc(h.x*210+15,h.y*145+12,h.r*55,0,Math.PI*2);
    mctx.fillStyle=h===selected?'#00e5ff':h.color;
    mctx.fill();
  });

  requestAnimationFrame(draw);
}
draw();

/* Interaction – glitch-free */
let dragging=false,lastX,lastY;
canvas.addEventListener('mousedown',e=>{
  dragging=true;lastX=e.clientX;lastY=e.clientY;
  const mx=(e.clientX-offsetX-W*0.5+(DEVON_WIDTH_MI*PX_PER_MI*scale)/2)/scale;
  const my=(e.clientY-offsetY-H*0.5+(DEVON_HEIGHT_MI*PX_PER_MI*scale)/2)/scale;
  selected=null;
  hundreds.forEach(h=>{
    const dx=mx-h.px,dy=my-h.py;
    if(Math.sqrt(dx*dx+dy*dy)<h.pr*(1+h.level*0.07)) selected=h;
  });
  updateUI();
});
canvas.addEventListener('mousemove',e=>{
  if(!dragging)return;
  offsetX+=e.clientX-lastX;
  offsetY+=e.clientY-lastY;
  lastX=e.clientX;lastY=e.clientY;
});
canvas.addEventListener('mouseup',()=>dragging=false);
canvas.addEventListener('wheel',e=>{
  e.preventDefault();
  const factor=e.deltaY>0?0.92:1.08;
  const old=scale;
  scale=Math.max(0.28,Math.min(5.5,scale*factor));
  // keep mouse point stable (glitch-free)
  offsetX=e.clientX-(e.clientX-offsetX)*(scale/old);
  offsetY=e.clientY-(e.clientY-offsetY)*(scale/old);
  document.getElementById('scaleVal').textContent=scale.toFixed(3)+'×';
},{passive:false});

/* UI */
function updateUI(){
  document.getElementById('res').textContent=resources;
  document.getElementById('sel').textContent=selected?selected.name:'None';
  document.getElementById('areaVal').textContent=REAL_AREA_SQ_MI.toLocaleString();
  const box=document.getElementById('upgrades');
  if(!selected){box.innerHTML='<p style="opacity:.6">Select a Hundred</p>';return;}
  box.innerHTML=`
    <p><b>${selected.name}</b> – Level ${selected.level}</p>
    <p>Income +${selected.income}/tick</p>
    <button class="btn" onclick="upgradeSelected()">Upgrade (cost ${selected.level*48})</button>`;
  document.getElementById('infoText').innerHTML=
    `<b>${selected.name}</b><br>Historic Hundred • Real map area 2,590 sq mi<br>
     Level ${selected.level} • Collision engine active`;
}

function upgradeSelected(){
  if(!selected)return;
  const cost=selected.level*48;
  if(resources<cost)return alert('Not enough resources');
  resources-=cost;selected.level++;selected.income+=7;selected.upgrades++;
  autoFixCollisions();updateUI();
}

function expandRoom(){
  roomLevel++;scale=Math.min(5.5,scale*1.12);
  document.getElementById('scaleVal').textContent=scale.toFixed(3)+'×';
  resources+=90;updateUI();
}

function fillAllScales(){
  hundreds.forEach(h=>{if(resources>=35){resources-=35;h.level++;h.income+=5;}});
  scale=Math.min(5.5,scale*1.22);
  document.getElementById('scaleVal').textContent=scale.toFixed(3)+'×';
  autoFixCollisions();updateUI();
}

function newFileModule(){
  // Creates a downloadable new collision file
  const code=`/* collision-hash.js – Auto-generated from Devon Engine v2 */
export class SpatialHash{
  constructor(cellSize=90){this.cellSize=cellSize;this.grid=new Map();}
  key(cx,cy){return cx+','+cy;}
  insert(obj){/* same implementation as engine */}
  query(obj){/* same */}
  autoFix(objects){/* push-apart logic */}
}
console.log('New collision file ready – land area locked 2590 sq mi');`;
  const blob=new Blob([code],{type:'text/javascript'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='devon-collision-hash.js';
  a.click();
  document.getElementById('infoText').innerHTML='New file <b>devon-collision-hash.js</b> downloaded • ready for import';
}

function toggleHolo(){holo=!holo;}
function resetView(){scale=1;offsetX=0;offsetY=0;document.getElementById('scaleVal').textContent='1.000×';}
function fullStretch(){scale=2.6;offsetX=-120;offsetY=-60;document.getElementById('scaleVal').textContent='2.600×';}

function saveEngine(){
  const data={resources,scale,roomLevel,hundreds:hundreds.map(h=>({id:h.id,level:h.level,income:h.income,px:h.px,py:h.py}))};
  localStorage.setItem('devonEngineV2',JSON.stringify(data));
  alert('Engine state saved (area still 2,590 sq mi)');
}
function loadEngine(){
  const raw=localStorage.getItem('devonEngineV2');
  if(!raw)return;
  const data=JSON.parse(raw);
  resources=data.resources;scale=data.scale;roomLevel=data.roomLevel;
  data.hundreds.forEach(d=>{
    const h=hundreds.find(x=>x.id===d.id);
    if(h){h.level=d.level;h.income=d.income;h.px=d.px;h.py=d.py;}
  });
  document.getElementById('scaleVal').textContent=scale.toFixed(3)+'×';
  updateUI();
}

/* Resource tick */
setInterval(()=>{
  let gain=0;hundreds.forEach(h=>gain+=h.income);
  resources+=Math.floor(gain/7);
  updateUI();
},2200);

// Initial collision pass
setTimeout(autoFixCollisions,400);
updateUI();
</script>
