<script type="module">
import * as THREE from 'three';

// ========== STATE ==========
let godmode = false, noclip = false, speedBoost = false, infJump = false;
let claimed = 0;
const keys = {};
let velocity = new THREE.Vector3();
let canJump = true;
let yaw = 0, pitch = 0.3;
let pointerLocked = false;

// ========== SCENE SETUP ==========
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x1a0505);
scene.fog = new THREE.FogExp2(0x2a0a0a, 0.018);

const camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, 0.1, 300);
const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
document.body.appendChild(renderer.domElement);
renderer.domElement.style.display = 'none';

// Lights
const amb = new THREE.AmbientLight(0x331111, 0.55);
scene.add(amb);
const dir = new THREE.DirectionalLight(0xff4444, 1.4);
dir.position.set(8, 15, 6);
scene.add(dir);
const point1 = new THREE.PointLight(0xff2200, 1.2, 25);
point1.position.set(-6, 4, 3);
scene.add(point1);

// Floor + path
const floor = new THREE.Mesh(new THREE.PlaneGeometry(120,120), new THREE.MeshStandardMaterial({color:0x2a1212, roughness:0.92}));
floor.rotation.x = -Math.PI/2;
scene.add(floor);
const path = new THREE.Mesh(new THREE.PlaneGeometry(5,50), new THREE.MeshStandardMaterial({color:0xf0e0d0}));
path.rotation.x = -Math.PI/2; path.position.y = 0.02;
scene.add(path);

// Player
const player = new THREE.Group();
const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.42,1.25,6,12), new THREE.MeshStandardMaterial({color:0xcc1133, roughness:0.4, metalness:0.3}));
body.position.y = 1.15; player.add(body);
const head = new THREE.Mesh(new THREE.SphereGeometry(0.33,16,16), new THREE.MeshStandardMaterial({color:0xf5e6d3}));
head.position.y = 2.15; player.add(head);
const hair = new THREE.Mesh(new THREE.SphereGeometry(0.35,16,16), new THREE.MeshStandardMaterial({color:0xffffff}));
hair.position.y = 2.3; player.add(hair);
player.position.set(0,0,6);
scene.add(player);

// Orbs
const orbs = [];
function spawnOrb(x,z){
  const orb = new THREE.Mesh(new THREE.SphereGeometry(0.55,24,24), new THREE.MeshStandardMaterial({color:0xff2222, emissive:0x880000, emissiveIntensity:0.9}));
  orb.position.set(x,1.4,z);
  scene.add(orb); orbs.push(orb);
}
spawnOrb(-2.5,6); spawnOrb(2.5,6);

// Collectible Names
const names = [];
const namePos = [new THREE.Vector3(-10,1.2,-8), new THREE.Vector3(11,1.2,-12), new THREE.Vector3(-14,1.2,9), new THREE.Vector3(8,1.2,14)];
namePos.forEach((p,i)=>{
  const n = new THREE.Mesh(new THREE.IcosahedronGeometry(0.65,0), new THREE.MeshStandardMaterial({color:0xffaa00, emissive:0xaa4400, emissiveIntensity:0.7}));
  n.position.copy(p); n.userData = {collected:false, id:i};
  scene.add(n); names.push(n);
});

// Atmosphere cubes + particles
for(let i=0;i<25;i++){
  const c = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.5,0.5), new THREE.MeshStandardMaterial({color:0x990000}));
  c.position.set((Math.random()-0.5)*70, Math.random()*8+1, (Math.random()-0.5)*70);
  scene.add(c);
}
const pGeo = new THREE.BufferGeometry();
const pPos = new Float32Array(600*3);
for(let i=0;i<pPos.length;i++) pPos[i]=(Math.random()-0.5)*80;
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos,3));
scene.add(new THREE.Points(pGeo, new THREE.PointsMaterial({color:0xff3333, size:0.11, transparent:true, opacity:0.55})));

// ========== INPUT ==========
window.addEventListener('keydown', e=>{
  keys[e.code]=true;
  if(e.code==='F1') toggleModMenu();
  if(e.code==='Escape') document.getElementById('mod-menu').style.display='none';
});
window.addEventListener('keyup', e=> keys[e.code]=false);

renderer.domElement.addEventListener('click', ()=>{
  renderer.domElement.requestPointerLock();
});
document.addEventListener('pointerlockchange', ()=>{
  pointerLocked = document.pointerLockElement === renderer.domElement;
});
document.addEventListener('mousemove', e=>{
  if(pointerLocked){
    yaw -= e.movementX * 0.0022;
    pitch -= e.movementY * 0.0022;
    pitch = Math.max(-1.15, Math.min(1.15, pitch));
  }
});

// ========== MOD MENU ==========
function toggleModMenu(){
  const m = document.getElementById('mod-menu');
  m.style.display = m.style.display==='block' ? 'none' : 'block';
  document.getElementById('mod-status').style.display = 'block';
}
document.getElementById('god-btn').onclick = ()=>{
  godmode = !godmode;
  document.getElementById('god-btn').textContent = godmode?'ON':'OFF';
};
document.getElementById('noclip-btn').onclick = ()=>{
  noclip = !noclip;
  document.getElementById('noclip-btn').textContent = noclip?'ON':'OFF';
};
document.getElementById('speed-btn').onclick = ()=>{
  speedBoost = !speedBoost;
  document.getElementById('speed-btn').textContent = speedBoost?'ON':'OFF';
};
document.getElementById('infjump-btn').onclick = ()=>{
  infJump = !infJump;
  document.getElementById('infjump-btn').textContent = infJump?'ON':'OFF';
};
document.getElementById('spawn-name').onclick = ()=>{
  const n = new THREE.Mesh(new THREE.IcosahedronGeometry(0.65,0), new THREE.MeshStandardMaterial({color:0xffaa00, emissive:0xaa4400, emissiveIntensity:0.7}));
  n.position.copy(player.position); n.position.y=1.5; n.position.z-=3;
  n.userData={collected:false,id:names.length};
  scene.add(n); names.push(n);
};
document.getElementById('spawn-orb').onclick = ()=> spawnOrb(player.position.x+ (Math.random()-0.5)*4, player.position.z-3);
document.getElementById('tp-home').onclick = ()=>{ player.position.set(0,0,6); velocity.set(0,0,0); };
document.getElementById('fog-btn').onclick = ()=>{
  if(scene.fog){ scene.fog=null; document.getElementById('fog-btn').textContent='OFF'; }
  else { scene.fog=new THREE.FogExp2(0x2a0a0a,0.018); document.getElementById('fog-btn').textContent='ON'; }
};
document.getElementById('unlock-all').onclick = ()=>{
  names.forEach(n=>{ if(!n.userData.collected){ n.userData.collected=true; n.visible=false; claimed++; }});
  document.getElementById('names').textContent = claimed;
};
document.getElementById('close-mod').onclick = ()=> document.getElementById('mod-menu').style.display='none';

// Mobile buttons
document.querySelectorAll('.ctrl-btn').forEach(b=>{
  b.onclick = ()=>{
    const a = b.dataset.action;
    if(a==='jump'){ if(canJump||infJump){ velocity.y=0.32; canJump=false; }}
    if(a==='sprint') speedBoost = !speedBoost;
  };
});

// ========== START GAME ==========
document.getElementById('enter-btn').onclick = ()=>{
  document.getElementById('title-screen').classList.add('hidden');
  document.getElementById('game-ui').style.display='block';
  renderer.domElement.style.display='block';
  setTimeout(()=>renderer.domElement.requestPointerLock(), 300);
};

// ========== GAME LOOP ==========
function animate(){
  requestAnimationFrame(animate);
  const dt = 0.016;
  const speed = (speedBoost ? 0.32 : 0.13);

  // Movement
  const forward = new THREE.Vector3(Math.sin(yaw), 0, Math.cos(yaw));
  const right = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));
  if(keys['KeyW']) velocity.add(forward.clone().multiplyScalar(speed));
  if(keys['KeyS']) velocity.add(forward.clone().multiplyScalar(-speed));
  if(keys['KeyA']) velocity.add(right.clone().multiplyScalar(-speed));
  if(keys['KeyD']) velocity.add(right.clone().multiplyScalar(speed));
  if((keys['Space']||infJump) && (canJump||infJump)){ velocity.y = 0.32; canJump=false; }

  if(!noclip){
    velocity.y -= 0.018;
    player.position.add(velocity);
    if(player.position.y < 0){ player.position.y=0; velocity.y=0; canJump=true; }
  } else {
    if(keys['KeyW']) player.position.add(forward.clone().multiplyScalar(speed*1.5));
    if(keys['KeyS']) player.position.add(forward.clone().multiplyScalar(-speed*1.5));
    if(keys['KeyA']) player.position.add(right.clone().multiplyScalar(-speed*1.5));
    if(keys['KeyD']) player.position.add(right.clone().multiplyScalar(speed*1.5));
    if(keys['Space']) player.position.y += speed*1.2;
    if(keys['ShiftLeft']) player.position.y -= speed*1.2;
  }
  velocity.x *= 0.82; velocity.z *= 0.82;

  // Camera (third-person spring)
  const camOffset = new THREE.Vector3(
    Math.sin(yaw)*8.5,
    3.8 + pitch*3.5,
    Math.cos(yaw)*8.5
  );
  camera.position.lerp(player.position.clone().add(camOffset), 0.12);
  camera.lookAt(player.position.clone().add(new THREE.Vector3(0,1.6,0)));

  // Animate orbs & names
  orbs.forEach((o,i)=>{ o.position.y = 1.4 + Math.sin(Date.now()*0.003+i)*0.28; o.rotation.y+=0.025; });
  names.forEach(n=>{
    if(!n.userData.collected){
      n.rotation.y += 0.04;
      if(n.position.distanceTo(player.position)<1.9){
        n.userData.collected=true; n.visible=false; claimed++;
        document.getElementById('names').textContent=claimed;
      }
    }
  });

  // Godmode visual
  if(godmode) body.material.emissive.setHex(0x330000);
  else body.material.emissive.setHex(0x000000);

  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', ()=>{
  camera.aspect = innerWidth/innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
