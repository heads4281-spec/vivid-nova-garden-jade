<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WebGL Graphics Rendering – Full Example</title>
<style>
  body { margin: 0; background: #111; overflow: hidden; display: flex; justify-content: center; align-items: center; height: 100vh; }
  canvas { display: block; background: #000; }
  #info { position: absolute; top: 10px; left: 10px; color: #0f0; font: 14px monospace; pointer-events: none; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="info">WebGL | Particles: 0 | FPS: --</div>

<script>
"use strict";

const canvas = document.getElementById("c");
const gl = canvas.getContext("webgl", { antialias: false, alpha: false });
const info = document.getElementById("info");

if (!gl) {
  alert("WebGL not supported");
  throw new Error("No WebGL");
}

/* ===================== RESIZE ===================== */
let W = 800, H = 600, dpr = 1;
function resize() {
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  W = Math.min(window.innerWidth, 900);
  H = Math.min(window.innerHeight, 700);
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + "px";
  canvas.style.height = H + "px";
  gl.viewport(0, 0, canvas.width, canvas.height);
}
resize();
window.addEventListener("resize", resize);

/* ===================== SHADERS ===================== */
const vsSource = `
  attribute vec2 a_position;
  attribute vec2 a_texCoord;
  attribute float a_size;
  attribute vec4 a_color;

  uniform vec2 u_resolution;
  uniform float u_time;

  varying vec2 v_texCoord;
  varying vec4 v_color;

  void main() {
    vec2 zeroToOne = a_position / u_resolution;
    vec2 zeroToTwo = zeroToOne * 2.0;
    vec2 clipSpace = zeroToTwo - 1.0;
    gl_Position = vec4(clipSpace * vec2(1, -1), 0, 1);
    gl_PointSize = a_size;
    v_texCoord = a_texCoord;
    v_color = a_color;
  }
`;

const fsSource = `
  precision mediump float;
  varying vec2 v_texCoord;
  varying vec4 v_color;
  uniform sampler2D u_texture;
  uniform bool u_useTexture;

  void main() {
    if (u_useTexture) {
      vec4 tex = texture2D(u_texture, gl_PointCoord);
      gl_FragColor = tex * v_color;
    } else {
      // soft circle particle
      float d = length(gl_PointCoord - vec2(0.5));
      float alpha = 1.0 - smoothstep(0.3, 0.5, d);
      gl_FragColor = v_color * alpha;
    }
  }
`;

function createShader(type, source) {
  const shader = gl.createShader(type);
  gl.shaderSource(shader, source);
  gl.compileShader(shader);
  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
    console.error(gl.getShaderInfoLog(shader));
    gl.deleteShader(shader);
    return null;
  }
  return shader;
}

const vs = createShader(gl.VERTEX_SHADER, vsSource);
const fs = createShader(gl.FRAGMENT_SHADER, fsSource);
const program = gl.createProgram();
gl.attachShader(program, vs);
gl.attachShader(program, fs);
gl.linkProgram(program);
if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
  console.error(gl.getProgramInfoLog(program));
}

/* ===================== LOCATIONS ===================== */
const aPosition  = gl.getAttribLocation(program, "a_position");
const aTexCoord  = gl.getAttribLocation(program, "a_texCoord");
const aSize      = gl.getAttribLocation(program, "a_size");
const aColor     = gl.getAttribLocation(program, "a_color");
const uResolution = gl.getUniformLocation(program, "u_resolution");
const uTime       = gl.getUniformLocation(program, "u_time");
const uTexture    = gl.getUniformLocation(program, "u_texture");
const uUseTexture = gl.getUniformLocation(program, "u_useTexture");

/* ===================== BUFFERS ===================== */
const maxParticles = 2000;
const positions = new Float32Array(maxParticles * 2);
const sizes     = new Float32Array(maxParticles);
const colors    = new Float32Array(maxParticles * 4);

const posBuffer  = gl.createBuffer();
const sizeBuffer = gl.createBuffer();
const colorBuffer= gl.createBuffer();

/* ===================== PARTICLE SYSTEM ===================== */
const particles = [];
for (let i = 0; i < maxParticles; i++) {
  particles.push({
    x: 0, y: 0, vx: 0, vy: 0,
    life: 0, maxLife: 1,
    size: 8, r: 1, g: 1, b: 1, a: 1,
    active: false
  });
}

function spawnParticle(x, y) {
  for (let i = 0; i < maxParticles; i++) {
    const p = particles[i];
    if (!p.active) {
      p.active = true;
      p.x = x; p.y = y;
      const angle = Math.random() * Math.PI * 2;
      const speed = 60 + Math.random() * 180;
      p.vx = Math.cos(angle) * speed;
      p.vy = Math.sin(angle) * speed;
      p.life = p.maxLife = 0.6 + Math.random() * 0.8;
      p.size = 6 + Math.random() * 14;
      p.r = 0.2 + Math.random() * 0.8;
      p.g = 0.4 + Math.random() * 0.6;
      p.b = 1.0;
      p.a = 1;
      return;
    }
  }
}

/* ===================== TEXTURE (simple white circle) ===================== */
function createCircleTexture() {
  const size = 64;
  const c = document.createElement("canvas");
  c.width = c.height = size;
  const ctx = c.getContext("2d");
  const g = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
  g.addColorStop(0, "rgba(255,255,255,1)");
  g.addColorStop(0.4, "rgba(255,255,255,0.8)");
  g.addColorStop(1, "rgba(255,255,255,0)");
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, size, size);

  const tex = gl.createTexture();
  gl.bindTexture(gl.TEXTURE_2D, tex);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, c);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  return tex;
}
const particleTex = createCircleTexture();

/* ===================== RENDER STATE ===================== */
gl.enable(gl.BLEND);
gl.blendFunc(gl.SRC_ALPHA, gl.ONE);          // additive for nice glow
gl.clearColor(0.02, 0.02, 0.05, 1);

/* ===================== MAIN LOOP ===================== */
let last = performance.now();
let frames = 0, fpsTime = 0, fps = 0;
let mouseX = W/2, mouseY = H/2;

canvas.addEventListener("mousemove", e => {
  const rect = canvas.getBoundingClientRect();
  mouseX = (e.clientX - rect.left);
  mouseY = (e.clientY - rect.top);
});

function frame(now) {
  const dt = Math.min((now - last) / 1000, 0.05);
  last = now;

  // Spawn particles under mouse
  for (let i = 0; i < 6; i++) spawnParticle(mouseX, mouseY);

  // Update particles
  let count = 0;
  for (let i = 0; i < maxParticles; i++) {
    const p = particles[i];
    if (!p.active) continue;
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vx *= 0.98;
    p.vy *= 0.98;
    p.life -= dt;
    p.a = p.life / p.maxLife;
    if (p.life <= 0) p.active = false;
    else {
      positions[count*2]     = p.x;
      positions[count*2 + 1] = p.y;
      sizes[count]           = p.size * p.a;
      colors[count*4]        = p.r;
      colors[count*4 + 1]    = p.g;
      colors[count*4 + 2]    = p.b;
      colors[count*4 + 3]    = p.a;
      count++;
    }
  }

  // Upload data
  gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, positions.subarray(0, count*2), gl.DYNAMIC_DRAW);

  gl.bindBuffer(gl.ARRAY_BUFFER, sizeBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, sizes.subarray(0, count), gl.DYNAMIC_DRAW);

  gl.bindBuffer(gl.ARRAY_BUFFER, colorBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, colors.subarray(0, count*4), gl.DYNAMIC_DRAW);

  // Draw
  gl.clear(gl.COLOR_BUFFER_BIT);
  gl.useProgram(program);

  gl.uniform2f(uResolution, W, H);
  gl.uniform1f(uTime, now * 0.001);
  gl.uniform1i(uUseTexture, 1);
  gl.activeTexture(gl.TEXTURE0);
  gl.bindTexture(gl.TEXTURE_2D, particleTex);
  gl.uniform1i(uTexture, 0);

  gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
  gl.enableVertexAttribArray(aPosition);
  gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 0, 0);

  gl.bindBuffer(gl.ARRAY_BUFFER, sizeBuffer);
  gl.enableVertexAttribArray(aSize);
  gl.vertexAttribPointer(aSize, 1, gl.FLOAT, false, 0, 0);

  gl.bindBuffer(gl.ARRAY_BUFFER, colorBuffer);
  gl.enableVertexAttribArray(aColor);
  gl.vertexAttribPointer(aColor, 4, gl.FLOAT, false, 0, 0);

  gl.drawArrays(gl.POINTS, 0, count);

  // FPS
  frames++;
  fpsTime += dt;
  if (fpsTime >= 0.5) {
    fps = Math.round(frames / fpsTime);
    frames = 0; fpsTime = 0;
    info.textContent = `WebGL | Particles: ${count} | FPS: ${fps}`;
  }

  requestAnimationFrame(frame);
}

requestAnimationFrame(frame);
</script>
</body>
</html>