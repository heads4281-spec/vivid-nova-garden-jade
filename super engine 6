#version 450
layout(location = 0) in vec3 fragPos;
layout(location = 1) in vec3 fragNormal;
layout(location = 2) in vec2 fragUV;
layout(location = 3) in float pulse;

layout(location = 0) out vec4 outColor;

void main() {
    vec3 N = normalize(fragNormal);
    vec3 lightDir = normalize(vec3(0.4, 1.0, 0.3));
    float diff = max(dot(N, lightDir), 0.0);

    // Base crimson
    vec3 albedo = vec3(0.85, 0.07, 0.14);
    vec3 ambient = albedo * 0.15;
    vec3 diffuse = albedo * diff * 0.85;

    // Crimson power glow (super-graphics pulse)
    float glow = 0.15 + 0.25 * sin(pulse * 0.1);
    vec3 energy = vec3(1.0, 0.15, 0.25) * glow;

    vec3 final = ambient + diffuse + energy;
    // Simple tone map
    final = final / (final + vec3(1.0));
    outColor = vec4(final, 1.0);
}