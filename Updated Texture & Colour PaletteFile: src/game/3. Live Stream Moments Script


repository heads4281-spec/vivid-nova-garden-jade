// scripts/render-moments.mjs
// Generates infinite different moment screenshots in the same vibes

import { chromium } from "playwright";

const moments = [1, 5, 8, 12, 25, 42, 66, 88, 100];

(async () => {
  const browser = await chromium.launch({ args: ["--no-sandbox"] });
  const page = await browser.newPage({ viewport: { width: 1920, height: 1080 } });

  await page.goto("http://127.0.0.1:8080", { waitUntil: "networkidle" });

  for (const id of moments) {
    await page.evaluate((mid) => {
      window.__triggerMoment?.(mid);
    }, id);

    await page.waitForTimeout(1800);
    await page.screenshot({
      path: `screenshots/moment-${String(id).padStart(4, "0")}.png`,
      fullPage: false,
    });
    console.log(`Rendered moment ${id}`);
  }

  await browser.close();
  console.log("All moments rendered – same vibes, infinite variations ready");
})();