import React, { useEffect, useRef } from "react";
import * as THREE from "three";
import { SmoothInput } from "./smooth-input";
import { SmoothPhysics } from "./smooth-phys";
import { Moment360System } from "./moments-360";
import { C } from "./palette";
import { WEAPONS } from "./arsenal";

export default function GameApp() {
  const mountRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (!mountRef.current) return;

    // === Renderer ===
    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    renderer.shadowMap.enabled = true;
    mountRef.current.appendChild(renderer.domElement);

    // === Scene ===
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(C.void);
    scene.fog = new THREE.FogExp2(C.night, 0.018);

    // === Camera ===
    const camera = new THREE.PerspectiveCamera(72, window.innerWidth / window.innerHeight, 0.1, 800);
    camera.position.set(0, 1.7, 6);

    // === Lights ===
    const ambient = new THREE.AmbientLight(0x220011, 0.45);
    scene.add(ambient);
    const dir = new THREE.DirectionalLight(0xff2244, 1.4);
    dir.position.set(5, 18, 8);
    dir.castShadow = true;
    scene.add(dir);
    const point = new THREE.PointLight(C.arterial, 2.5, 40);
    point.position.set(0, 6, 0);
    scene.add(point);

    // === Ground ===
    const groundGeo = new THREE.PlaneGeometry(120, 120);
    const groundMat = new THREE.MeshStandardMaterial({
      color: C.blackCrystal,
      roughness: 0.85,
      metalness: 0.3,
    });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // === Simple Palace Pillars (visual) ===
    for (let i = 0; i < 8; i++) {
      const angle = (i / 8) * Math.PI * 2;
      const pillar = new THREE.Mesh(
        new THREE.CylinderGeometry(0.6, 0.8, 12, 8),
        new THREE.MeshStandardMaterial({
          color: C.blackCrystal,
          emissive: C.arterial,
          emissiveIntensity: 0.15,
          roughness: 0.4,
          metalness: 0.7,
        })
      );
      pillar.position.set(Math.cos(angle) * 14, 6, Math.sin(angle) * 14);
      pillar.castShadow = true;
      scene.add(pillar);
    }

    // === Systems ===
    const input = new SmoothInput(camera);
    const phys = new SmoothPhysics();
    const moments = new Moment360System(camera, scene, renderer);

    const playerPos = new THREE.Vector3(0, 1.7, 6);
    const playerVel = new THREE.Vector3();
    let onGround = true;
    let weaponIndex = 0;

    // === Resize ===
    const onResize = () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    };
    window.addEventListener("resize", onResize);

    // === Main Loop ===
    const clock = new THREE.Clock();
    let frameId: number;

    const animate = () => {
      frameId = requestAnimationFrame(animate);
      const dt = Math.min(clock.getDelta(), 0.05);

      // Input + Physics
      const vel = input.update(dt, onGround);
      playerVel.copy(vel);
      phys.integrate(playerPos, playerVel, dt, onGround);

      // Simple ground
      if (playerPos.y < 1.7) {
        playerPos.y = 1.7;
        playerVel.y = 0;
        onGround = true;
      } else {
        onGround = false;
      }

      camera.position.copy(playerPos);

      // Moments 360 system
      moments.update(dt);

      // Weapon switch (Q / E)
      if (input.keys?.has("KeyQ")) weaponIndex = Math.max(0, weaponIndex - 1);
      if (input.keys?.has("KeyE")) weaponIndex = Math.min(WEAPONS.length - 1, weaponIndex + 1);

      renderer.render(scene, camera);
    };
    animate();

    // Trigger a moment for testing (press M)
    window.addEventListener("keydown", (e) => {
      if (e.code === "KeyM") moments.play(Math.floor(Math.random() * 100) + 1);
    });

    return () => {
      cancelAnimationFrame(frameId);
      window.removeEventListener("resize", onResize);
      renderer.dispose();
      if (mountRef.current) mountRef.current.innerHTML = "";
    };
  }, []);

  return (
    <div
      ref={mountRef}
      style={{
        width: "100vw",
        height: "100vh",
        overflow: "hidden",
        background: "#020008",
      }}
    />
  );
}