export type SkillNodeId =
  | "damage_1" | "damage_2" | "damage_3"
  | "mag_1" | "mag_2"
  | "reload_1" | "fire_rate_1"
  | "crit_chance" | "crit_damage"
  | "lifesteal" | "explosive" | "pierce" | "multi_shot"
  | "blood_rite" | "name_echo";

export interface SkillNode {
  id: SkillNodeId;
  name: string;
  description: string;
  maxRank: number;
  cost: number;               // points needed per rank
  requires?: SkillNodeId[];   // prerequisites
  effects: {
    damageMul?: number;
    magBonus?: number;
    reloadMul?: number;
    cooldownMul?: number;
    critChance?: number;
    critDamage?: number;
    lifesteal?: number;
    explosive?: boolean;
    pierce?: boolean;
    multiShot?: number;
  };
}

export interface WeaponSkillState {
  weaponId: number;
  unlocked: Record<string, number>; // nodeId → current rank
  spentPoints: number;
}

