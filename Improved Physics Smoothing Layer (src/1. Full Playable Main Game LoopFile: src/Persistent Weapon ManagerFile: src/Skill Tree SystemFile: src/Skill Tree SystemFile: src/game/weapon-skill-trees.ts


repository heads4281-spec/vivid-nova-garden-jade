export class WeaponSkillTreeSystem {
  private trees = new Map<number, WeaponSkillState>();
  public availablePoints = 0;

  constructor(private weaponData: WeaponPersistence) {
    WEAPONS.forEach((w) => {
      this.trees.set(w.id, {
        weaponId: w.id,
        unlocked: {},
        spentPoints: 0,
      });
    });

    this.load();
  }

  getTree(weaponId: number): WeaponSkillState {
    return this.trees.get(weaponId)!;
  }

  getRank(weaponId: number, nodeId: SkillNodeId): number {
    return this.getTree(weaponId).unlocked[nodeId] || 0;
  }

  canUnlock(weaponId: number, nodeId: SkillNodeId): boolean {
    const node = SKILL_NODES[nodeId];
    const tree = this.getTree(weaponId);
    const currentRank = tree.unlocked[nodeId] || 0;

    if (currentRank >= node.maxRank) return false;
    if (this.availablePoints < node.cost) return false;

    // Check prerequisites
    if (node.requires) {
      for (const req of node.requires) {
        if ((tree.unlocked[req] || 0) < 1) return false;
      }
    }

    return true;
  }

  unlock(weaponId: number, nodeId: SkillNodeId): boolean {
    if (!this.canUnlock(weaponId, nodeId)) return false;

    const node = SKILL_NODES[nodeId];
    const tree = this.getTree(weaponId);

    this.availablePoints -= node.cost;
    tree.unlocked[nodeId] = (tree.unlocked[nodeId] || 0) + 1;
    tree.spentPoints += node.cost;

    this.save();
    console.log(`Unlocked ${node.name} on weapon ${weaponId}`);
    return true;
  }

  /** Calculate final stats for a weapon based on its skill tree */
  getFinalStats(weaponId: number) {
    const base = WEAPONS.find((w) => w.id === weaponId)!;
    const tree = this.getTree(weaponId);

    let damageMul = 1;
    let magBonus = 0;
    let reloadMul = 1;
    let cooldownMul = 1;
    let critChance = 0;
    let critDamage = 1.5;
    let lifesteal = 0;
    let multiShot = 0;
    let explosive = false;
    let pierce = false;

    Object.entries(tree.unlocked).forEach(([nodeId, rank]) => {
      const node = SKILL_NODES[nodeId as SkillNodeId];
      if (!node) return;

      const e = node.effects;
      if (e.damageMul) damageMul += e.damageMul * rank;
      if (e.magBonus) magBonus += e.magBonus * rank;
      if (e.reloadMul) reloadMul *= Math.pow(e.reloadMul, rank);
      if (e.cooldownMul) cooldownMul *= Math.pow(e.cooldownMul, rank);
      if (e.critChance) critChance += e.critChance * rank;
      if (e.critDamage) critDamage += e.critDamage * rank;
      if (e.lifesteal) lifesteal += e.lifesteal * rank;
      if (e.multiShot) multiShot += e.multiShot * rank;
      if (e.explosive) explosive = true;
      if (e.pierce) pierce = true;
    });

    return {
      damage: Math.round(base.damage * damageMul),
      mag: base.mag + magBonus,
      reload: +(base.reload * reloadMul).toFixed(2),
      cooldown: +(base.cooldown * cooldownMul).toFixed(3),
      critChance,
      critDamage,
      lifesteal,
      multiShot,
      explosive,
      pierce,
    };
  }

  addPoints(amount: number) {
    this.availablePoints += amount;
    this.save();
  }

  // Persistence
  save() {
    const data = {
      availablePoints: this.availablePoints,
      trees: Array.from(this.trees.values()),
    };
    localStorage.setItem(SKILL_SAVE_KEY, JSON.stringify(data));
  }

  load() {
    const raw = localStorage.getItem(SKILL_SAVE_KEY);
    if (!raw) return;

    try {
      const data = JSON.parse(raw);
      this.availablePoints = data.availablePoints ?? 0;

      data.trees?.forEach((t: WeaponSkillState) => {
        this.trees.set(t.weaponId, t);
      });
    } catch (err) {
      console.warn("Failed to load skill trees", err);
    }
  }

  reset() {
    localStorage.removeItem(SKILL_SAVE_KEY);
    this.availablePoints = 0;
    this.trees.forEach((t) => {
      t.unlocked = {};
      t.spentPoints = 0;
    });
  }
}