import React from "react";

interface HealthHUDProps {
  health: number;
  maxHealth: number;
  armor: number;
  isDead: boolean;
}

export function HealthHUD({ health, maxHealth, armor, isDead }: HealthHUDProps) {
  const percent = Math.max(0, Math.min(1, health / maxHealth));

  return (
    <div
      style={{
        position: "fixed",
        left: 28,
        bottom: 28,
        zIndex: 100,
        fontFamily: "'Courier New', monospace",
        color: "#ff0033",
        textShadow: "0 0 10px #ff0033aa",
        pointerEvents: "none",
        userSelect: "none",
      }}
    >
      {isDead ? (
        <div style={{ fontSize: 26, letterSpacing: "0.15em" }}>
          YOU HAVE FALLEN
          <div style={{ fontSize: 14, marginTop: 8, opacity: 0.8 }}>
            Press R to rise again
          </div>
        </div>
      ) : (
        <>
          <div style={{ fontSize: 13, letterSpacing: "0.2em", marginBottom: 6 }}>
            VITAL
          </div>

          {/* Health bar */}
          <div
            style={{
              width: 240,
              height: 16,
              background: "#120008",
              border: "1px solid #ff0033",
              borderRadius: 2,
              overflow: "hidden",
            }}
          >
            <div
              style={{
                width: `${percent * 100}%`,
                height: "100%",
                background: percent < 0.3 ? "#ff2244" : "#c41e3a",
                boxShadow: percent < 0.3 ? "0 0 12px #ff0033" : "none",
                transition: "width 0.15s ease-out",
              }}
            />
          </div>

          <div style={{ fontSize: 13, marginTop: 6 }}>
            {Math.ceil(health)} / {maxHealth}
            {armor > 0 && (
              <span style={{ marginLeft: 12, color: "#d4a017" }}>
                ARMOR {Math.ceil(armor)}
              </span>
            )}
          </div>
        </>
      )}
    </div>
  );
}