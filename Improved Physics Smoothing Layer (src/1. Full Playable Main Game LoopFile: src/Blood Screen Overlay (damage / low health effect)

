import React from "react";

interface Props {
  damageFlash: number;      // 0 → 1
  lowHealthPulse: number;   // 0 → 1
  isDead: boolean;
}

export function BloodOverlay({ damageFlash, lowHealthPulse, isDead }: Props) {
  if (isDead) {
    return (
      <div
        style={{
          position: "fixed",
          inset: 0,
          background: "radial-gradient(circle, transparent 20%, #1a0008 80%)",
          opacity: 0.85,
          pointerEvents: "none",
          zIndex: 90,
        }}
      />
    );
  }

  const intensity = Math.max(damageFlash, lowHealthPulse * 0.45);

  return (
    <div
      style={{
        position: "fixed",
        inset: 0,
        pointerEvents: "none",
        zIndex: 90,
        background: `
          radial-gradient(circle at center, transparent 35%, rgba(180,0,20,${intensity * 0.55}) 100%),
          linear-gradient(to bottom, rgba(120,0,10,${intensity * 0.25}), transparent 40%)
        `,
        mixBlendMode: "multiply",
        transition: "opacity 0.1s",
      }}
    />
  );
}