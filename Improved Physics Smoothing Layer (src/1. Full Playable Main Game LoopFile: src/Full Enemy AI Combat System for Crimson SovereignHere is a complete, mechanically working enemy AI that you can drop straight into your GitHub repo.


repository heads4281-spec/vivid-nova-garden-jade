// src/game/enemy-ai.ts
// Full enemy AI combat system – chase, attack, hurt, die

import * as THREE from "three";
import { C } from "./palette";

export type EnemyType = "shade" | "construct" | "wraith" | "sentinel";

export interface EnemyConfig {
  type: EnemyType;
  health: number;
  speed: number;
  damage: number;
  attackRange: number;
  attackCooldown: number;
  color: number;
  scale: number;
}

const ENEMY_PRESETS: Record<EnemyType, EnemyConfig> = {
  shade: {
    type: "shade",
    health: 60,
    speed: 4.8,
    damage: 12,
    attackRange: 2.2,
    attackCooldown: 1.1,
    color: C.night,
    scale: 1.0,
  },
  construct: {
    type: "construct",
    health: 140,
    speed: 2.6,
    damage: 22,
    attackRange: 2.8,
    attackCooldown: 1.6,
    color: C.blackCrystal,
    scale: 1.35,
  },
  wraith: {
    type: "wraith",
    health: 45,
    speed: 6.5,
    damage: 9,
    attackRange: 1.8,
    attackCooldown: 0.75,
    color: C.arterial,
    scale: 0.9,
  },
  sentinel: {
    type: "sentinel",
    health: 200,
    speed: 3.2,
    damage: 28,
    attackRange: 12,
    attackCooldown: 2.2,
    color: C.crimson,
    scale: 1.5,
  },
};

export class Enemy {
  public mesh: THREE.Group;
  public health: number;
  public maxHealth: number;
  public alive = true;

  private config: EnemyConfig;
  private state: "idle" | "chase" | "attack" | "hurt" | "dead" = "idle";
  private velocity = new THREE.Vector3();
  private lastAttack = 0;
  private hurtTimer = 0;
  private target: THREE.Vector3 | null = null;

  constructor(
    public readonly id: string,
    type: EnemyType,
    position: THREE.Vector3,
    private scene: THREE.Scene
  ) {
    this.config = ENEMY_PRESETS[type];
    this.health = this.config.health;
    this.maxHealth = this.config.health;

    // Visual
    this.mesh = new THREE.Group();
    const body = new THREE.Mesh(
      new THREE.CapsuleGeometry(0.35 * this.config.scale, 0.9 * this.config.scale, 4, 8),
      new THREE.MeshStandardMaterial({
        color: this.config.color,
        emissive: this.config.color,
        emissiveIntensity: 0.25,
        metalness: 0.6,
        roughness: 0.4,
      })
    );
    body.castShadow = true;
    this.mesh.add(body);

    // Simple “eyes”
    const eyeMat = new THREE.MeshBasicMaterial({ color: C.arterial });
    const eyeL = new THREE.Mesh(new THREE.SphereGeometry(0.08, 6, 6), eyeMat);
    const eyeR = eyeL.clone();
    eyeL.position.set(-0.15, 0.55 * this.config.scale, 0.32 * this.config.scale);
    eyeR.position.set(0.15, 0.55 * this.config.scale, 0.32 * this.config.scale);
    this.mesh.add(eyeL, eyeR);

    this.mesh.position.copy(position);
    this.mesh.position.y = 1.1 * this.config.scale;
    scene.add(this.mesh);
  }

  update(dt: number, playerPos: THREE.Vector3, now: number) {
    if (!this.alive) return;

    this.target = playerPos.clone();
    const toPlayer = new THREE.Vector3().subVectors(playerPos, this.mesh.position);
    const dist = toPlayer.length();
    toPlayer.y = 0;
    toPlayer.normalize();

    // State machine
    if (this.hurtTimer > 0) {
      this.hurtTimer -= dt;
      this.state = "hurt";
    } else if (dist <= this.config.attackRange) {
      this.state = "attack";
    } else if (dist < 28) {
      this.state = "chase";
    } else {
      this.state = "idle";
    }

    // Movement
    if (this.state === "chase") {
      this.velocity.lerp(toPlayer.multiplyScalar(this.config.speed), 0.12);
    } else if (this.state === "attack" || this.state === "idle") {
      this.velocity.lerp(new THREE.Vector3(0, 0, 0), 0.15);
    }

    this.mesh.position.add(this.velocity.clone().multiplyScalar(dt));
    this.mesh.position.y = 1.1 * this.config.scale;

    // Face player
    if (dist > 0.5) {
      const look = playerPos.clone();
      look.y = this.mesh.position.y;
      this.mesh.lookAt(look);
    }

    // Attack
    if (this.state === "attack" && now - this.lastAttack > this.config.attackCooldown) {
      this.lastAttack = now;
      this.performAttack(playerPos);
    }
  }

  private performAttack(playerPos: THREE.Vector3) {
    // Melee flash
    const flash = new THREE.PointLight(C.arterial, 3, 6);
    flash.position.copy(this.mesh.position);
    flash.position.y += 1;
    this.scene.add(flash);
    setTimeout(() => this.scene.remove(flash), 120);

    // You can emit an event here so the player takes damage
    // window.dispatchEvent(new CustomEvent("enemy-attack", { detail: { damage: this.config.damage } }));
    console.log(`${this.config.type} attacks for ${this.config.damage} damage`);
  }

  takeDamage(amount: number) {
    if (!this.alive) return;
    this.health -= amount;
    this.hurtTimer = 0.35;
    this.state = "hurt";

    // Flash red
    const mat = (this.mesh.children[0] as THREE.Mesh).material as THREE.MeshStandardMaterial;
    const original = mat.emissive.getHex();
    mat.emissive.setHex(0xff0000);
    setTimeout(() => mat.emissive.setHex(original), 150);

    if (this.health <= 0) this.die();
  }

  die() {
    this.alive = false;
    this.state = "dead";

    // Death effect
    const particles = new THREE.Group();
    for (let i = 0; i < 12; i++) {
      const p = new THREE.Mesh(
        new THREE.SphereGeometry(0.06, 4, 4),
        new THREE.MeshBasicMaterial({ color: C.arterial })
      );
      p.position.copy(this.mesh.position);
      p.userData.vel = new THREE.Vector3(
        (Math.random() - 0.5) * 6,
        Math.random() * 5 + 2,
        (Math.random() - 0.5) * 6
      );
      particles.add(p);
    }
    this.scene.add(particles);

    // Simple particle update + cleanup
    let life = 0.9;
    const tick = () => {
      life -= 0.016;
      particles.children.forEach((p) => {
        p.position.add(p.userData.vel.clone().multiplyScalar(0.016));
        p.userData.vel.y -=