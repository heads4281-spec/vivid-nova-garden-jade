### 3. Updated Client (index.html)

Replace the WebSocket part in your existing `index.html`.  
Add this near the top of the `<script>` section and update the connection URL:

```js
// ============== WEBSOCKET REAL-TIME ==============
const WS_URL = "wss://YOUR-SERVER-URL";   // ← change this after deploy
// Example: "wss://crimson-sovereign-production.up.railway.app"
// Local test: "ws://localhost:8080"

let socket = null;
let myId = null;
let reconnectAttempts = 0;

function connectWebSocket() {
  if (socket && socket.readyState === WebSocket.OPEN) return;

  socket = new WebSocket(WS_URL);

  socket.onopen = () => {
    console.log("WebSocket connected");
    document.getElementById("updateStatus").textContent = "LIVE · WS";
    document.getElementById("updateStatus").style.background = "#1a5c1a";
    reconnectAttempts = 0;
    log("Real-time sync connected");
  };

  socket.onmessage = (event) => {
    const msg = JSON.parse(event.data);

    switch (msg.type) {
      case "welcome":
        myId = msg.id;
        applyWorldState(msg.world);
        break;

      case "state":
        applyWorldState(msg.world);
        break;

      case "broadcast":
        log(`BROADCAST [${msg.from}]: ${msg.text}`);
        break;

      case "grant":
        if (stats[msg.stat] !== undefined) {
          stats[msg.stat] += msg.amount;
          document.getElementById("stat-" + msg.stat).textContent = stats[msg.stat];
        }
        log(`${msg.from} granted +${msg.amount} ${msg.stat}`);
        break;

      case "pong":
        // keep-alive ok
        break;
    }
  };

  socket.onclose = () => {
    document.getElementById("updateStatus").textContent = "RECONNECTING...";
    document.getElementById("updateStatus").style.background = "#5c4a1a";
    log("WebSocket disconnected – reconnecting...");
    setTimeout(connectWebSocket, Math.min(1000 * Math.pow(2, reconnectAttempts++), 15000));
  };

  socket.onerror = () => {
    socket.close();
  };
}

function applyWorldState(world) {
  if (!world) return;
  document.getElementById("playerCount").textContent = world.playerCount;
  document.getElementById("fogLevel").textContent = Math.round(world.fog) + "%";
  document.getElementById("bloodLevel").textContent = Math.round(world.blood) + "%";
  document.getElementById("identifier").textContent = world.identifier;
  document.getElementById("codeFlavour").textContent = world.codeFlavour;

  // Update news
  const newsFeed = document.getElementById("newsFeed");
  if (newsFeed && world.news) {
    newsFeed.innerHTML = world.news.map(n => `<div class="news-item">• ${n}</div>`).join("");
  }
}

function sendWS(data) {
  if (socket && socket.readyState === WebSocket.OPEN) {
    socket.send(JSON.stringify(data));
  }
}

// Call this on page load
connectWebSocket();

// Keep-alive ping every 25s
setInterval(() => sendWS({ type: "ping" }), 25000);
```

Also update your existing functions to use the WebSocket:

```js
// Example: replace your old broadcast function
function broadcast() {
  const text = document.getElementById("broadcastMsg").value.trim();
  if (text) {
    sendWS({ type: "broadcast", text });
    document.getElementById("broadcastMsg").value = "";
  }
}

// Example: grant resource now goes to everyone
function grantResource() {
  const stat = document.getElementById("grantStat").value;
  const amount = parseInt(document.getElementById("grantAmount").value) || 0;
  sendWS({ type: "grant", stat, amount });
}
```

