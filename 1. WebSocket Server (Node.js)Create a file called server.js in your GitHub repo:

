**WebSocket real-time sync implemented.**

Here’s a complete, ready-to-use solution that turns your CRIMSON SOVEREIGN into a true real-time multiplayer game server.

### What you get
- Real-time sync of players, fog/blood levels, broadcasts, stats, news, and codes
- Automatic reconnection
- Shared world state across all connected clients
- Master commands that instantly update everyone
- Works with your existing GitHub `config.json` (still auto-updates every 30s as fallback)

---

### 1. WebSocket Server (Node.js)

Create a file called `server.js` in your GitHub repo:

```js
// server.js - CRIMSON SOVEREIGN Real-time Game Server
const WebSocket = require('ws');
const http = require('http');

const PORT = process.env.PORT || 8080;

// Shared world state
let world = {
  version: "2.2.0-ws",
  players: {},
  playerCount: 0,
  fog: 42,
  blood: 67,
  mythCycles: 100000,
  loreMode: "blood",
  identifier: "CNLMMR · SOVEREIGN LV 6294 · 10 000 OPEN-WORLD MOMENTS",
  codeFlavour: "This code thickens blood in the canals. The Milky Way hungers with the palace.",
  news: [
    "WebSocket real-time sync online",
    "All codes active · One game server",
    "Master broadcasts now instant"
  ],
  validCodes: ["63821", "62821", "99812", "15785"]
};

const server = http.createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'text/plain' });
  res.end('CRIMSON SOVEREIGN WebSocket Server is running\n');
});

const wss = new WebSocket.Server({ server });

function broadcast(data, exclude = null) {
  const msg = JSON.stringify(data);
  wss.clients.forEach(client => {
    if (client.readyState === WebSocket.OPEN && client !== exclude) {
      client.send(msg);
    }
  });
}

function updatePlayerCount() {
  world.playerCount = Object.keys(world.players).length;
  broadcast({ type: 'state', world });
}

wss.on('connection', (ws, req) => {
  const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
  world.players[id] = {
    id,
    name: `Sovereign-${id.slice(-4)}`,
    class: null,
    joined: Date.now()
  };
  updatePlayerCount();

  // Send full state to new player
  ws.send(JSON.stringify({ type: 'welcome', id, world }));

  ws.on('message', (raw) => {
    try {
      const msg = JSON.parse(raw);

      switch (msg.type) {
        case 'join':
          if (msg.name) world.players[id].name = msg.name;
          if (msg.class) world.players[id].class = msg.class;
          updatePlayerCount();
          break;

        case 'broadcast':
          broadcast({
            type: 'broadcast',
            from: world.players[id].name,
            text: msg.text,
            time: Date.now()
          });
          break;

        case 'grant':
          // Master can grant resources (simple demo)
          broadcast({
            type: 'grant',
            stat: msg.stat,
            amount: msg.amount,
            from: world.players[id].name
          });
          break;

        case 'setWorld':
          // Master updates shared world values
          if (msg.fog !== undefined) world.fog = msg.fog;
          if (msg.blood !== undefined) world.blood = msg.blood;
          if (msg.loreMode) {
            world.loreMode = msg.loreMode;
            if (msg.loreMode === 'blood') {
              world.codeFlavour = "This code thickens blood in the canals. The Milky Way hungers with the palace.";
              world.identifier = "CNLMMR · SOVEREIGN LV 6294 · 10 000 OPEN-WORLD MOMENTS";
            } else {
              world.codeFlavour = "This code stills the fog. The galaxy turns slow and polite.";
              world.identifier = "TKNYRT · SOVEREIGN LV 4793 · 10 000 OPEN-WORLD MOMENTS";
            }
          }
          if (msg.news) world.news = msg.news;
          broadcast({ type: 'state', world });
          break;

        case 'ping':
          ws.send(JSON.stringify({ type: 'pong' }));
          break;
      }
    } catch (e) {
      console.error('Bad message', e);
    }
  });

  ws.on('close', () => {
    delete world.players[id];
    updatePlayerCount();
  });
});

// Light ambient simulation
setInterval(() => {
  world.fog = Math.max(10, Math.min(90, world.fog + (Math.random() * 6 - 3)));
  world.blood = Math.max(10, Math.min(95, world.blood + (Math.random() * 6 - 3)));
  broadcast({ type: 'state', world });
}, 12000);

server.listen(PORT, () => {
  console.log(`CRIMSON SOVEREIGN WebSocket Server running on port ${PORT}`);
});
```

