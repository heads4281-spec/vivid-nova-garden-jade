### Clean Initialization Order (inside `start()`)

```ts
// 1. Core systems
this.effects = new EffectSystem(this.scene, this.camera);
this.videoManager = new VideoManager(this.scene);

// 2. Load important videos
this.videoManager.load("ground", "/levels/crimson_ground_alive.mp4", {
  width: 120,
  height: 120,
  asGround: true,
  position: new THREE.Vector3(0, -0.02, 0),
  autoplay: true,
  loop: true,
});

this.videoManager.load("dragonArena", "/levels/crimson_dragon_arena.mp4", {
  width: 42,
  height: 26,
  position: new THREE.Vector3(0, 9, -32),
  autoplay: false,
  loop: true,
});

// 3. Create NPC
this.ninja = new NPCBillboard(
  this.videoManager,
  this.camera,
  "cyberNinja",
  "/npcs/cyber_ninja_idle.mp4",
  new THREE.Vector3(14, 1.8, 9),
  2.5,
  3.8
);

// 4. Optional living ground helper (if you still want it separate)
this.livingGround = new LivingGround(this.scene, "/levels/crimson_ground_alive.mp4");
```

