<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CRIMSON SOVEREIGN – Super Shape Graphics Engine</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a0f; overflow: hidden; font-family: system-ui, sans-serif; }
    canvas { display: block; width: 100vw; height: 100vh; }
    #ui {
      position: absolute; top: 12px; left: 12px;
      color: #ff4466; background: rgba(0,0,0,0.7);
      padding: 10px 16px; border-radius: 8px; font-size: 14px;
      pointer-events: none; z-index: 10;
    }
  </style>
</head>
<body>
  <div id="ui">CRIMSON SOVEREIGN Super Engine<br>Shapes • Map 100→1000 • Noclip Fix • UV Ready</div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    // ============================================================
    // CRIMSON SOVEREIGN – FULL SUPER ENGINE
    // Implements Google Drive 3D shapes + scaling 100x100→1000x1000
    // + 0.5x0.1 factors + math + noclip fix + UV + auto update
    // ============================================================

    // ---------- 1. MATH & SCALE SYSTEM ----------
    const SCALE = {
      base: 100,          // start size
      max: 1000,          // max size
      factorA: 0.5,       // 0.5×
      factorB: 0.1,       // 0.1×
      mapRatio: 25000     // from your map ratio
    };

    function getScaledSize(level = 1) {
      // Double from 100 → 1000 and apply 0.5 / 0.1
      let size = SCALE.base * Math.pow(2, level - 1);
      size = Math.min(size, SCALE.max);
      return size * SCALE.factorA * (1 + SCALE.factorB);
    }

    function getPolygonMath(sides) {
      const triangles = sides - 2;
      return {
        sides,
        triangles,
        angleSum: triangles * 180,
        interior: (triangles * 180) / sides
      };
    }

    // ---------- 2. SHAPE FACTORY (from your scanned PDF) ----------
    function createSphere(radius, color = 0xff2244) {
      const geo = new THREE.SphereGeometry(radius, 32, 32);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.3, metalness: 0.2 });
      return new THREE.Mesh(geo, mat);
    }

    function createCube(size, color = 0x44ff88) {
      const geo = new THREE.BoxGeometry(size, size, size);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.35 });
      return new THREE.Mesh(geo, mat);
    }

    function createRectPrism(w, h, d, color = 0x4488ff) {
      const geo = new THREE.BoxGeometry(w, h, d);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.3 });
      return new THREE.Mesh(geo, mat);
    }

    function createCylinder(radius, height, color = 0xffaa22) {
      const geo = new THREE.CylinderGeometry(radius, radius, height, 32);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.25 });
      return new THREE.Mesh(geo, mat);
    }

    function createCone(radius, height, color = 0xcc44ff) {
      const geo = new THREE.ConeGeometry(radius, height, 32);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.3 });
      return new THREE.Mesh(geo, mat);
    }

    function createTriPyramid(size, color = 0xff6688) {
      // Simple tetrahedron (triangular pyramid)
      const geo = new THREE.TetrahedronGeometry(size);
      const mat = new THREE.MeshStandardMaterial({ color, roughness: 0.35, flatShading: true });
      return new THREE.Mesh(geo, mat);
    }

    // ---------- 3. NOCLIP / COLLISION FIX ----------
    class CollisionSystem {
      constructor() {
        this.colliders = [];
      }

      addAABB(mesh, solid = true) {
        if (!solid) return;
        const box = new THREE.Box3().setFromObject(mesh);
        this.colliders.push({ mesh, box });
      }

      // Noclip-resistant resolve (player sphere vs AABBs)
      resolve(playerPos, radius = 0.8) {
        let { x, y, z } = playerPos;
        for (let i = 0; i < 4; i++) { // multi-pass
          for (const c of this.colliders) {
            const box = c.box;
            const closest = new THREE.Vector3(
              Math.max(box.min.x, Math.min(x, box.max.x)),
              Math.max(box.min.y, Math.min(y, box.max.y)),
              Math.max(box.min.z, Math.min(z, box.max.z))
            );
            const dist = playerPos.distanceTo(closest);
            if (dist < radius) {
              const push = new THREE.Vector3().subVectors(playerPos, closest).normalize();
              const overlap = radius - dist;
              x += push.x * overlap;
              y += push.y * overlap * 0.3; // less vertical push
              z += push.z * overlap;
            }
          }
        }
        return new THREE.Vector3(x, y, z);
      }
    }

    // ---------- 4. SUPER ENGINE ----------
    class SuperEngine {
      constructor() {
        this.scene = new THREE.Scene();
        this.scene.background = new THREE.Color(0x0a0a12);
        this.camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 2000);
        this.camera.position.set(0, 8, 25);

        this.renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
        this.renderer.setSize(window.innerWidth, window.innerHeight);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        this.renderer.shadowMap.enabled = true;
        document.body.appendChild(this.renderer.domElement);

        // Lights
        const amb = new THREE.AmbientLight(0x404060, 0.6);
        this.scene.add(amb);
        const dir = new THREE.DirectionalLight(0xffffff, 1.1);
        dir.position.set(15, 30, 10);
        dir.castShadow = true;
        this.scene.add(dir);

        this.collision = new CollisionSystem();
        this.shapes = [];
        this.clock = new THREE.Clock();
        this.player = { pos: new THREE.Vector3(0, 2, 18), vel: new THREE.Vector3() };

        this.buildWorld();
        this.setupControls();
        this.animate();
      }

      buildWorld() {
        // Ground
        const ground = new THREE.Mesh(
          new THREE.PlaneGeometry(200, 200),
          new THREE.MeshStandardMaterial({ color: 0x1a1a28, roughness: 0.9 })
        );
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        this.scene.add(ground);

        // Create all shapes from your scanned PDF at scaled sizes
        const sizes = [100, 200, 400, 800, 1000].map(s => getScaledSize(s / 100));

        // Sphere
        const sphere = createSphere(sizes[1] * 0.015, 0xff2244);
        sphere.position.set(-12, sizes[1] * 0.015, 0);
        this.addShape(sphere);

        // Cube
        const cube = createCube(sizes[2] * 0.012, 0x44ff88);
        cube.position.set(-6, sizes[2] * 0.006, 0);
        this.addShape(cube);

        // Rectangular Prism
        const prism = createRectPrism(sizes[3] * 0.01, sizes[2] * 0.008, sizes[1] * 0.015, 0x4488ff);
        prism.position.set(0, sizes[2] * 0.004, 0);
        this.addShape(prism);

        // Cylinder
        const cyl = createCylinder(sizes[1] * 0.01, sizes[3] * 0.012, 0xffaa22);
        cyl.position.set(6, sizes[3] * 0.006, 0);
        this.addShape(cyl);

        // Cone
        const cone = createCone(sizes[2] * 0.01, sizes[3] * 0.015, 0xcc44ff);
        cone.position.set(12, sizes[3] * 0.0075, 0);
        this.addShape(cone);

        // Triangular Pyramid
        const pyramid = createTriPyramid(sizes[2] * 0.014, 0xff6688);
        pyramid.position.set(0, sizes[2] * 0.01, -10);
        this.addShape(pyramid);

        // Grid helper for map feel
        const grid = new THREE.GridHelper(100, 50, 0x333355, 0x222233);
        this.scene.add(grid);
      }

      addShape(mesh) {
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        this.scene.add(mesh);
        this.shapes.push(mesh);
        this.collision.addAABB(mesh, true);
      }

      setupControls() {
        const keys = {};
        window.addEventListener("keydown", e => keys[e.code] = true);
        window.addEventListener("keyup", e => keys[e.code] = false);

        this.keys = keys;
        window.addEventListener("resize", () => {
          this.camera.aspect = window.innerWidth / window.innerHeight;
          this.camera.updateProjectionMatrix();
          this.renderer.setSize(window.innerWidth, window.innerHeight);
        });
      }

      update(dt) {
        // Simple WASD movement + noclip fix
        const speed = 12;
        const move = new THREE.Vector3();
        if (this.keys["KeyW"]) move.z -= 1;
        if (this.keys["KeyS"]) move.z += 1;
        if (this.keys["KeyA"]) move.x -= 1;
        if (this.keys["KeyD"]) move.x += 1;
        move.normalize().multiplyScalar(speed * dt);

        this.player.pos.add(move);
        // Noclip / glitch fix
        this.player.pos.copy(this.collision.resolve(this.player.pos, 1.2));

        // Camera follow
        this.camera.position.lerp(
          new THREE.Vector3(this.player.pos.x, this.player.pos.y + 6, this.player.pos.z + 14),
          0.08
        );
        this.camera.lookAt(this.player.pos);

        // Gentle rotation of shapes (math-driven look)
        this.shapes.forEach((s, i) => {
          s.rotation.y += dt * (0.2 + i * 0.05);
        });
      }

      animate() {
        requestAnimationFrame(() => this.animate());
        const dt = Math.min(this.clock.getDelta(), 0.05); // stable dt
        this.update(dt);
        this.renderer.render(this.scene, this.camera);
      }
    }

    // Start the Super Engine
    new SuperEngine();
  </script>
</body>
</html>