import * as THREE from "three";

/* ---------- Polygon Math (your table) ---------- */
export function getPolygonMath(sides: number) {
  const triangles = sides - 2;
  const angleSumDeg = triangles * 180;
  return {
    sides,
    triangles,
    angleSumDeg,
    interiorAngleDeg: angleSumDeg / sides,
  };
}

export function generatePolygonVertices(sides: number, radius = 1, rotation = 0): THREE.Vector2[] {
  const verts: THREE.Vector2[] = [];
  const step = (Math.PI * 2) / sides;
  for (let i = 0; i < sides; i++) {
    const a = i * step + rotation - Math.PI / 2;
    verts.push(new THREE.Vector2(Math.cos(a) * radius, Math.sin(a) * radius));
  }
  return verts;
}

/* ---------- Map-to-Picture Size Engine ---------- */
export class PictureSizeMapper {
  /** Map ratio (e.g. 1:25000 → 25000) */
  scaleFactor: number;

  constructor(mapRatio = 1 / 25000) {
    this.scaleFactor = mapRatio < 1 ? 1 / mapRatio : mapRatio;
  }

  /** Convert picture pixel size → world radius for a shape */
  pictureToWorldRadius(
    pictureWidth: number,
    pictureHeight: number,
    percent = 100,          // use %
    offset = 0              // use + or -
  ): number {
    // Use the longer side of the picture as reference
    const pixels = Math.max(pictureWidth, pictureHeight);
    const worldUnits = pixels / this.scaleFactor;
    return (worldUnits * (percent / 100)) + offset;
  }

  /** Convert world size back to picture pixels (useful for UV / texture) */
  worldToPicturePixels(worldSize: number, percent = 100, offset = 0): number {
    const adjusted = (worldSize - offset) / (percent / 100);
    return adjusted * this.scaleFactor;
  }

  /** Full transform helper */
  transform(value: number, percent = 100, offset = 0) {
    return value * (percent / 100) + offset;
  }
}

