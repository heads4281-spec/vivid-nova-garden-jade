    const mesh = new THREE.Mesh(geometry, material);
    mesh.rotation.x = -Math.PI / 2;
    mesh.position.y = y;
    mesh.userData = {
      id,
      sides,
      pictureWidth,
      pictureHeight,
      radius,
      percent,
      offset,
    };

    this.shapes.set(id, mesh);
    this.pictureSizes.set(id, { w: pictureWidth, h: pictureHeight });
    this.scene.add(mesh);
    return mesh;
  }

