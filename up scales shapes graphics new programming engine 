    mesh.geometry.dispose();
    mesh.geometry = new THREE.ShapeGeometry(shape);

    data.radius = newRadius;
    data.pictureWidth = w;
    data.pictureHeight = h;
    data.percent = p;
    data.offset = o;
  }

