<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recursive CCD – Remaining Time Resolution</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #111;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    font-family: monospace;
  }
  canvas { background: #000; display: block; }
  #ui {
    position: absolute;
    top: 12px; left: 12px;
    color: #0f0;
    font-size: 14px;
    line-height: 1.5;
    pointer-events: none;
  }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="ui"></div>

<script>
"use strict";

/* ===================== CONFIG ===================== */
const W = 900;
const H = 600;
const CELL_SIZE = 80;
const NUM_OBJECTS = 120;               // keep reasonable for recursion
const MAX_RECURSION_DEPTH = 8;         // safety limit
const SHOW_GRID = false;

// 0 = Discrete, 1 = Simple CCD (earliest only), 2 = Recursive CCD
let MODE = 2;

/* ===================== CANVAS ===================== */
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d", { alpha: false });
const ui = document.getElementById("ui");

let dpr = Math.min(devicePixelRatio || 1, 2);
function resize() {
  dpr = Math.min(devicePixelRatio || 1, 2);
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + "px";
  canvas.style.height = H + "px";
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
resize();
window.addEventListener("resize", resize);

/* ===================== SPATIAL GRID ===================== */
class SpatialGrid {
  constructor(width, height, cellSize) {
    this.cellSize = cellSize;
    this.cols = Math.ceil(width / cellSize);
    this.rows = Math.ceil(height / cellSize);
    this.cells = Array.from({length: this.cols * this.rows}, () => []);
  }

  clear() {
    for (const cell of this.cells) cell.length = 0;
  }

  insert(obj, dt) {
    // Swept bounds for the whole remaining time
    const minX = Math.min(obj.x, obj.x + obj.vx * dt);
    const maxX = Math.max(obj.x + obj.w, obj.x + obj.w + obj.vx * dt);
    const minY = Math.min(obj.y, obj.y + obj.vy * dt);
    const maxY = Math.max(obj.y + obj.h, obj.y + obj.h + obj.vy * dt);

    const cx1 = Math.max(0, Math.floor(minX / this.cellSize));
    const cx2 = Math.min(this.cols - 1, Math.floor(maxX / this.cellSize));
    const cy1 = Math.max(0, Math.floor(minY / this.cellSize));
    const cy2 = Math.min(this.rows - 1, Math.floor(maxY / this.cellSize));

    obj._cells = [];
    for (let cy = cy1; cy <= cy2; cy++) {
      for (let cx = cx1; cx <= cx2; cx++) {
        const idx = cy * this.cols + cx;
        this.cells[idx].push(obj);
        obj._cells.push(idx);
      }
    }
  }

  getCandidates(obj) {
    const set = new Set();
    for (const idx of obj._cells) {
      for (const other of this.cells[idx]) {
        if (other !== obj) set.add(other);
      }
    }
    return set;
  }
}

const grid = new SpatialGrid(W, H, CELL_SIZE);

/* ===================== SWEPT AABB ===================== */
function sweptAABB(a, b) {
  const dx = b.vx - a.vx;
  const dy = b.vy - a.vy;

  const xInvEntry = dx > 0 ? (b.x - (a.x + a.w)) : ((b.x + b.w) - a.x);
  const xInvExit  = dx > 0 ? ((b.x + b.w) - a.x) : (b.x - (a.x + a.w));
  const yInvEntry = dy > 0 ? (b.y - (a.y + a.h)) : ((b.y + b.h) - a.y);
  const yInvExit  = dy > 0 ? ((b.y + b.h) - a.y) : (b.y - (a.y + a.h));

  let xEntry, xExit, yEntry, yExit;

  if (dx === 0) { xEntry = -Infinity; xExit = Infinity; }
  else { xEntry = xInvEntry / dx; xExit = xInvExit / dx; }

  if (dy === 0) { yEntry = -Infinity; yExit = Infinity; }
  else { yEntry = yInvEntry / dy; yExit = yInvExit / dy; }

  const entryTime = Math.max(xEntry, yEntry);
  const exitTime  = Math.min(xExit, yExit);

  if (entryTime > exitTime || entryTime < 0 || entryTime > 1) return 1.0;
  return entryTime;
}

function aabbOverlap(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x &&
         a.y < b.y + b.h && a.y + a.h > b.y;
}

/* ===================== OBJECTS ===================== */
const objects = [];
for (let i = 0; i < NUM_OBJECTS; i++) {
  const w = 14 + Math.random() * 20;
  const h = 14 + Math.random() * 20;
  objects.push({
    x: 40 + Math.random() * (W - 80),
    y: 40 + Math.random() * (H - 80),
    w, h,
    vx: (Math.random() - 0.5) * 480,
    vy: (Math.random() - 0.5) * 480,
    color: `hsl(${Math.random() * 360}, 75%, 55%)`,
    colliding: false,
    _cells: []
  });
}

/* ===================== RECURSIVE CCD ===================== */
function resolveCollisions(dt, depth = 0) {
  if (dt <= 0.00001 || depth >= MAX_RECURSION_DEPTH) {
    // Final remaining movement
    for (const obj of objects) {
      obj.x += obj.vx * dt;
      obj.y += obj.vy * dt;
    }
    return;
  }

  // Broad-phase
  grid.clear();
  for (const obj of objects) {
    obj.colliding = false;
    grid.insert(obj, dt);
  }

  // Find earliest collision
  let earliest = 1.0;
  let colA = null, colB = null;

  for (const a of objects) {
    const candidates = grid.getCandidates(a);
    for (const b of candidates) {
      if (a >= b) continue;

      let toi;
      if (MODE === 0) {
        // Discrete
        toi = aabbOverlap(a, b) ? 0 : 1;
      } else {
        // Continuous
        toi = sweptAABB(a, b);
      }

      if (toi < earliest) {
        earliest = toi;
        colA = a;
        colB = b;
      }
    }
  }

  // Advance everyone to the time of impact
  const moveTime = earliest * dt;
  for (const obj of objects) {
    obj.x += obj.vx * moveTime;
    obj.y += obj.vy * moveTime;
  }

  // Resolve collision if one occurred
  if (earliest < 1.0 && colA && colB) {
    colA.colliding = true;
    colB.colliding = true;

    // Determine collision axis (simple but effective)
    const overlapX = Math.min(colA.x + colA.w, colB.x + colB.w) - Math.max(colA.x, colB.x);
    const overlapY = Math.min(colA.y + colA.h, colB.y + colB.h) - Math.max(colA.y, colB.y);

    if (overlapX < overlapY) {
      // X collision – swap X velocities
      const tmp = colA.vx;
      colA.vx = colB.vx;
      colB.vx = tmp;
    } else {
      // Y collision – swap Y velocities
      const tmp = colA.vy;
      colA.vy = colB.vy;
      colB.vy = tmp;
    }

    // Tiny separation to avoid sticking
    const push = 0.4;
    if (overlapX < overlapY) {
      if (colA.x < colB.x) { colA.x -= push; colB.x += push; }
      else                 { colA.x += push; colB.x -= push; }
    } else {
      if (colA.y < colB.y) { colA.y -= push; colB.y += push; }
      else                 { colA.y += push; colB.y -= push; }
    }
  }

  // Recurse on remaining time (this is the key part)
  const remaining = dt * (1 - earliest);
  if (MODE === 2 && remaining > 0.00001) {
    resolveCollisions(remaining, depth + 1);
  } else {
    // Simple CCD or discrete – just finish the rest
    for (const obj of objects) {
      obj.x += obj.vx * remaining;
      obj.y += obj.vy * remaining;
    }
  }
}

/* ===================== WALLS (also continuous) ===================== */
function resolveWalls() {
  for (const obj of objects) {
    if (obj.x < 0)            { obj.x = 0;            obj.vx =  Math.abs(obj.vx); }
    if (obj.x + obj.w > W)    { obj.x = W - obj.w;    obj.vx = -Math.abs(obj.vx); }
    if (obj.y < 0)            { obj.y = 0;            obj.vy =  Math.abs(obj.vy); }
    if (obj.y + obj.h > H)    { obj.y = H - obj.h;    obj.vy = -Math.abs(obj.vy); }
  }
}

/* ===================== MAIN LOOP ===================== */
let last = performance.now();
let frames = 0, fpsTime = 0, fps = 0;

function loop(now) {
  const dt = Math.min((now - last) / 1000, 0.033);
  last = now;

  resolveCollisions(dt);
  resolveWalls();

  // Render
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, W, H);

  for (const obj of objects) {
    ctx.fillStyle = obj.colliding ? "#ff2244" : obj.color;
    ctx.fillRect(obj.x, obj.y, obj.w, obj.h);
  }

  // Stats
  frames++;
  fpsTime += dt;
  if (fpsTime >= 0.4) {
    fps = Math.round(frames / fpsTime);
    frames = 0; fpsTime = 0;

    const modeName = ["Discrete", "Simple CCD", "Recursive CCD"][MODE];
    ui.innerHTML =
      `Objects: ${NUM_OBJECTS}<br>` +
      `Mode: <b>${modeName}</b><br>` +
      `Max recursion depth: ${MAX_RECURSION_DEPTH}<br>` +
      `FPS: ${fps}<br><br>` +
      `Keys:<br>` +
      `1 = Discrete<br>` +
      `2 = Simple CCD<br>` +
      `3 = Recursive CCD`;
  }

  requestAnimationFrame(loop);
}

// Mode switching
window.addEventListener("keydown", e => {
  if (e.code === "Digit1") MODE = 0;
  if (e.code === "Digit2") MODE = 1;
  if (e.code === "Digit3") MODE = 2;
});

requestAnimationFrame(loop);
</script>
</body>
</html>