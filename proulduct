def load_safetensors(path: str) -> dict:
    """Load a .safetensors file into a dictionary of tensors (CPU)."""
    tensors = {}
    with safe_open(path, framework="pt", device="cpu") as f:
        for key in f.keys():
            tensors[key] = f.get_tensor(key)
    return tensors


class WanS2V:
    """
    High-performance Audio-driven Video Generation pipeline.
    Supports pose conditioning, TTS, motion continuity across clips,
    sequence parallelism and FSDP.
    """

    def __init__(
        self,
        config,
        checkpoint_dir: str,
        device_id: int = 0,
        rank: int = 0,
        t5_fsdp: bool = False,
        dit_fsdp: bool = False,
        use_sp: bool = False,
        t5_cpu: bool = False,
        init_on_cpu: bool = True,
        convert_model_dtype: bool = False,
    ):
        self.device = torch.device(f"cuda:{device_id}")
        self.config = config
        self.rank = rank
        self.t5_cpu = t5_cpu
        self.init_on_cpu = init_on_cpu

        self.num_train_timesteps = config.num_train_timesteps
        self.param_dtype = config.param_dtype
        self.sample_neg_prompt = config.sample_neg_prompt
        self.motion_frames = config.transformer.motion_frames
        self.drop_first_motion = config.drop_first_motion
        self.fps = config.sample_fps
        self.audio_sample_m = 0

        if t5_fsdp or dit_fsdp or use_sp:
            self.init_on_cpu = False

        shard_fn = partial(shard_model, device_id=device_id)

        # ------------------------------------------------------------------ #
        # Text Encoder
        # ------------------------------------------------------------------ #
        self.text_encoder = T5EncoderModel(
            text_len=config.text_len,
            dtype=config.t5_dtype,
            device=torch.device("cpu"),
            checkpoint_path=os.path.join(checkpoint_dir, config.t5_checkpoint),
            tokenizer_path=os.path.join(checkpoint_dir, config.t5_tokenizer),
            shard_fn=shard_fn if t5_fsdp else None,
        )

        # ------------------------------------------------------------------ #
        # VAE
        # ------------------------------------------------------------------ #
        self.vae = Wan2_1_VAE(
            vae_pth=os.path.join(checkpoint_dir, config.vae_checkpoint),
            device=self.device,
        )

        # ------------------------------------------------------------------ #
        # Main DiT Model
        # ------------------------------------------------------------------ #
        logger.info(f"Loading WanModel_S2V from {checkpoint_dir}")
        if not dit_fsdp:
            self.noise_model = WanModel_S2V.from_pretrained(
                checkpoint_dir,
                torch_dtype=self.param_dtype,
                device_map=self.device,
            )
        else:
            self.noise_model = WanModel_S2V.from_pretrained(
                checkpoint_dir, torch_dtype=self.param_dtype
            )

        self.noise_model = self._configure_model(
            model=self.noise_model,
            use_sp=use_sp,
            dit_fsdp=dit_fsdp,
            shard_fn=shard_fn,
            convert_model_dtype=convert_model_dtype,
        )

        # ------------------------------------------------------------------ #
        # Audio Encoder
        # ------------------------------------------------------------------ #
        self.audio_encoder = AudioEncoder(
            model_id=os.path.join(checkpoint_dir, "wav2vec2-large-xlsr-53-english")
        )

        self.sp_size = get_world_size() if use_sp else 1

    def _configure_model(
        self,
        model: torch.nn.Module,
        use_sp: bool,
        dit_fsdp: bool,
        shard_fn,
        convert_model_dtype: bool,
    ) -> torch.nn.Module:
        model.eval().requires_grad_(False)

        if use_sp:
            for block in model.blocks:
                block.self_attn.forward = types.MethodType(
                    sp_attn_forward_s2v, block.self_attn
                )
            model.use_context_parallel = True

        if dist.is_initialized():
            dist.barrier()

        if dit_fsdp:
            model = shard_fn(model)
        else:
            if convert_model_dtype:
                model.to(self.param_dtype)
            if not self.init_on_cpu:
                model.to(self.device)

        return model

    # ------------------------------------------------------------------ #
    # Utility helpers
    # ------------------------------------------------------------------ #
    def get_size_less_than_area(
        self,
        height: int,
        width: int,
        target_area: int = 1024 * 704,
        divisor: int = 64,
    ) -> Tuple[int, int]:
        """Return the largest resolution ≤ target_area that is divisible by `divisor`."""
        if height * width <= target_area:
            max_upper_area = target_area
            min_scale = 0.1
            max_scale = 1.0
        else:
            max_upper_area = target_area
            d = divisor - 1
            b = d * (height + width)
            a = height * width
            c = d**2 - max_upper_area
            min_scale = (-b + math.sqrt(b**2 - 2 * a * c)) / (2 * a)
            max_scale = math.sqrt(max_upper_area / (height * width))

        for i in range(100):
            scale = max_scale - (max_scale - min_scale) * i / 100
            new_h = int(height * scale)
            new_w = int(width * scale)

            pad_h = (divisor - new_h % divisor) % divisor
            pad_w = (divisor - new_w % divisor) % divisor
            padded_h = new_h + pad_h
            padded_w = new_w + pad_w

            if padded_h * padded_w <= max_upper_area:
                return padded_h, padded_w

        # Fallback
        aspect = width / height
        target_w = int((target_area * aspect) ** 0.5 // divisor * divisor)
        target_h = int((target_area / aspect) ** 0.5 // divisor * divisor)

        if target_w >= width or target_h >= height:
            target_w = int(width // divisor * divisor)
            target_h = int(height // divisor * divisor)

        return target_h, target_w

    def prepare_default_cond_input(
        self,
        map_shape: List[int] = [3, 12, 64, 64],
        motion_frames: int = 5,
        lat_motion_frames: int = 2,
        enable_mano: bool = False,
        enable_kp: bool = False,
        enable_pose: bool = False,
    ) -> Optional[torch.Tensor]:
        default_value = [1.0, -1.0, -1.0]
        cond_enable = [enable_mano, enable_kp, enable_pose]
        conds = []

        for d, enabled in zip(default_value, cond_enable):
            if not enabled:
                continue
            map_value = torch.ones(map_shape, dtype=self.param_dtype, device=self.device) * d
            cond_lat = torch.cat(
                [map_value[:, :, 0:1].repeat(1, 1, motion_frames, 1, 1), map_value],
                dim=2,
            )
            cond_lat = torch.stack(
                self.vae.encode(cond_lat.to(self.param_dtype))
            )[:, :, lat_motion_frames:].to(self.param_dtype)
            conds.append(cond_lat)

        return torch.cat(conds, dim=1) if conds else None

    def encode_audio(
        self, audio_path: str, infer_frames: int
    ) -> Tuple[torch.Tensor, int]:
        z = self.audio_encoder.extract_audio_feat(audio_path, return_all_layers=True)
        audio_embed, num_repeat = self.audio_encoder.get_audio_embed_bucket_fps(
            z, fps=self.fps, batch_frames=infer_frames, m=self.audio_sample_m
        )
        audio_embed = audio_embed.to(self.device, self.param_dtype).unsqueeze(0)

        if audio_embed.ndim == 3:
            audio_embed = audio_embed.permute(0, 2, 1)
        elif audio_embed.ndim == 4:
            audio_embed = audio_embed.permute(0, 2, 3, 1)

        return audio_embed, num_repeat

    def read_last_n_frames(
        self,
        video_path: str,
        n_frames: int,
        target_fps: int = 16,
        reverse: bool = False,
    ) -> np.ndarray:
        """Read last (or first) `n_frames` from a video at target FPS."""
        vr = VideoReader(video_path)
        original_fps = vr.get_avg_fps()
        total_frames = len(vr)
        interval = max(1, round(original_fps / target_fps))
        required_span = (n_frames - 1) * interval

        start = 0 if reverse else max(0, total_frames - required_span - 1)
        indices = []
        for i in range(n_frames):
            idx = start + i * interval
            if idx >= total_frames:
                break
            indices.append(idx)

        return vr.get_batch(indices).asnumpy()

    def load_pose_cond(
        self,
        pose_video: Optional[str],
        num_repeat: int,
        infer_frames: int,
        size: Tuple[int, int],
    ) -> List[torch.Tensor]:
        HEIGHT, WIDTH = size

        if pose_video is not None:
            pose_seq = self.read_last_n_frames(
                pose_video,
                n_frames=infer_frames * num_repeat,
                target_fps=self.fps,
                reverse=True,
            )

            resize = transforms.Resize(min(HEIGHT, WIDTH))
            crop = transforms.CenterCrop((HEIGHT, WIDTH))

            cond = torch.from_numpy(pose_seq).permute(0, 3, 1, 2).float() / 255.0 * 2 - 1.0
            cond = crop(resize(cond)).permute(1, 0, 2, 3).unsqueeze(0)

            pad = num_repeat * infer_frames - cond.shape[2]
            if pad > 0:
                cond = torch.cat(
                    [cond, -torch.ones(1, 3, pad, HEIGHT, WIDTH)], dim=2
                )

            cond_tensors = torch.chunk(cond, num_repeat, dim=2)
        else:
            cond_tensors = [-torch.ones(1, 3, infer_frames, HEIGHT, WIDTH)]

        result = []
        for c in cond_tensors:
            c = torch.cat([c[:, :, 0:1], c], dim=2)  # prepend first frame
            lat = torch.stack(
                self.vae.encode(c.to(dtype=self.param_dtype, device=self.device))
            )[:, :, 1:].cpu()  # keep on CPU to save VRAM
            result.append(lat)
        return result

    def get_gen_size(
        self,
        size: Optional[Tuple[int, int]],
        max_area: int,
        ref_image_path: str,
        pre_video_path: Optional[str] = None,
    ) -> Tuple[int, int]:
        if size is not None:
            return size

        if pre_video_path:
            ref = self.read_last_n_frames(pre_video_path, n_frames=1)[0]
        else:
            ref = np.array(Image.open(ref_image_path).convert("RGB"))

        h, w = ref.shape[:2]
        return self.get_size_less_than_area(h, w, target_area=max_area)

    # ------------------------------------------------------------------ #
    # Main generation
    # ------------------------------------------------------------------ #
    @torch.inference_mode()
    def generate(
        self,
        input_prompt: str,
        ref_image_path: str,
        audio_path: str,
        enable_tts: bool = False,
        tts_prompt_audio: Optional[str] = None,
        tts_prompt_text: Optional[str] = None,
        tts_text: Optional[str] = None,
        num_repeat: Optional[int] = 1,
        pose_video: Optional[str] = None,
        max_area: int = 720 * 1280,
        infer_frames: int = 80,
        shift: float = 5.0,
        sample_solver: str = "unipc",
        sampling_steps: int = 40,
        guide_scale: float = 5.0,
        n_prompt: str = "",
        seed: int = -1,
        offload_model: bool = True,
        init_first_frame: bool = False,
    ) -> Optional[torch.Tensor]:
        """
        Generate audio-driven video clips with optional pose conditioning and TTS.

        Returns:
            (C, T, H, W) tensor on rank 0, else None.
        """
        # ------------------------------------------------------------------ #
        # 1. Resolution & reference image
        # ------------------------------------------------------------------ #
        HEIGHT, WIDTH = self.get_gen_size(
            size=None,
            max_area=max_area,
            ref_image_path=ref_image_path,
            pre_video_path=None,
        )

        resize = transforms.Resize(min(HEIGHT, WIDTH))
        crop = transforms.CenterCrop((HEIGHT, WIDTH))
        to_tensor = transforms.ToTensor()

        ref_image = np.array(Image.open(ref_image_path).convert("RGB"))
        model_pic = crop(resize(Image.fromarray(ref_image)))
        ref_pixel = to_tensor(model_pic).unsqueeze(1).unsqueeze(0) * 2 - 1.0
        ref_pixel = ref_pixel.to(dtype=self.vae.dtype, device=self.vae.device)
        ref_latents = torch.stack(self.vae.encode(ref_pixel))

        # ------------------------------------------------------------------ #
        # 2. Audio embedding
        # ------------------------------------------------------------------ #
        if enable_tts:
            audio_path = self.tts(tts_prompt_audio, tts_prompt_text, tts_text)

        audio_emb, nr = self.encode_audio(audio_path, infer_frames=infer_frames)
        if num_repeat is None or num_repeat > nr:
            num_repeat = nr

        # ------------------------------------------------------------------ #
        # 3. Motion latents (for continuity across clips)
        # ------------------------------------------------------------------ #
        motion_latents = torch.zeros(
            1, 3, self.motion_frames, HEIGHT, WIDTH,
            dtype=self.param_dtype, device=self.device
        )
        videos_last_frames = motion_latents.detach()

        drop_first_motion = self.drop_first_motion
        if init_first_frame:
            drop_first_motion = False
            motion_latents[:, :, -6:] = ref_pixel
        motion_latents = torch.stack(self.vae.encode(motion_latents))

        lat_motion_frames = (self.motion_frames + 3) // 4

        # ------------------------------------------------------------------ #
        # 4. Pose conditioning
        # ------------------------------------------------------------------ #
        COND = self.load_pose_cond(
            pose_video=pose_video,
            num_repeat=num_repeat,
            infer_frames=infer_frames,
            size=(HEIGHT, WIDTH),
        )

        # ------------------------------------------------------------------ #
        # 5. Text encoding
        # ------------------------------------------------------------------ #
        if not n_prompt:
            n_prompt = self.sample_neg_prompt

        if not self.t5_cpu:
            self.text_encoder.model.to(self.device)
            context = self.text_encoder([input_prompt], self.device)
            context_null = self.text_encoder([n_prompt], self.device)
            if offload_model:
                self.text_encoder.model.cpu()
        else:
            context = self.text_encoder([input_prompt], torch.device("cpu"))
            context_null = self.text_encoder([n_prompt], torch.device("cpu"))
            context = [t.to(self.device) for t in context]
            context_null = [t.to(self.device) for t in context_null]

        # ------------------------------------------------------------------ #
        # 6. Clip-by-clip generation
        # ------------------------------------------------------------------ #
        seed = seed if seed >= 0 else random.randint(0, sys.maxsize)
        out = []

        with torch.amp.autocast("cuda", dtype=self.param_dtype):
            for r in range(num_repeat):
                generator = torch.Generator(device=self.device).manual_seed(seed + r)

                lat_target_frames = (infer_frames + 3 + self.motion_frames) // 4 - lat_motion_frames
                target_shape = [lat_target_frames, HEIGHT // 8, WIDTH // 8]
                max_seq_len = np.prod(target_shape) // 4

                noise = [
                    torch.randn(
                        16, *target_shape,
                        dtype=self.param_dtype,
                        device=self.device,
                        generator=generator,
                    )
                ]
                latents = deepcopy(noise)

                # Scheduler
                if sample_solver == "unipc":
                    scheduler = FlowUniPCMultistepScheduler(
                        num_train_timesteps=self.num_train_timesteps,
                        shift=1,
                        use_dynamic_shifting=False,
                    )
                    scheduler.set_timesteps(sampling_steps, device=self.device, shift=shift)
                    timesteps = scheduler.timesteps
                elif sample_solver == "dpm++":
                    scheduler = FlowDPMSolverMultistepScheduler(
                        num_train_timesteps=self.num_train_timesteps,
                        shift=1,
                        use_dynamic_shifting=False,
                    )
                    sigmas = get_sampling_sigmas(sampling_steps, shift)
                    timesteps, _ = retrieve_timesteps(scheduler, device=self.device, sigmas=sigmas)
                else:
                    raise NotImplementedError(f"Unsupported solver: {sample_solver}")

                # Conditioning for this clip
                left, right = r * infer_frames, (r + 1) * infer_frames
                cond_latents = (COND[r] if pose_video else COND[0] * 0).to(
                    dtype=self.param_dtype, device=self.device
                )
                audio_input = audio_emb[..., left:right]
                input_motion = motion_latents.clone()

                arg_c = {
                    "context": context[0:1],
                    "seq_len": max_seq_len,
                    "cond_states": cond_latents,
                    "motion_latents": input_motion,
                    "ref_latents": ref_latents,
                    "audio_input": audio_input,
                    "motion_frames": [self.motion_frames, lat_motion_frames],
                    "drop_motion_frames": drop_first_motion and r == 0,
                }

                arg_null = None
                if guide_scale > 1:
                    arg_null = {
                        **arg_c,
                        "context": context_null[0:1],
                        "audio_input": 0.0 * audio_input,
                    }

                # Move model to GPU if needed
                if offload_model or self.init_on_cpu:
                    self.noise_model.to(self.device)
                    torch.cuda.empty_cache()

                # Denoising loop
                for t in tqdm(timesteps, desc=f"Clip {r+1}/{num_repeat}", disable=self.rank != 0):
                    latent_input = latents[0:1]
                    timestep = torch.stack([t]).to(self.device)

                    noise_pred_cond = self.noise_model(latent_input, t=timestep, **arg_c)

                    if guide_scale > 1:
                        noise_pred_uncond = self.noise_model(latent_input, t=timestep, **arg_null)
                        noise_pred = [
                            u + guide_scale * (c - u)
                            for c, u in zip(noise_pred_cond, noise_pred_uncond)
                        ]
                    else:
                        noise_pred = noise_pred_cond

                    latents[0] = scheduler.step(
                        noise_pred[0].unsqueeze(0),
                        t,
                        latents[0].unsqueeze(0),
                        return_dict=False,
                        generator=generator,
                    )[0].squeeze(0)

                # Offload after each clip
                if offload_model:
                    self.noise_model.cpu()
                    torch.cuda.synchronize()
                    torch.cuda.empty_cache()

                # Decode
                latents = torch.stack(latents)
                if not (drop_first_motion and r == 0):
                    decode_latents = torch.cat([motion_latents, latents], dim=2)
                else:
                    decode_latents = torch.cat([ref_latents, latents], dim=2)

                image = torch.stack(self.vae.decode(decode_latents))
                image = image[:, :, -infer_frames:]
                if drop_first_motion and r == 0:
                    image = image[:, :, 3:]

                # Update motion buffer for next clip
                overlap = min(self.motion_frames, image.shape[2])
                videos_last_frames = torch.cat(
                    [
                        videos_last_frames[:, :, overlap:],
                        image[:, :, -overlap:],
                    ],
                    dim=2,
                ).to(dtype=motion_latents.dtype, device=motion_latents.device)

                motion_latents = torch.stack(self.vae.encode(videos_last_frames))
                out.append(image.cpu())

        # ------------------------------------------------------------------ #
        # Final assembly & cleanup
        # ------------------------------------------------------------------ #
        videos = torch.cat(out, dim=2)

        del noise, latents, scheduler
        if offload_model:
            gc.collect()
            torch.cuda.synchronize()

        if dist.is_initialized():
            dist.barrier()

        return videos[0] if self.rank == 0 else None

    # ------------------------------------------------------------------ #
    # TTS helpers
    # ------------------------------------------------------------------ #
    def tts(
        self,
        tts_prompt_audio: str,
        tts_prompt_text: Optional[str],
        tts_text: str,
    ) -> str:
        if not hasattr(self, "cosyvoice"):
            self.load_tts()

        from cosyvoice.utils.file_utils import load_wav
        import torchaudio

        prompt_speech = load_wav(tts_prompt_audio, 16000)
        speech_list = []

        if tts_prompt_text is not None:
            for item in self.cosyvoice.inference_zero_shot(
                tts_text, tts_prompt_text, prompt_speech
            ):
                speech_list.append(item["tts_speech"])
        else:
            for item in self.cosyvoice.inference_cross_lingual(tts_text, prompt_speech):
                speech_list.append(item["tts_speech"])

        torchaudio.save(
            "tts.wav",
            torch.cat(speech_list, dim=1),
            self.cosyvoice.sample_rate,
        )
        return "tts.wav"

    def load_tts(self):
        if not os.path.exists("CosyVoice"):
            from wan.utils.utils import download_cosyvoice_repo
            download_cosyvoice_repo("CosyVoice")

        if not os.path.exists("CosyVoice2-0.5B"):
            from wan.utils.utils import download_cosyvoice_model
            download_cosyvoice_model("CosyVoice2-0.5B", "CosyVoice2-0.5B")

        sys.path.append("CosyVoice")
        sys.path.append("CosyVoice/third_party/Matcha-TTS")

        from cosyvoice.cli.cosyvoice import CosyVoice2
        self.cosyvoice = CosyVoice2("CosyVoice2-0.5B")