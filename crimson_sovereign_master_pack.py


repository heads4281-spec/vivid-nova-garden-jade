def _run_generation(
    name: str,
    image_path: str,
    prompt: str,
    negative: str,
    output_path: str,
    ckpt_dir: str,
    quality: str = "ultra",
    seed: int = 42,
):
    from wan.configs import WAN_CONFIGS, MAX_AREA_CONFIGS

    if not os.path.isfile(image_path):
        print(f"❌ Image not found: {image_path}")
        return None

    img = Image.open(image_path).convert("RGB")
    print(f"\n▶ {name}")
    print(f"  Image: {image_path} → {img.size}")

    cfg = WAN_CONFIGS["i2v-A14B"]
    area = MAX_AREA_CONFIGS.get("1280*720", 1280 * 720)

    presets = {
        "game":      dict(steps=40, guide=6.5, frames=81),
        "ultra":     dict(steps=50, guide=7.5, frames=97),
        "cinematic": dict(steps=60, guide=8.0, frames=121),
    }
    p = presets.get(quality, presets["ultra"])

    pipeline = WanI2V(
        config=cfg,
        checkpoint_dir=ckpt_dir,
        t5_cpu=True,
        init_on_cpu=True,
        convert_model_dtype=True,
    )

    start = time.time()
    video = pipeline.generate(
        input_prompt=prompt,
        img=img,
        max_area=area,
        frame_num=p["frames"],
        sampling_steps=p["steps"],
        guide_scale=p["guide"],
        n_prompt=negative,
        seed=seed,
        offload_model=True,
        progress_desc=name,
    )

    if video is not None:
        os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
        save_video(
            tensor=video[None],
            save_file=output_path,
            fps=cfg.sample_fps,
            nrow=1,
            normalize=True,
            value_range=(-1, 1),
        )
        print(f"✓ Saved → {output_path} ({time.time()-start:.1f}s)")
        return output_path

    print("❌ Generation failed")
    return None


