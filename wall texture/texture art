      if (f[y][x] === 0) {
        f[y][x] = currentFloor < 2 ? 2 : 3;
        document.getElementById('msg').textContent = 'Super Stairs added';
        return;
      }
    }
  }
}

function frame() {
  let dx = 0, dy = 0;
  if (keys['w'] || keys['arrowup'])    { dx += Math.cos(pa); dy += Math.sin(pa); }
  if (keys['s'] || keys['arrowdown'])  { dx -= Math.cos(pa); dy -= Math.sin(pa); }
  if (keys['a'] || keys['arrowleft'])  { dx += Math.cos(pa - Math.PI/2); dy += Math.sin(pa - Math.PI/2); }
  if (keys['d'] || keys['arrowright']) { dx += Math.cos(pa + Math.PI/2); dy += Math.sin(pa + Math.PI/2); }
  if (keys[' ']) pHeight = Math.min(52, pHeight + 5);

  const len = Math.hypot(dx, dy) || 1;
  dx = (dx / len) * moveSpeed;
  dy = (dy / len) * moveSpeed;

  const radius = getCollisionRadius();
  if (canMoveContinuous(px, py, dx, 0, radius)) px += dx;
  if (canMoveContinuous(px, py, 0, dy, radius)) py += dy;

  applyShapePush();
  handleStairsAndUpgrade();
  pHeight *= 0.87;
  floorTransition *= 0.88;

  // Background
  ctx.fillStyle = currentFloor === 2 ? '#0e0a14' : currentFloor === 1 ? '#0a0c14' : '#08080e';
  ctx.fillRect(0, 0, W, H/2 + pHeight*0.3 + floorTransition*0.35);
  ctx.fillStyle = currentFloor === 2 ? '#1a1422' : '#14141c';
  ctx.fillRect(0, H/2 + pHeight*0.3 + floorTransition*0.35, W, H);

  const FOV = Math.PI / 2.85;
  const numRays = W;
  const maxDist = 20 * TILE;
  const onStairs = floors[currentFloor][Math.floor(py/TILE)]?.[Math.floor(px/TILE)] === 2 ||
                   floors[currentFloor][Math.floor(py/TILE)]?.[Math.floor(px/TILE)] === 3;

  for (let r = 0; r < numRays; r++) {
    const rayAngle = pa - FOV/2 + (r / numRays) * FOV;
    let dist = 0, hit = false, hitSide = 0, texX = 0;
    const cosA = Math.cos(rayAngle), sinA = Math.sin(rayAngle);

    while (!hit && dist < maxDist) {
      dist += 1.55;
      const rx = px + cosA * dist;
      const ry = py + sinA * dist;
      const mx = Math.floor(rx / TILE);
      const my = Math.floor(ry / TILE);
      if (mx < 0 || my < 0 || mx >= mapW || my >= mapH || floors[currentFloor][my][mx] === 1) {
        hit = true;
        const prevX = Math.floor((px + cosA * (dist - 1.55)) / TILE);
        hitSide = prevX !== mx ? 0 : 1;
        texX = hitSide === 0 ? (ry % TILE) : (rx % TILE);
        if ((hitSide === 0 && cosA < 0) || (hitSide === 1 && sinA > 0)) texX = TILE - texX;
      }
    }

    dist *= Math.cos(rayAngle - pa);
    const wallH = Math.min(H * 1.55, (TILE * 1.1 * H) / dist);
    const wallTop = (H - wallH) / 2 - pHeight * 0.5 - floorTransition * 0.45;
    const shade = Math.max(0.08, Math.min(1, (1 - dist / maxDist) * lightMul * (1 - currentFloor * 0.05)));

    const tex = onStairs ? textures.stairs[graphicsPack] : textures.wall[graphicsPack];
    const sx = Math.floor((texX / TILE) * texSize) % texSize;
    ctx.drawImage(tex, sx, 0, 1, texSize, r, wallTop, 1, wallH);

    ctx.fillStyle = `rgba(0,0,0,${1 - shade})`;
    ctx.fillRect(r, wallTop, 1, wallH);
  }

  // Crosshair
  ctx.strokeStyle = 'rgba(255,255,255,0.45)';
  ctx.beginPath();
  ctx.moveTo(W/2 - 8, H/2); ctx.lineTo(W/2 + 8, H/2);
  ctx.moveTo(W/2, H/2 - 8); ctx.lineTo(W/2, H/2 + 8);
  ctx.stroke();

  requestAnimationFrame(frame);
}
frame();

onresize = () => {
  W = canvas.width = innerWidth;
  H = canvas.height = innerHeight;
};
</script>
</body>
