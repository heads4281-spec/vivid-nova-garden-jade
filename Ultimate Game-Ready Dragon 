)
from .utils.fm_solvers_unipc import FlowUniPCMultistepScheduler
from .utils.utils import save_video

logger = logging.getLogger(__name__)


class WanI2V:
    """Production I2V engine tuned for CRIMSON SOVEREIGN cutscenes."""

    def __init__(
        self,
        config,
        checkpoint_dir: str,
        device_id: int = 0,
        rank: int = 0,
        t5_fsdp: bool = False,
        dit_fsdp: bool = False,
        use_sp: bool = False,
        t5_cpu: bool = True,               # default True → saves VRAM for game dev machines
        init_on_cpu: bool = True,
        convert_model_dtype: bool = True,
    ):
        self.device = torch.device(f"cuda:{device_id}")
        self.config = config
        self.rank = rank
        self.t5_cpu = t5_cpu
        self.init_on_cpu = init_on_cpu
        self.num_train_timesteps = config.num_train_timesteps
        self.boundary = config.boundary
        self.param_dtype = config.param_dtype
        self.vae_stride = config.vae_stride
        self.patch_size = config.patch_size
        self.sample_neg_prompt = config.sample_neg_prompt

        if t5_fsdp or dit_fsdp or use_sp:
            self.init_on_cpu = False

        shard_fn = partial(shard_model, device_id=device_id)

        self.text_encoder = T5EncoderModel(
            text_len=config.text_len,
            dtype=config.t5_dtype,
            device=torch.device("cpu"),
            checkpoint_path=os.path.join(checkpoint_dir, config.t5_checkpoint),
            tokenizer_path=os.path.join(checkpoint_dir, config.t5_tokenizer),
            shard_fn=shard_fn if t5_fsdp else None,
        )

        self.vae = Wan2_1_VAE(
            vae_pth=os.path.join(checkpoint_dir, config.vae_checkpoint),
            device=self.device,
        )

        logger.info("Loading dual WanModels for Crimson Sovereign quality...")
        self.low_noise_model = self._load_and_configure(
            checkpoint_dir, config.low_noise_checkpoint, use_sp, dit_fsdp, shard_fn, convert_model_dtype
        )
        self.high_noise_model = self._load_and_configure(
            checkpoint_dir, config.high_noise_checkpoint, use_sp, dit_fsdp, shard_fn, convert_model_dtype
        )
        self.sp_size = get_world_size() if use_sp else 1

    def _load_and_configure(self, checkpoint_dir, subfolder, use_sp, dit_fsdp, shard_fn, convert_model_dtype):
        model = WanModel.from_pretrained(checkpoint_dir, subfolder=subfolder)
        return self._configure_model(model, use_sp, dit_fsdp, shard_fn, convert_model_dtype)

    def _configure_model(self, model, use_sp, dit_fsdp, shard_fn, convert_model_dtype):
        model.eval().requires_grad_(False)
        if use_sp:
            for block in model.blocks:
                block.self_attn.forward = types.MethodType(sp_attn_forward, block.self_attn)
            model.forward = types.MethodType(sp_dit_forward, model)
        if dist.is_initialized():
            dist.barrier()
        if dit_fsdp:
            model = shard_fn(model)
        else:
            if convert_model_dtype:
                model.to(self.param_dtype)
            if not self.init_on_cpu:
                model.to(self.device)
        return model

    def _prepare_model_for_timestep(self, t, boundary, offload_model):
        use_high = t.item() >= boundary
        active = self.high_noise_model if use_high else self.low_noise_model
        inactive = self.low_noise_model if use_high else self.high_noise_model
        if offload_model or self.init_on_cpu:
            if next(inactive.parameters()).device.type == "cuda":
                inactive.to("cpu")
            if next(active.parameters()).device.type == "cpu":
                active.to(self.device)
        return active

    @torch.inference_mode()
    def generate(
        self,
        input_prompt: str,
        img: Image.Image,
        max_area: int = 1280 * 720,          # native game resolution
        frame_num: int = 81,                 # ~3.2s @ 25fps — perfect cutscene length
        shift: float = 5.0,
        sample_solver: str = "unipc",
        sampling_steps: int = 50,            # ↑ higher quality
        guide_scale: Union[float, Tuple[float, float]] = (7.0, 7.5),  # stronger cinematic control
        n_prompt: str = "",
        seed: int = 42,
        offload_model: bool = True,
    ) -> Optional[torch.Tensor]:
        if isinstance(guide_scale, (int, float)):
            guide_scale = (float(guide_scale), float(guide_scale))

        img = TF.to_tensor(img).sub_(0.5).div_(0.5).to(self.device)
        h, w = img.shape[1:]
        aspect_ratio = h / w

        lat_h = round(np.sqrt(max_area * aspect_ratio) // self.vae_stride[1] // self.patch_size[1] * self.patch_size[1])
        lat_w = round(np.sqrt(max_area / aspect_ratio) // self.vae_stride[2] // self.patch_size[2] * self.patch_size[2])
        h = lat_h * self.vae_stride[1]
        w = lat_w * self.vae_stride[2]

        max_seq_len = ((frame_num - 1) // self.vae_stride[0] + 1) * lat_h * lat_w // (self.patch_size[1] * self.patch_size[2])
        max_seq_len = math.ceil(max_seq_len / self.sp_size) * self.sp_size

        seed = seed if seed >= 0 else random.randint(0, sys.maxsize)
        generator = torch.Generator(device=self.device).manual_seed(seed)

        noise = torch.randn(16, (frame_num - 1) // self.vae_stride[0] + 1, lat_h, lat_w,
                            dtype=torch.float32, generator=generator, device=self.device)

        msk = torch.ones(1, frame_num, lat_h, lat_w, device=self.device)
        msk[:, 1:] = 0
        msk = torch.cat([torch.repeat_interleave(msk[:, :1], 4, dim=1), msk[:, 1:]], dim=1)
        msk = msk.view(1, -1, 4, lat_h, lat_w).transpose(1, 2)[0]

        if not n_prompt:
            n_prompt = self.sample_neg_prompt

        if not self.t5_cpu:
            self.text_encoder.model.to(self.device)
            context = self.text_encoder([input_prompt], self.device)
            context_null = self.text_encoder([n_prompt], self.device)
            if offload_model:
                self.text_encoder.model.cpu()
        else:
            context = self.text_encoder([input_prompt], torch.device("cpu"))
            context_null = self.text_encoder([n_prompt], torch.device("cpu"))
            context = [t.to(self.device) for t in context]
            context_null = [t.to(self.device) for t in context_null]

        y = self.vae.encode([
            torch.cat([
                torch.nn.functional.interpolate(img[None].cpu(), size=(h, w), mode="bicubic").transpose(0, 1),
                torch.zeros(3, frame_num - 1, h, w)
            ], dim=1).to(self.device)
        ])[0]
        y = torch.cat([msk, y])

        boundary = self.boundary * self.num_train_timesteps

        if sample_solver == "unipc":
            scheduler = FlowUniPCMultistepScheduler(
                num_train_timesteps=self.num_train_timesteps, shift=1, use_dynamic_shifting=False)
            scheduler.set_timesteps(sampling_steps, device=self.device, shift=shift)
            timesteps = scheduler.timesteps
        else:
            scheduler = FlowDPMSolverMultistepScheduler(
                num_train_timesteps=self.num_train_timesteps, shift=1, use_dynamic_shifting=False)
            sigmas = get_sampling_sigmas(sampling_steps, shift)
            timesteps, _ = retrieve_timesteps(scheduler, device=self.device, sigmas=sigmas)

        latent = noise
        arg_c = {"context": [context[0]], "seq_len": max_seq_len, "y": [y]}
        arg_null = {"context": context_null, "seq_len": max_seq_len, "y": [y]}

        no_sync_low = getattr(self.low_noise_model, "no_sync", nullcontext)
        no_sync_high = getattr(self.high_noise_model, "no_sync", nullcontext)

        with torch.amp.autocast("cuda", dtype=self.param_dtype), no_sync_low(), no_sync_high():
            if offload_model:
                torch.cuda.empty_cache()

            for t in tqdm(timesteps, desc="Awakening the Crimson Dragon", disable=self.rank != 0):
                latent_input = [latent.to(self.device)]
                timestep = torch.stack([t]).to(self.device)
                model = self._prepare_model_for_timestep(t, boundary, offload_model)
                cur_guide = guide_scale[1] if t.item() >= boundary else guide_scale[0]

                noise_pred_cond = model(latent_input, t=timestep, **arg_c)[0]
                if offload_model:
                    torch.cuda.empty_cache()
                noise_pred_uncond = model(latent_input, t=timestep, **arg_null)[0]
                if offload_model:
                    torch.cuda.empty_cache()

                noise_pred = noise_pred_uncond + cur_guide * (noise_pred_cond - noise_pred_uncond)
                latent = scheduler.step(
                    noise_pred.unsqueeze(0), t, latent.unsqueeze(0),
                    return_dict=False, generator=generator
                )[0].squeeze(0)

            if offload_model:
                self.low_noise_model.cpu()
                self.high_noise_model.cpu()
                torch.cuda.empty_cache()

            videos = self.vae.decode([latent]) if self.rank == 0 else None

        del noise, latent, scheduler
        if offload_model:
            gc.collect()
            torch.cuda.synchronize()
        if dist.is_initialized():
            dist.barrier()

        return videos[0] if self.rank == 0 else None


def generate_crimson_dragon(
    image_path: str = "dragon.png",
    ckpt_dir: str = "path/to/Wan2.1-I2V-A14B",
    output_path: str = "public/cutscenes/crimson_dragon_awaken.mp4",
    quality: str = "ultra",          # "game" | "ultra" | "cinematic"
):
    """
    Generates a perfect boss-intro / cutscene video for CRIMSON SOVEREIGN.
    Matches your exact palette (crimson 0xc41e3a, arterial, ember, void, gold).
    """
    from wan.configs import WAN_CONFIGS, MAX_AREA_CONFIGS

    img = Image.open(image_path).convert("RGB")

    # Prompt engineered for your game’s Type VII palace + living runes + crimson theme
    prompt = (
        "Epic cinematic first-person view inside the Type VII palace of living runes, "
        "massive black dragon with glowing crimson cracks and arterial red veins under its scales, "
        "eyes burning with pure crimson light (0xc41e3a), roaring with molten ember fire, "
        "huge bat wings slowly unfurling and beating, sending rune dust and blood-red embers flying, "
        "heavy iron chains swinging, gothic cathedral arches glowing with arterial red light, "
        "volumetric god rays in deep crimson and gold, dark void shadows, living runes pulsing on the floor, "
        "highly detailed scales, cinematic camera slow push-in, mythic atmosphere, 8k masterpiece, "
        "matches Crimson Sovereign visual style"
    )

    negative = (
        "blurry, low detail, static image, deformed, extra heads, cartoon, anime, bright daylight, "
        "blue sky, modern, text, watermark, oversaturated, flat lighting, low contrast"
    )

    cfg = WAN_CONFIGS["i2v-A14B"]

    # Quality presets matched to your engine’s setQuality system
    presets = {
        "game":     dict(steps=40, guide=6.5, area=MAX_AREA_CONFIGS["1280*720"], frames=81),
        "ultra":    dict(steps=50, guide=7.5, area=MAX_AREA_CONFIGS["1280*720"], frames=81),
        "cinematic":dict(steps=60, guide=8.0, area=1280*720, frames=97),
    }
    p = presets.get(quality, presets["ultra"])

    pipeline = WanI2V(
        config=cfg,
        checkpoint_dir=ckpt_dir,
        t5_cpu=True,
        init_on_cpu=True,
        convert_model_dtype=True,
    )

    print(f"Generating {quality.upper()} Crimson Dragon cutscene...")
    video = pipeline.generate(
        input_prompt=prompt,
        img=img,
        max_area=p["area"],
        frame_num=p["frames"],
        sampling_steps=p["steps"],
        guide_scale=p["guide"],
        n_prompt=negative,
        seed=42,
        offload_model=True,
    )

    if video is not None:
        os.makedirs(os.path.dirname(output_path), exist_ok=True)
        save_video(
            tensor=video[None],
            save_file=output_path,
            fps=cfg.sample_fps,
            nrow=1,
            normalize=True,
            value_range=(-1, 1),
        )
        print(f"✓ Saved game-ready cutscene → {output_path}")
        print("Ready to drop into public/cutscenes/ and play with HTML5 video or Three.js VideoTexture.")
        return output_path
    return None


if __name__ == "__main__":
    generate_crimson_dragon(
        image_path="dragon.png",                    # your dragon image
        ckpt_dir="/path/to/Wan2.1-I2V-A14B",        # your checkpoint
        output_path="public/cutscenes/crimson_dragon_awaken.mp4",
        quality="ultra"                             # change to "game" for faster iteration
    )