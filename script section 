<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CRIMSON SOVEREIGN – Adaptive Super Engine</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;touch-action:none}
  body{background:#020208;overflow:hidden;font-family:system-ui,sans-serif;color:#fff}
  canvas{display:block;width:100vw;height:100vh}
  #ui{
    position:absolute;top:12px;left:12px;z-index:30;
    background:rgba(0,0,0,0.8);backdrop-filter:blur(10px);
    border:1px solid #ff3355;border-radius:12px;
    padding:12px 16px;font-size:13px;line-height:1.45;
    max-width:320px;pointer-events:none;
  }
  #ui b{color:#ff4466}
  #perf{color:#88ffaa;font-size:12px;margin-top:6px}
  #mobile-controls{
    position:absolute;bottom:20px;left:0;right:0;z-index:25;
    display:none;justify-content:space-between;padding:0 20px;
    pointer-events:none;
  }
  .stick-area,.btn-area{pointer-events:auto}
  .btn{
    width:70px;height:70px;border-radius:50%;
    background:rgba(255,50,80,0.35);border:2px solid #ff4466;
    display:flex;align-items:center;justify-content:center;
    font-size:14px;font-weight:bold;color:#fff;
    user-select:none;
  }
  #joystick{
    width:110px;height:110px;border-radius:50%;
    background:rgba(255,255,255,0.08);border:2px solid rgba(255,100,120,0.5);
    position:relative;
  }
  #knob{
    width:48px;height:48px;border-radius:50%;
    background:#ff4466;position:absolute;top:31px;left:31px;
  }
</style>
</head>
<body>

<div id="ui">
  <b>CRIMSON SOVEREIGN</b> – Adaptive Super Engine<br>
  Auto texture + shape bug fixes<br>
  Smooth from low Android → high PC<br>
  <div id="perf">Detecting performance…</div>
</div>

<div id="mobile-controls">
  <div class="stick-area">
    <div id="joystick"><div id="knob"></div></div>
  </div>
  <div class="btn-area" style="display:flex;gap:16px;align-items:flex-end">
    <div class="btn" id="btn-jump">JUMP</div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ================================================================
   CRIMSON SOVEREIGN – ADAPTIVE SUPER ENGINE
   Automatic bug fixes for textures & shapes
   Smooth performance from low-end Android to high-end PC
   Overload protection + full physics + noclip fix
   ================================================================ */

const IS_MOBILE = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
const IS_LOW_END = IS_MOBILE || (navigator.hardwareConcurrency || 4) <= 4;

// -------------------- ADAPTIVE QUALITY SYSTEM --------------------
class PerformanceGovernor {
  constructor(renderer, scene) {
    this.renderer = renderer;
    this.scene = scene;
    this.targetFPS = IS_LOW_END ? 30 : 60;
    this.pixelRatio = IS_LOW_END ? 1 : Math.min(devicePixelRatio, 2);
    this.shadows = !IS_LOW_END;
    this.antialias = !IS_LOW_END;
    this.maxShapes = IS_LOW_END ? 8 : 25;
    this.apply();
  }

  apply() {
    this.renderer.setPixelRatio(this.pixelRatio);
    this.renderer.shadowMap.enabled = this.shadows;
    this.renderer.antialias = this.antialias;
    document.getElementById("perf").textContent =
      `Mode: ${IS_LOW_END ? "Low-End / Android" : "High Performance"} | ` +
      `PR: ${this.pixelRatio} | Shadows: ${this.shadows ? "ON" : "OFF"}`;
  }

  // Simple auto-adjust based on frame time
  update(dt) {
    if (dt > 0.045 && this.pixelRatio > 1) {
      this.pixelRatio = 1;
      this.shadows = false;
      this.apply();
    }
  }
}

// -------------------- PHYSICS (stable + fixed) --------------------
class PhysicsBody {
  constructor(mesh, opts = {}) {
    this.mesh = mesh;
    this.position = mesh.position;
    this.velocity = new THREE.Vector3();
    this.force = new THREE.Vector3();
    this.mass = opts.mass || 1;
    this.radius = opts.radius || 1;
    this.restitution = opts.restitution || 0.25;
    this.friction = opts.friction || 0.84;
    this.isStatic = opts.isStatic || false;
    this.onGround = false;
  }
  applyForce(f) { if (!this.isStatic) this.force.add(f); }
  integrate(dt) {
    if (this.isStatic) return;
    this.velocity.add(this.force.clone().divideScalar(this.mass).multiplyScalar(dt));
    this.position.add(this.velocity.clone().multiplyScalar(dt));
    this.force.set(0,0,0);
    this.velocity.multiplyScalar(0.993);
  }
}

class PhysicsWorld {
  constructor() {
    this.bodies = [];
    this.gravity = new THREE.Vector3(0, -30, 0);
    this.fixedDt = 1/60;
    this.acc = 0;
  }
  add(b) { this.bodies.push(b); }
  step(dt) {
    this.acc += Math.min(dt, 0.05);
    while (this.acc >= this.fixedDt) {
      this.fixedUpdate(this.fixedDt);
      this.acc -= this.fixedDt;
    }
  }
  fixedUpdate(dt) {
    for (const b of this.bodies) if (!b.isStatic) b.applyForce(this.gravity.clone().multiplyScalar(b.mass));
    for (const b of this.bodies) b.integrate(dt);
    this.resolve();
  }
  resolve() {
    const groundY = 0;
    for (const body of this.bodies) {
      if (body.isStatic) continue;
      // Ground
      if (body.position.y - body.radius < groundY) {
        body.position.y = groundY + body.radius;
        if (body.velocity.y < 0) {
          body.velocity.y *= -body.restitution;
          body.velocity.x *= body.friction;
          body.velocity.z *= body.friction;
        }
        body.onGround = true;
      } else body.onGround = false;

      // Shapes (sphere vs AABB – robust, no tunneling)
      for (const other of this.bodies) {
        if (other === body || !other.isStatic) continue;
        const box = new THREE.Box3().setFromObject(other.mesh);
        const closest = new THREE.Vector3(
          Math.max(box.min.x, Math.min(body.position.x, box.max.x)),
          Math.max(box.min.y, Math.min(body.position.y, box.max.y)),
          Math.max(box.min.z, Math.min(body.position.z, box.max.z))
        );
        const distVec = body.position.clone().sub(closest);
        const dist = distVec.length();
        if (dist < body.radius && dist > 0.0001) {
          const n = distVec.normalize();
          body.position.add(n.clone().multiplyScalar(body.radius - dist + 0.002));
          const vn = body.velocity.dot(n);
          if (vn < 0) {
            body.velocity.add(n.clone().multiplyScalar(-(1 + body.restitution) * vn));
            const tan = body.velocity.clone().sub(n.clone().multiplyScalar(body.velocity.dot(n)));
            body.velocity.sub(tan.multiplyScalar(1 - body.friction));
          }
        }
      }
    }
  }
}

// -------------------- TEXTURE + SHAPE FACTORY (bug-fixed) --------------------
function safeTexture(url, fallbackColor = 0x888888) {
  return new Promise(resolve => {
    const loader = new THREE.TextureLoader();
    loader.load(url,
      tex => {
        tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.generateMipmaps = true;
        tex.colorSpace = THREE.SRGBColorSpace;
        tex.needsUpdate = true;
        resolve(tex);
      },
      undefined,
      () => resolve(null) // automatic fallback on error
    );
  });
}

function createMaterial(color, texture = null) {
  return new THREE.MeshStandardMaterial({
    color: texture ? 0xffffff : color,
    map: texture,
    roughness: 0.34,
    metalness: 0.16,
    side: THREE.DoubleSide
  });
}

function makeSphere(r, c, t) { return new THREE.Mesh(new THREE.SphereGeometry(r, IS_LOW_END?16:32, IS_LOW_END?12:24), createMaterial(c,t)); }
function makeCube(s, c, t) { return new THREE.Mesh(new THREE.BoxGeometry(s,s,s), createMaterial(c,t)); }
function makePrism(w,h,d,c,t){ return new THREE.Mesh(new THREE.BoxGeometry(w,h,d), createMaterial(c,t)); }
function makeCylinder(r,h,c,t){ return new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,IS_LOW_END?16:32), createMaterial(c,t)); }
function makeCone(r,h,c,t){ return new THREE.Mesh(new THREE.ConeGeometry(r,h,IS_LOW_END?16:32), createMaterial(c,t)); }
function makePyramid(s,c,t){ return new THREE.Mesh(new THREE.TetrahedronGeometry(s), createMaterial(c,t)); }

// -------------------- MAIN ENGINE --------------------
class AdaptiveSuperEngine {
  constructor() {
    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x020208);
    this.scene.fog = new THREE.FogExp2(0x020208, 0.011);

    this.camera = new THREE.PerspectiveCamera(65, innerWidth/innerHeight, 0.1, 400);
    this.renderer = new THREE.WebGLRenderer({
      antialias: !IS_LOW_END,
      powerPreference: "high-performance",
      alpha: false
    });
    this.renderer.setSize(innerWidth, innerHeight);
    this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    this.renderer.outputEncoding = THREE.sRGBEncoding;
    document.body.appendChild(this.renderer.domElement);

    // Lights
    this.scene.add(new THREE.AmbientLight(0x2a2a44, 0.5));
    this.sun = new THREE.DirectionalLight(0xfff5e8, 1.25);
    this.sun.position.set(25, 45, 18);
    this.sun.castShadow = true;
    this.sun.shadow.mapSize.set(IS_LOW_END ? 1024 : 2048, IS_LOW_END ? 1024 : 2048);
    this.scene.add(this.sun);

    // Adaptive system
    this.governor = new PerformanceGovernor(this.renderer, this.scene);

    // Physics
    this.physics = new PhysicsWorld();

    // Player
    this.playerMesh = makeSphere(1.15, 0xff3355);
    this.playerMesh.castShadow = true;
    this.scene.add(this.playerMesh);
    this.playerBody = new PhysicsBody(this.playerMesh, { mass: 1.15, radius: 1.15 });
    this.physics.add(this.playerBody);

    this.buildWorld();
    this.setupInput();
    this.clock = new THREE.Clock();
    this.animate();
  }

  buildWorld() {
    // Ground
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(300, 300),
      new THREE.MeshStandardMaterial({ color: 0x0a0a12, roughness: 0.93 })
    );
    ground.rotation.x = -Math.PI/2;
    ground.receiveShadow = true;
    this.scene.add(ground);

    // All shapes from your scans (optimized geometry on low-end)
    const list = [
      { fn: makeSphere, args: [3.5, 0xff2244], pos: [-20, 3.5, 0] },
      { fn: makeCube, args: [5, 0x33ff88], pos: [-9, 2.5, 0] },
      { fn: makePrism, args: [7.5, 3.8, 4.5, 0x4488ff], pos: [3, 1.9, 0] },
      { fn: makeCylinder, args: [3, 7, 0xffaa22], pos: [14, 3.5, 0] },
      { fn: makeCone, args: [3.8, 8, 0xcc44ff], pos: [25, 4, 0] },
      { fn: makePyramid, args: [4.8, 0xff6688], pos: [0, 3.5, -14] }
    ];

    list.forEach(s => {
      const mesh = s.fn(...s.args);
      mesh.position.set(...s.pos);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      this.scene.add(mesh);
      this.physics.add(new PhysicsBody(mesh, { isStatic: true }));
    });

    this.scene.add(new THREE.GridHelper(120, 60, 0x222244, 0x111122));
  }

  setupInput() {
    this.keys = {};
    this.mobileMove = new THREE.Vector2();
    this.jumpPressed = false;

    window.addEventListener("keydown", e => this.keys[e.code] = true);
    window.addEventListener("keyup", e => this.keys[e.code] = false);

    if (IS_MOBILE) {
      document.getElementById("mobile-controls").style.display = "flex";
      this.setupJoystick();
      document.getElementById("btn-jump").addEventListener("touchstart", e => {
        e.preventDefault();
        this.jumpPressed = true;
      });
      document.getElementById("btn-jump").addEventListener("touchend", () => this.jumpPressed = false);
    }

    window.addEventListener("resize", () => {
      this.camera.aspect = innerWidth / innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(innerWidth, innerHeight);
    });
  }

  setupJoystick() {
    const joy = document.getElementById("joystick");
    const knob = document.getElementById("knob");
    let active = false, startX, startY;

    const move = (x, y) => {
      const dx = x - startX;
      const dy = y - startY;
      const max = 32;
      const len = Math.min(Math.hypot(dx, dy), max);
      const angle = Math.atan2(dy, dx);
      knob.style.transform = `translate(${Math.cos(angle)*len}px, ${Math.sin(angle)*len}px)`;
      this.mobileMove.set(Math.cos(angle)*(len/max), Math.sin(angle)*(len/max));
    };

    joy.addEventListener("touchstart", e => {
      e.preventDefault();
      active = true;
      const t = e.touches[0];
      startX = t.clientX;
      startY = t.clientY;
    });
    joy.addEventListener("touchmove", e => {
      if (!active) return;
      e.preventDefault();
      const t = e.touches[0];
      move(t.clientX, t.clientY);
    });
    const end = () => {
      active = false;
      knob.style.transform = "translate(0,0)";
      this.mobileMove.set(0,0);
    };
    joy.addEventListener("touchend", end);
    joy.addEventListener("touchcancel", end);
  }

  update(dt) {
    // Input
    const move = new THREE.Vector3();
    if (this.keys["KeyW"] || this.mobileMove.y < -0.2) move.z -= 1;
    if (this.keys["KeyS"] || this.mobileMove.y > 0.2) move.z += 1;
    if (this.keys["KeyA"] || this.mobileMove.x < -0.2) move.x -= 1;
    if (this.keys["KeyD"] || this.mobileMove.x > 0.2) move.x += 1;

    const speed = IS_LOW_END ? 16 : 22;
    if (move.lengthSq() > 0) {
      move.normalize().multiplyScalar(speed);
      this.playerBody.velocity.x = move.x;
      this.playerBody.velocity.z = move.z;
    } else {
      this.playerBody.velocity.x *= 0.87;
      this.playerBody.velocity.z *= 0.87;
    }

    if ((this.keys["Space"] || this.jumpPressed) && this.playerBody.onGround) {
      this.playerBody.velocity.y = 14.5;
      this.playerBody.onGround = false;
      this.jumpPressed = false;
    }

    this.physics.step(dt);
    this.playerMesh.position.copy(this.playerBody.position);

    // Camera
    const target = this.playerBody.position.clone().add(new THREE.Vector3(0, 7.5, 16));
    this.camera.position.lerp(target, 0.09);
    this.camera.lookAt(this.playerBody.position.x, this.playerBody.position.y + 1.2, this.playerBody.position.z);

    // Adaptive quality
    this.governor.update(dt);
  }

  animate() {
    requestAnimationFrame(() => this.animate());
    const dt = this.clock.getDelta();
    this.update(dt);
    this.renderer.render(this.scene, this.camera);
  }
}

// Start
new AdaptiveSuperEngine();
</script>
</body>
</html>