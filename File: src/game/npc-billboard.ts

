**Number 4 – NPC Billboard System**  
(For the Cyber-Ninja and future NPCs)

This system makes the animated ninja (and any other character videos) appear as living characters that always face the player.

---

### File: `src/game/npc-billboard.ts`

```ts
// src/game/npc-billboard.ts
import * as THREE from "three";
import { VideoManager } from "./video-manager";

export class NPCBillboard {
  private mesh: THREE.Mesh;
  private videoManager: VideoManager;
  private id: string;
  private camera: THREE.Camera;

  public position: THREE.Vector3;

  constructor(
    videoManager: VideoManager,
    camera: THREE.Camera,
    id: string,
    videoPath: string,
    position: THREE.Vector3,
    width = 2.4,
    height = 3.6
  ) {
    this.videoManager = videoManager;
    this.camera = camera;
    this.id = id;
    this.position = position.clone();

    // Load the video through the manager
    this.videoManager.load(id, videoPath, {
      width,
      height,
      position,
      autoplay: true,
      loop: true,
    });

    const mesh = this.videoManager.getMesh(id);
    if (!mesh) {
      throw new Error(`Failed to create NPC mesh for ${id}`);
    }

    this.mesh = mesh;
    this.mesh.position.copy(position);
  }

  /**
   * Call every frame so the NPC always faces the player
   */
  update() {
    // Billboard – make the plane face the camera
    this.mesh.lookAt(
      this.camera.position.x,
      this.mesh.position.y, // keep upright
      this.camera.position.z
    );
  }

  play() {
    this.videoManager.play(this.id);
  }

  pause() {
    this.videoManager.pause(this.id);
  }

  setPosition(x: number, y: number, z: number) {
    this.position.set(x, y, z);
    this.mesh.position.copy(this.position);
  }

  dispose() {
    // VideoManager will handle texture & mesh disposal
  }
}
```

