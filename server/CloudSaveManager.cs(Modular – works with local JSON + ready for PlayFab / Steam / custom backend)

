using UnityEngine;
using System;
using System.IO;

public class CloudSaveManager : MonoBehaviour
{
    public static CloudSaveManager Instance { get; private set; }

    public enum CloudProvider { LocalOnly, PlayFab, Steam, Custom }

    [Header("Provider")]
    public CloudProvider provider = CloudProvider.LocalOnly;

    [Header("PlayFab (optional)")]
    public string playFabTitleId = "";          // set in Inspector if using PlayFab

    void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else Destroy(gameObject);
    }

    // ========== PUBLIC API ==========

    public void SavePityData(string json)
    {
        switch (provider)
        {
            case CloudProvider.LocalOnly:
                // Already handled by PitySystem
                break;

            case CloudProvider.PlayFab:
                SaveToPlayFab(json);
                break;

            case CloudProvider.Steam:
                SaveToSteam(json);
                break;

            case CloudProvider.Custom:
                SaveToCustomBackend(json);
                break;
        }
    }

    public void LoadPityData(Action<string> onLoaded)
    {
        switch (provider)
        {
            case CloudProvider.LocalOnly:
                onLoaded?.Invoke(null);   // fall back to local file
                break;

            case CloudProvider.PlayFab:
                LoadFromPlayFab(onLoaded);
                break;

            case CloudProvider.Steam:
                LoadFromSteam(onLoaded);
                break;

            case CloudProvider.Custom:
                LoadFromCustomBackend(onLoaded);
                break;
        }
    }

