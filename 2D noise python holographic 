# Quick usage example
# ----------------------------------------------------------------------
if __name__ == "__main__":
    perlin = PerlinNoise2D(seed=63821)

    # Single sample
    print("Single noise:", perlin.noise(12.3, 45.6))

    # fBm sample
    print("fBm:", fbm(perlin, 100, 200))

    # Generate a small height map (for testing)
    width, height = 64, 64
    heightmap = []
    for y in range(height):
        row = []
        for x in range(width):
            n = fbm(perlin, x, y)
            # remap roughly [-1,1] → [0,1]
            row.append((n + 1) * 0.5)
        heightmap.append(row)

    print("Heightmap generated (64×64)")