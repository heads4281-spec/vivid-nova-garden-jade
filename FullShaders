<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Optimized HTML5 Game – Full Example</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #111; overflow: hidden; display: flex; justify-content: center; align-items: center; height: 100vh; }
  canvas { background: #000; display: block; max-width: 100%; max-height: 100%; }
  #ui { position: absolute; top: 12px; left: 12px; color: #0f0; font: 16px monospace; pointer-events: none; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="ui">FPS: -- | Score: 0 | Pool: 0</div>

<script>
"use strict";

/* ===================== CONFIG ===================== */
const W = 800, H = 600;
const MAX_BULLETS = 120;
const MAX_PARTICLES = 400;
const MAX_ENEMIES = 40;

/* ===================== CANVAS ===================== */
const canvas = document.getElementById("c");
const ctx = canvas.getContext("2d", { alpha: false });
const ui = document.getElementById("ui");

let dpr = Math.min(window.devicePixelRatio || 1, 2); // cap for low-end
function resize() {
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + "px";
  canvas.style.height = H + "px";
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
resize();
window.addEventListener("resize", resize);

/* ===================== INPUT ===================== */
const keys = Object.create(null);
window.addEventListener("keydown", e => keys[e.code] = true);
window.addEventListener("keyup",   e => keys[e.code] = false);

/* ===================== OBJECT POOLS ===================== */
function createPool(size, factory) {
  const pool = [];
  for (let i = 0; i < size; i++) pool.push(factory());
  return {
    free: pool,
    active: [],
    get() {
      const obj = this.free.pop() || factory();
      this.active.push(obj);
      return obj;
    },
    release(obj) {
      const i = this.active.indexOf(obj);
      if (i !== -1) {
        this.active.splice(i, 1);
        this.free.push(obj);
      }
    },
    clear() {
      while (this.active.length) this.release(this.active[0]);
    }
  };
}

/* ----- Bullet ----- */
function Bullet() {
  return { x:0, y:0, vx:0, vy:0, life:0, active:false };
}
const bulletPool = createPool(MAX_BULLETS, Bullet);

/* ----- Particle ----- */
function Particle() {
  return { x:0, y:0, vx:0, vy:0, life:0, maxLife:0, r:0, g:0, b:0, size:0 };
}
const particlePool = createPool(MAX_PARTICLES, Particle);

/* ----- Enemy ----- */
function Enemy() {
  return { x:0, y:0, vx:0, vy:0, hp:1, r:12, active:false };
}
const enemyPool = createPool(MAX_ENEMIES, Enemy);

/* ===================== GAME STATE ===================== */
const player = { x: W/2, y: H - 60, w: 28, h: 28, speed: 320, cooldown: 0 };
let score = 0;
let spawnTimer = 0;
let lastTime = 0;
let fps = 0, frames = 0, fpsTimer = 0;
let running = true;

/* ===================== HELPERS ===================== */
function spawnBullet(x, y, vx, vy) {
  const b = bulletPool.get();
  b.x = x; b.y = y; b.vx = vx; b.vy = vy; b.life = 1.2; b.active = true;
}
function spawnParticle(x, y, color) {
  const p = particlePool.get();
  p.x = x; p.y = y;
  const a = Math.random() * Math.PI * 2;
  const s = 40 + Math.random() * 120;
  p.vx = Math.cos(a) * s; p.vy = Math.sin(a) * s;
  p.life = p.maxLife = 0.4 + Math.random() * 0.5;
  p.size = 2 + Math.random() * 4;
  p.r = color[0]; p.g = color[1]; p.b = color[2];
}
function spawnEnemy() {
  const e = enemyPool.get();
  e.x = 40 + Math.random() * (W - 80);
  e.y = -30;
  e.vx = (Math.random() - 0.5) * 60;
  e.vy = 80 + Math.random() * 70;
  e.hp = 1 + (Math.random() > 0.7 ? 1 : 0);
  e.r = 12 + e.hp * 4;
  e.active = true;
}

/* ===================== UPDATE ===================== */
function update(dt) {
  // Player movement
  let mx = 0, my = 0;
  if (keys["ArrowLeft"]  || keys["KeyA"]) mx -= 1;
  if (keys["ArrowRight"] || keys["KeyD"]) mx += 1;
  if (keys["ArrowUp"]    || keys["KeyW"]) my -= 1;
  if (keys["ArrowDown"]  || keys["KeyS"]) my += 1;
  if (mx || my) {
    const len = Math.hypot(mx, my) || 1;
    player.x += (mx / len) * player.speed * dt;
    player.y += (my / len) * player.speed * dt;
    player.x = Math.max(14, Math.min(W - 14, player.x));
    player.y = Math.max(14, Math.min(H - 14, player.y));
  }

  // Shooting
  player.cooldown -= dt;
  if ((keys["Space"] || keys["KeyZ"]) && player.cooldown <= 0) {
    spawnBullet(player.x, player.y - 18, 0, -520);
    player.cooldown = 0.12;
  }

  // Bullets
  for (let i = bulletPool.active.length - 1; i >= 0; i--) {
    const b = bulletPool.active[i];
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.life -= dt;
    if (b.life <= 0 || b.y < -20 || b.y > H + 20) {
      bulletPool.release(b);
    }
  }

  // Enemies
  spawnTimer -= dt;
  if (spawnTimer <= 0 && enemyPool.active.length < MAX_ENEMIES) {
    spawnEnemy();
    spawnTimer = 0.35 + Math.random() * 0.4;
  }
  for (let i = enemyPool.active.length - 1; i >= 0; i--) {
    const e = enemyPool.active[i];
    e.x += e.vx * dt;
    e.y += e.vy * dt;
    if (e.y > H + 40) enemyPool.release(e);
  }

  // Particles
  for (let i = particlePool.active.length - 1; i >= 0; i--) {
    const p = particlePool.active[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vx *= 0.96; p.vy *= 0.96;
    p.life -= dt;
    if (p.life <= 0) particlePool.release(p);
  }

  // Collisions (simple O(n) – still fine with pools + limited counts)
  for (let i = bulletPool.active.length - 1; i >= 0; i--) {
    const b = bulletPool.active[i];
    for (let j = enemyPool.active.length - 1; j >= 0; j--) {
      const e = enemyPool.active[j];
      const dx = b.x - e.x, dy = b.y - e.y;
      if (dx*dx + dy*dy < (e.r + 4) * (e.r + 4)) {
        e.hp--;
        bulletPool.release(b);
        for (let k = 0; k < 8; k++) spawnParticle(e.x, e.y, [255, 180, 40]);
        if (e.hp <= 0) {
          score += 10;
          for (let k = 0; k < 18; k++) spawnParticle(e.x, e.y, [255, 80, 40]);
          enemyPool.release(e);
        }
        break;
      }
    }
  }

  // Player hit
  for (let i = enemyPool.active.length - 1; i >= 0; i--) {
    const e = enemyPool.active[i];
    const dx = player.x - e.x, dy = player.y - e.y;
    if (dx*dx + dy*dy < (e.r + 14) * (e.r + 14)) {
      for (let k = 0; k < 40; k++) spawnParticle(player.x, player.y, [0, 255, 120]);
      score = Math.max(0, score - 50);
      enemyPool.release(e);
    }
  }
}

/* ===================== RENDER ===================== */
function render() {
  // Clear only the game area (fast)
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, W, H);

  // Particles (additive-ish)
  for (const p of particlePool.active) {
    const a = p.life / p.maxLife;
    ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},${a})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size * a, 0, Math.PI * 2);
    ctx.fill();
  }

  // Bullets
  ctx.fillStyle = "#0ff";
  for (const b of bulletPool.active) {
    ctx.fillRect(b.x - 2, b.y - 6, 4, 12);
  }

  // Enemies
  for (const e of enemyPool.active) {
    ctx.fillStyle = e.hp > 1 ? "#f44" : "#f84";
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
    ctx.fill();
  }

  // Player
  ctx.fillStyle = "#0f8";
  ctx.fillRect(player.x - 14, player.y - 14, 28, 28);
  ctx.fillStyle = "#0ff";
  ctx.fillRect(player.x - 4, player.y - 22, 8, 10);
}

/* ===================== MAIN LOOP ===================== */
function loop(now) {
  if (!running) return;
  const dt = Math.min((now - lastTime) / 1000, 0.05); // clamp
  lastTime = now;

  update(dt);
  render();

  // FPS counter
  frames++;
  fpsTimer += dt;
  if (fpsTimer >= 0.5) {
    fps = Math.round(frames / fpsTimer);
    frames = 0; fpsTimer = 0;
    ui.textContent = `FPS: ${fps} | Score: ${score} | Active: B${bulletPool.active.length} E${enemyPool.active.length} P${particlePool.active.length}`;
  }

  requestAnimationFrame(loop);
}

/* ===================== VISIBILITY ===================== */
document.addEventListener("visibilitychange", () => {
  running = !document.hidden;
  if (running) {
    lastTime = performance.now();
    requestAnimationFrame(loop);
  }
});

/* ===================== START ===================== */
lastTime = performance.now();
requestAnimationFrame(loop);
</script>
</body>
</html>