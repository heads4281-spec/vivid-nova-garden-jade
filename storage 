<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Infernal Citadel — Full Module + Inventory Tracker</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap');

:root {
    --bg-deep: #050505;
    --bg-card: #0d0d0d;
    --accent: #c41e1e;
    --accent-glow: #ff2a2a;
    --text-main: #e8d5d5;
    --text-dim: #a08080;
    --border: #3a0a0a;
    --loot: #b8860b;
    --gold: #ffd700;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    background: var(--bg-deep);
    color: var(--text-main);
    font-family: 'Cormorant Garamond', serif;
    line-height: 1.65;
    min-height: 100vh;
    background-image:
        radial-gradient(ellipse at top, #1a0505 0%, transparent 60%),
        radial-gradient(ellipse at bottom, #120000 0%, transparent 70%);
}

/* ===== STICKY INVENTORY TRACKER ===== */
.inventory-panel {
    position: sticky;
    top: 0;
    z-index: 200;
    background: linear-gradient(180deg, #1a0f00 0%, #0f0800 100%);
    border-bottom: 2px solid var(--gold);
    box-shadow: 0 6px 25px rgba(0,0,0,0.85);
    padding: 12px 18px 14px;
}

.inv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
}

.inv-top h2 {
    font-family: 'Cinzel', serif;
    color: var(--gold);
    font-size: 1.25rem;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(255,215,0,0.4);
}

.inv-controls {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
}

.inv-btn {
    padding: 5px 12px;
    background: #3a2a00;
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 3px;
    font-family: 'Cinzel', serif;
    font-size: 0.82rem;
    cursor: pointer;
    transition: 0.2s;
}

.inv-btn:hover {
    background: #5c4500;
    box-shadow: 0 0 10px rgba(255,215,0,0.35);
}

.inv-btn.danger {
    border-color: #c41e1e;
    color: #ff6666;
    background: #2a0000;
}

.inv-btn.danger:hover { background: #4a0000; }

#inventoryList {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    min-height: 34px;
    max-height: 110px;
    overflow-y: auto;
    padding: 2px 0;
}

.inv-item {
    background: #1a1200;
    border: 1px solid #8b6500;
    border-radius: 4px;
    padding: 3px 8px 3px 10px;
    font-size: 0.93rem;
    color: #ffeaa0;
    display: flex;
    align-items: center;
    gap: 7px;
    animation: fadeIn 0.3s ease;
}

.inv-item button {
    background: none;
    border: none;
    color: #ff5555;
    cursor: pointer;
    font-size: 1.05rem;
    line-height: 1;
    padding: 0 1px;
}

.inv-item button:hover { color: #ff0000; }

.inv-empty {
    color: #666;
    font-style: italic;
    font-size: 0.95rem;
    padding: 4px 0;
}

/* ===== HEADER & ROOMS ===== */
header {
    text-align: center;
    padding: 40px 20px 25px;
    border-bottom: 1px solid var(--border);
}

header h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    color: var(--accent-glow);
    text-shadow: 0 0 10px rgba(255,40,40,0.8), 0 0 30px rgba(200,0,0,0.5);
    letter-spacing: 3px;
    margin-bottom: 6px;
}

header p {
    font-size: 1.1rem;
    color: var(--text-dim);
    font-style: italic;
}

.container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 30px 18px 70px;
}

.room {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    margin-bottom: 42px;
    overflow: hidden;
    box-shadow: 0 0 18px rgba(150,0,0,0.15), inset 0 0 50px rgba(30,0,0,0.4);
}

.room-header {
    background: linear-gradient(90deg, #1a0000, #2a0505, #1a0000);
    padding: 16px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 14px;
}

.room-number {
    font-family: 'Cinzel', serif;
    font-size: 1.6rem;
    color: var(--accent);
    text-shadow: 0 0 10px rgba(255,40,40,0.6);
    min-width: 40px;
}

.room-title {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    color: #ffcccc;
}

.room-subtitle {
    font-size: 0.88rem;
    color: var(--text-dim);
}

.room-body { padding: 24px 26px 30px; }

.room-body p {
    margin-bottom: 14px;
    font-size: 1.08rem;
}

.feature-list, .monster-list, .loot-list {
    list-style: none;
    margin: 14px 0 8px;
}

.feature-list li, .monster-list li, .loot-list li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 6px;
    font-size: 1.02rem;
    color: #d0b0b0;
}

.feature-list li::before { content: '◆'; position: absolute; left: 0; color: var(--accent); font-size: 0.7rem; top: 4px; }
.monster-list li::before { content: '☠'; position: absolute; left: 0; color: #ff3333; }
.loot-list li::before { content: '✦'; position: absolute; left: 0; color: var(--gold); }

.hazards, .monsters, .loot, .stats {
    margin-top: 20px;
    padding: 13px 16px;
    border-radius: 0 4px 4px 0;
}

.hazards { background: rgba(80,0,0,0.25); border-left: 3px solid var(--accent); }
.monsters { background: rgba(60,0,0,0.35); border-left: 3px solid #8b0000; }
.loot { background: rgba(40,30,0,0.35); border-left: 3px solid var(--loot); }
.stats { background: rgba(50,0,0,0.4); border-left: 3px solid #660000; }

.hazards strong, .monsters strong, .loot strong, .stats strong {
    font-family: 'Cinzel', serif;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 6px;
    font-size: 0.9rem;
}

.hazards strong { color: var(--accent-glow); }
.monsters strong { color: #ff5555; }
.loot strong { color: var(--gold); }
.stats strong { color: #ff6666; }

.stat-block {
    background: #120000;
    border: 1px solid #4a0000;
    border-radius: 4px;
    padding: 11px 13px;
    margin: 9px 0;
    font-size: 0.93rem;
}

.stat-block h4 {
    font-family: 'Cinzel', serif;
    color: #ff4444;
    margin-bottom: 4px;
    font-size: 1.08rem;
}

.stat-block .meta { color: #cc8888; font-size: 0.88rem; margin-bottom: 5px; }
.stat-block .line { margin: 2px 0; }
.stat-block .label { color: #ffaaaa; font-weight: 600; }
.cr { color: #ffcc00; font-weight: bold; }

/* Loot buttons & results */
.roll-btn, .add-btn {
    display: inline-block;
    margin-top: 12px;
    margin-right: 8px;
    padding: 8px 16px;
    background: linear-gradient(135deg, #5a3a00, #8b6500);
    color: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 4px;
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: 0.2s;
    text-shadow: 0 0 6px rgba(255,215,0,0.4);
}

.roll-btn:hover, .add-btn:hover {
    background: linear-gradient(135deg, #8b6500, #c9a227);
    box-shadow: 0 0 12px rgba(255,215,0,0.35);
    transform: translateY(-1px);
}

.roll-result {
    margin-top: 14px;
    padding: 12px 16px;
    background: rgba(20,15,0,0.75);
    border: 1px solid #b8860b;
    border-radius: 4px;
    display: none;
    animation: fadeIn 0.35s ease;
}

.roll-result.visible { display: block; }

.roll-result h5 {
    font-family: 'Cinzel', serif;
    color: var(--gold);
    margin-bottom: 7px;
    font-size: 1rem;
}

.roll-result ul { list-style: none; padding: 0; }
.roll-result li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 5px;
    color: #e8d5a0;
}
.roll-result li::before { content: '✦'; position: absolute; left: 0; color: var(--gold); }

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
}

footer {
    text-align: center;
    padding: 30px 20px;
    color: var(--text-dim);
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
}

footer span { color: var(--accent); }

@media (max-width: 600px) {
    .room-header { flex-direction: column; align-items: flex-start; gap: 4px; }
    .room-body { padding: 18px 16px 24px; }
}
</style>
</head>
<body>

<!-- ===== PARTY INVENTORY TRACKER ===== -->
<div class="inventory-panel">
    <div class="inv-top">
        <h2>⚔ Party Inventory</h2>
        <div class="inv-controls">
            <button class="inv-btn" onclick="addManualItem()">+ Add Item</button>
            <button class="inv-btn" onclick="exportInventory()">Export</button>
            <button class="inv-btn danger" onclick="clearInventory()">Clear All</button>
        </div>
    </div>
    <div id="inventoryList">
        <span class="inv-empty">No items yet — roll loot and click “Add to Inventory”</span>
    </div>
</div>

<header>
    <h1>THE INFERNAL CITADEL</h1>
    <p>Five chambers of the volcanic abyss • Full interactive module</p>
</header>

<div class="container">

<!-- ==================== ROOM 1 ==================== -->
<article class="room">
    <div class="room-header">
