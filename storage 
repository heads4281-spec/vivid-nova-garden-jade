<script>
// ===================== INVENTORY SYSTEM =====================
let inventory = JSON.parse(localStorage.getItem('infernalInventory')) || [];

function saveInventory() {
    localStorage.setItem('infernalInventory', JSON.stringify(inventory));
    renderInventory();
}

function renderInventory() {
    const list = document.getElementById('inventoryList');
    if (inventory.length === 0) {
        list.innerHTML = '<span class="inv-empty">No items yet — roll loot and click “Add to Inventory”</span>';
        return;
    }
    list.innerHTML = inventory.map((item, i) => `
        <div class="inv-item">
            <span>${item}</span>
            <button onclick="removeItem(${i})" title="Remove">×</button>
        </div>
    `).join('');
}

function addToInventory(itemText) {
    if (!itemText || itemText.trim() === '') return;
    inventory.push(itemText.trim());
    saveInventory();
}

function removeItem(index) {
    inventory.splice(index, 1);
    saveInventory();
}

function clearInventory() {
    if (confirm('Clear the entire party inventory? This cannot be undone.')) {
        inventory = [];
        saveInventory();
    }
}

function addManualItem() {
    const item = prompt('Enter item name to add to inventory:');
    if (item && item.trim()) {
        addToInventory(item.trim());
    }
}

function exportInventory() {
    if (inventory.length === 0) {
        alert('Inventory is empty.');
        return;
    }
    const text = '=== Infernal Citadel Party Inventory ===\n\n' + inventory.map((item, i) => `${i+1}. ${item}`).join('\n');
    navigator.clipboard.writeText(text).then(() => {
        alert('Inventory copied to clipboard!');
    }).catch(() => {
        prompt('Copy this inventory:', text);
    });
}

// ===================== LOOT ROLLING =====================
function d(sides) { return Math.floor(Math.random() * sides) + 1; }
function roll(num, sides) {
    let total = 0;
    for (let i = 0; i < num; i++) total += d(sides);
    return total;
}
function chance(percent) { return Math.random() * 100 < percent; }

const lootTables = {
    1: {
        name: "The Crimson Threshold",
        common: () => `${roll(3,6)*10} gp + 2 potions of fire resistance`,
        uncommon: { chance: 50, text: "Black-iron key + +1 volcanic glass dagger" },
        rare: { chance: 20, text: "Burning Eye of the Statue (permanent torch, 1d6 fire if thrown)" },
        hidden: { chance: 40, text: "Hidden casket: 1d4 soul coins + scroll of Protection from Evil and Good" }
    },
    2: {
        name: "The Vein Gallery",
        common: () => `${roll(2,4)} smoldering banners + ${roll(4,6)} gp in cooled lava`,
        uncommon: { chance: 60, text: "Boots of Lava Walking" },
        rare: { chance: 25, text: "Crystal shard (+1 to fire spell attack rolls)" },
        hidden: { chance: 35, text: "Iron coffer: 150 gp + potion of greater healing + cursed heating ring" }
    },
    3: {
        name: "The Ember Throne Room",
        common: () => `${roll(5,10)*10} gp + ${roll(2,6)} fire opals`,
        uncommon: { chance: 55, text: "+1 Black-iron greataxe (extra 1d6 fire)" },
        rare: { chance: 30, text: "Ember Crown (fire resistance + Hellish Rebuke 1/day)" },
        legendary: { chance: 15, text: "Heart of the Ember Throne (5,000 gp — possible curse)" }
    },
    4: {
        name: "The Abyssal Observatory",
        common: () => `${roll(1,4)} crystal lens fragments + fortress map`,
        uncommon: { chance: 50, text: "Spyglass of the Abyss" },
        rare: { chance: 20, text: "Intact crystal lens (advantage on planar Arcana)" },
        hidden: { chance: 30, text: "Scroll of Plane Shift + 3 soul gems" }
    },
    5: {
        name: "The Molten Sanctum",
        common: () => `${roll(4,6)*50} gp + ${roll(2,4)} rare fire gems + heat-resistant cloth`,
        uncommon: { chance: 70, text: `${roll(1,3)} pulsing crystal orbs` },
        rare: { chance: 35, text: "+2 black-metal weapon (extra 1d8 fire)" },
        legendary: { chance: 20, text: "Core of the Magma Pillar (15,000 gp)" },
        hidden: { chance: 25, text: "Infernal contract + 3 diamond soul vessels + deeper map" }
    }
};

function rollLoot(roomNum) {
    const table = lootTables[roomNum];
    const resultDiv = document.getElementById(`result${roomNum}`);
    let found = [];
    let itemsToAdd = [];

    // Common always
    const commonText = table.common();
    found.push(`<strong>Common:</strong> ${commonText}`);
    itemsToAdd.push(commonText);

    if (table.uncommon && chance(table.uncommon.chance)) {
        found.push(`<strong>Uncommon:</strong> ${table.uncommon.text}`);
        itemsToAdd.push(table.uncommon.text);
    }
    if (table.rare && chance(table.rare.chance)) {
        found.push(`<strong>Rare:</strong> ${table.rare.text}`);
        itemsToAdd.push(table.rare.text);
    }
    if (table.legendary && chance(table.legendary.chance)) {
        found.push(`<strong>Legendary:</strong> ${table.legendary.text}`);
        itemsToAdd.push(table.legendary.text);
    }
    if (table.hidden && chance(table.hidden.chance)) {
        found.push(`<strong>Hidden:</strong> ${table.hidden.text}`);
        itemsToAdd.push(table.hidden.text);
    }

    if (found.length === 1) {
        found.push("<em>No uncommon / rare / hidden items this time.</em>");
    }

    // Build result with Add buttons
    let html = `<h5>🎲 Loot Results — ${table.name}</h5><ul>`;
    found.forEach((line, idx) => {
        html += `<li>${line}</li>`;
    });
    html += `</ul>`;

    // Single "Add All to Inventory" button
    const safeItems = itemsToAdd.map(i => i.replace(/'/g, "\\'"));
    html += `<button class="add-btn" onclick='addMultipleToInventory(${JSON.stringify(itemsToAdd)})'>➕ Add All to Inventory</button>`;

    resultDiv.innerHTML = html;
    resultDiv.classList.add('visible');
    resultDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function addMultipleToInventory(items) {
    items.forEach(item => addToInventory(item));
    alert(`${items.length} item(s) added to Party Inventory!`);
}

// Initialize inventory on load
renderInventory();
</script>

