<script type="module">
import * as THREE from "three";

const USER = { login:"heads4281-spec", public_repos:24, url:"https://github.com/heads4281-spec" };

const REPOS = [
  "arrow-arch-crisp-acre","baker-beacon-king-plaza","brave-mist-pearl-civic","brave-rapid-topaz-drum",
  "dune-cactus-ivory-cactus","earth-iris-olive-autumn","ember-lark-ivory-vivid","fjord-dune-pepper-blue",
  "giant-clear-plaza-gem","hazel-kite-cabin-autumn","lion-field-plum-cosmic","lotus-craft-wind-garden",
  "marble-delta-zinc-coral","nova-sand-pine-timber","olive-falcon-apex-thunder","olive-plum-forge-field",
  "pilot-lake-tundra-solar","pine-bold-dream-drum","quartz-forest-able-pine","river-kind-kind-raven",
  "velvet-bamboo-spring-winter","vivid-nova-garden-jade","yarrow-earth-apple-opal","zenith-shadow-yonder-scarlet"
];

const COMMITS = [
  ["35a6cc9","Create three-jsx-16-webgl.html"],
  ["a723a2e","Create Super Physic JSON"],
  ["e26ad01","Create Super files Auto physic"],
  ["01d742b","Update HTML 15"],
