// Already provided earlier – pure Perlin + fBm
function fbm(perlin: PerlinNoise2D, x: number, z: number,
             octaves = 5, persistence = 0.5, lacunarity = 2.0): number {
  let value = 0;
  let amplitude = 1.0;
  let frequency = 0.004;          // base frequency matching your Python

  for (let i = 0; i < octaves; i++) {
    value += amplitude * perlin.noise(frequency * x, frequency * z);
    amplitude *= persistence;
    frequency *= lacunarity;
  }
  return value;
