<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CRIMSON SOVEREIGN – Smart AI + Super Art Engine</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;touch-action:none}
  body{background:#010105;overflow:hidden;font-family:system-ui,sans-serif;color:#fff}
  canvas{display:block;width:100vw;height:100vh}
  #ui{
    position:absolute;top:12px;left:12px;z-index:30;
    background:rgba(0,0,0,0.82);backdrop-filter:blur(12px);
    border:1px solid #ff3355;border-radius:12px;
    padding:12px 16px;font-size:13px;line-height:1.45;
    max-width:340px;pointer-events:none;
  }
  #ui b{color:#ff4466}
  #status{color:#88ffcc;font-size:12px;margin-top:6px}
  #mobile-controls{
    position:absolute;bottom:18px;left:0;right:0;z-index:25;
    display:none;justify-content:space-between;padding:0 18px;pointer-events:none;
  }
  .btn{
    width:68px;height:68px;border-radius:50%;
    background:rgba(255,50,80,0.4);border:2px solid #ff4466;
    display:flex;align-items:center;justify-content:center;
    font-size:13px;font-weight:bold;color:#fff;user-select:none;
  }
  #joystick{
    width:108px;height:108px;border-radius:50%;
    background:rgba(255,255,255,0.07);border:2px solid rgba(255,100,120,0.5);
    position:relative;
  }
  #knob{
    width:46px;height:46px;border-radius:50%;background:#ff4466;
    position:absolute;top:31px;left:31px;
  }
</style>
</head>
<body>

<div id="ui">
  <b>CRIMSON SOVEREIGN</b><br>
  Smart AI + Super Art + Auto Glitch Fix<br>
  <div id="status">AI systems online • Glitch guardian active</div>
</div>

<div id="mobile-controls">
  <div id="joystick"><div id="knob"></div></div>
  <div class="btn" id="btn-jump">JUMP</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ================================================================
   CRIMSON SOVEREIGN – SMART AI + SUPER ART + AUTO GLITCH FIX
   JavaScript Super Engine
   ================================================================ */

const IS_MOBILE = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent);
const IS_LOW = IS_MOBILE || (navigator.hardwareConcurrency || 4) <= 4;

// -------------------- AUTO GLITCH FIX SYSTEM --------------------
class GlitchGuardian {
  constructor(engine) {
    this.engine = engine;
    this.checks = 0;
  }

  // Run every few frames – detects and auto-fixes common glitches
  update() {
    this.checks++;
    if (this.checks % 30 !== 0) return; // every ~0.5s

    const body = this.engine.playerBody;
    // Fix NaN / Infinity positions
    if (!isFinite(body.position.x) || !isFinite(body.position.y) || !isFinite(body.position.z)) {
      console.warn("GlitchGuardian: NaN position fixed");
      body.position.set(0, 5, 18);
      body.velocity.set(0, 0, 0);
    }
    // Fix extreme velocity (explosion / tunneling)
    if (body.velocity.length() > 80) {
      body.velocity.multiplyScalar(0.1);
    }
    // Fix stuck underground
    if (body.position.y < -5) {
      body.position.y = 5;
      body.velocity.y = 0;
    }
    // Fix AI bodies too
    this.engine.aiAgents.forEach(agent => {
      if (!isFinite(agent.body.position.x)) {
        agent.body.position.copy(agent.home);
        agent.body.velocity.set(0,0,0);
      }
    });
  }
}

// -------------------- SMART AI SYSTEM --------------------
class SmartAI {
  constructor(mesh, homePos) {
    this.mesh = mesh;
    this.body = new PhysicsBody(mesh, { mass: 0.8, radius: 1.1, isStatic: false });
    this.home = homePos.clone();
    this.state = "idle"; // idle | wander | chase | return
    this.timer = 0;
    this.target = new THREE.Vector3();
    this.speed = 6 + Math.random() * 4;
  }

  update(dt, playerPos) {
    this.timer -= dt;
    const distToPlayer = this.body.position.distanceTo(playerPos);

    // Simple state machine (smart behavior)
    if (distToPlayer < 14) {
      this.state = "chase";
    } else if (this.state === "chase" && distToPlayer > 22) {
      this.state = "return";
    } else if (this.timer <= 0) {
      this.state = Math.random() > 0.4 ? "wander" : "idle";
      this.timer = 2 + Math.random() * 3;
      if (this.state === "wander") {
        this.target.set(
          this.home.x + (Math.random()-0.5)*18,
          this.home.y,
          this.home.z + (Math.random()-0.5)*18
        );
      }
    }

    // Act on state
    let move = new THREE.Vector3();
    if (this.state === "chase") {
      move.subVectors(playerPos, this.body.position).normalize().multiplyScalar(this.speed * 1.3);
    } else if (this.state === "wander" || this.state === "return") {
      const goal = this.state === "return" ? this.home : this.target;
      move.subVectors(goal, this.body.position);
      if (move.length() > 1.5) {
        move.normalize().multiplyScalar(this.speed);
      } else {
        this.state = "idle";
      }
    }

    this.body.velocity.x = move.x;
    this.body.velocity.z = move.z;

    // Look at movement
    if (move.lengthSq() > 0.1) {
      this.mesh.lookAt(this.body.position.x + move.x, this.body.position.y, this.body.position.z + move.z);
    }
  }
}

// -------------------- SUPER ART (procedural living shapes) --------------------
class SuperArt {
  static createLivingOrb(radius, color) {
    const geo = new THREE.SphereGeometry(radius, 24, 18);
    const mat = new THREE.MeshStandardMaterial({
      color,
      emissive: color,
      emissiveIntensity: 0.35,
      roughness: 0.25,
      metalness: 0.4
    });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.userData.art = true;
    mesh.userData.phase = Math.random() * Math.PI * 2;
    return mesh;
  }

  static updateLiving(mesh, time) {
    if (!mesh.userData.art) return;
    const s = 1 + Math.sin(time * 2 + mesh.userData.phase) * 0.08;
    mesh.scale.setScalar(s);
    mesh.rotation.y += 0.01;
    mesh.material.emissiveIntensity = 0.25 + Math.sin(time * 3 + mesh.userData.phase) * 0.2;
  }
}

// -------------------- PHYSICS (same stable core) --------------------
class PhysicsBody {
  constructor(mesh, opts = {}) {
    this.mesh = mesh;
    this.position = mesh.position;
    this.velocity = new THREE.Vector3();
    this.force = new THREE.Vector3();
    this.mass = opts.mass || 1;
    this.radius = opts.radius || 1;
    this.restitution = opts.restitution || 0.25;
    this.friction = opts.friction || 0.84;
    this.isStatic = opts.isStatic || false;
    this.onGround = false;
  }
  applyForce(f) { if (!this.isStatic) this.force.add(f); }
  integrate(dt) {
    if (this.isStatic) return;
    this.velocity.add(this.force.clone().divideScalar(this.mass).multiplyScalar(dt));
    this.position.add(this.velocity.clone().multiplyScalar(dt));
    this.force.set(0,0,0);
    this.velocity.multiplyScalar(0.993);
  }
}

class PhysicsWorld {
  constructor() {
    this.bodies = [];
    this.gravity = new THREE.Vector3(0, -30, 0);
    this.fixedDt = 1/60;
    this.acc = 0;
  }
  add(b) { this.bodies.push(b); }
  step(dt) {
    this.acc += Math.min(dt, 0.05);
    while (this.acc >= this.fixedDt) {
      this.fixedUpdate(this.fixedDt);
      this.acc -= this.fixedDt;
    }
  }
  fixedUpdate(dt) {
    for (const b of this.bodies) if (!b.isStatic) b.applyForce(this.gravity.clone().multiplyScalar(b.mass));
    for (const b of this.bodies) b.integrate(dt);
    this.resolve();
  }
  resolve() {
    const groundY = 0;
    for (const body of this.bodies) {
      if (body.isStatic) continue;
      if (body.position.y - body.radius < groundY) {
        body.position.y = groundY + body.radius;
        if (body.velocity.y < 0) {
          body.velocity.y *= -body.restitution;
          body.velocity.x *= body.friction;
          body.velocity.z *= body.friction;
        }
        body.onGround = true;
      } else body.onGround = false;

      for (const other of this.bodies) {
        if (other === body || !other.isStatic) continue;
        const box = new THREE.Box3().setFromObject(other.mesh);
        const closest = new THREE.Vector3(
          Math.max(box.min.x, Math.min(body.position.x, box.max.x)),
          Math.max(box.min.y, Math.min(body.position.y, box.max.y)),
          Math.max(box.min.z, Math.min(body.position.z, box.max.z))
        );
        const distVec = body.position.clone().sub(closest);
        const dist = distVec.length();
        if (dist < body.radius && dist > 0.0001) {
          const n = distVec.normalize();
          body.position.add(n.clone().multiplyScalar(body.radius - dist + 0.002));
          const vn = body.velocity.dot(n);
          if (vn < 0) {
            body.velocity.add(n.clone().multiplyScalar(-(1 + body.restitution) * vn));
            const tan = body.velocity.clone().sub(n.clone().multiplyScalar(body.velocity.dot(n)));
            body.velocity.sub(tan.multiplyScalar(1 - body.friction));
          }
        }
      }
    }
  }
}

// -------------------- SHAPE FACTORY --------------------
function mat(c) {
  return new THREE.MeshStandardMaterial({ color: c, roughness: 0.33, metalness: 0.18 });
}
function sphere(r,c){return new THREE.Mesh(new THREE.SphereGeometry(r,IS_LOW?16:28,IS_LOW?12:20),mat(c));}
function cube(s,c){return new THREE.Mesh(new THREE.BoxGeometry(s,s,s),mat(c));}
function prism(w,h,d,c){return new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c));}
function cylinder(r,h,c){return new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,IS_LOW?14:28),mat(c));}
function cone(r,h,c){return new THREE.Mesh(new THREE.ConeGeometry(r,h,IS_LOW?14:28),mat(c));}
function pyramid(s,c){return new THREE.Mesh(new THREE.TetrahedronGeometry(s),mat(c));}

// -------------------- MAIN ENGINE --------------------
class AISuperArtEngine {
  constructor() {
    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x010105);
    this.scene.fog = new THREE.FogExp2(0x010105, 0.010);

    this.camera = new THREE.PerspectiveCamera(65, innerWidth/innerHeight, 0.1, 350);
    this.renderer = new THREE.WebGLRenderer({ antialias: !IS_LOW, powerPreference: "high-performance" });
    this.renderer.setSize(innerWidth, innerHeight);
    this.renderer.setPixelRatio(IS_LOW ? 1 : Math.min(devicePixelRatio, 1.75));
    this.renderer.shadowMap.enabled = !IS_LOW;
    document.body.appendChild(this.renderer.domElement);

    this.scene.add(new THREE.AmbientLight(0x2a2a48, 0.55));
    const sun = new THREE.DirectionalLight(0xfff0e0, 1.2);
    sun.position.set(22, 40, 15);
    sun.castShadow = !IS_LOW;
    this.scene.add(sun);

    this.physics = new PhysicsWorld();
    this.aiAgents = [];
    this.artObjects = [];
    this.guardian = new GlitchGuardian(this);

    // Player
    this.playerMesh = sphere(1.15, 0xff3355);
    this.playerMesh.castShadow = true;
    this.scene.add(this.playerMesh);
    this.playerBody = new PhysicsBody(this.playerMesh, { mass: 1.15, radius: 1.15 });
    this.physics.add(this.playerBody);

    this.buildWorld();
    this.spawnAI();
    this.spawnSuperArt();
    this.setupInput();
    this.clock = new THREE.Clock();
    this.animate();
  }

  buildWorld() {
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(280, 280),
      new THREE.MeshStandardMaterial({ color: 0x08080f, roughness: 0.94 })
    );
    ground.rotation.x = -Math.PI/2;
    ground.receiveShadow = true;
    this.scene.add(ground);

    const shapes = [
      {fn:sphere, args:[3.4,0xff2244], pos:[-19,3.4,0]},
      {fn:cube, args:[5,0x33ff88], pos:[-8,2.5,0]},
      {fn:prism, args:[7,3.6,4.2,0x4488ff], pos:[4,1.8,0]},
      {fn:cylinder, args:[2.9,6.8,0xffaa22], pos:[14,3.4,0]},
      {fn:cone, args:[3.6,7.8,0xcc44ff], pos:[24,3.9,0]},
      {fn:pyramid, args:[4.6,0xff6688], pos:[0,3.4,-13]}
    ];
    shapes.forEach(s => {
      const m = s.fn(...s.args);
      m.position.set(...s.pos);
      m.castShadow = true;
      this.scene.add(m);
      this.physics.add(new PhysicsBody(m, {isStatic:true}));
    });
    this.scene.add(new THREE.GridHelper(100,50,0x222244,0x111122));
  }

  spawnAI() {
    for (let i = 0; i < (IS_LOW ? 3 : 6); i++) {
      const m = sphere(1.05, 0x66aaff);
      m.position.set((Math.random()-0.5)*30, 2, (Math.random()-0.5)*30);
      this.scene.add(m);
      const agent = new SmartAI(m, m.position.clone());
      this.physics.add(agent.body);
      this.aiAgents.push(agent);
    }
  }

  spawnSuperArt() {
    for (let i = 0; i < (IS_LOW ? 4 : 8); i++) {
      const orb = SuperArt.createLivingOrb(0.7 + Math.random()*0.9, new THREE.Color().setHSL(Math.random(), 0.7, 0.55));
      orb.position.set((Math.random()-0.5)*40, 1.5 + Math.random()*4, (Math.random()-0.5)*40);
      this.scene.add(orb);
      this.artObjects.push(orb);
    }
  }

  setupInput() {
    this.keys = {};
    this.mobileMove = new THREE.Vector2();
    this.jump = false;

    window.addEventListener("keydown", e => this.keys[e.code]=true);
    window.addEventListener("keyup", e => this.keys[e.code]=false);

    if (IS_MOBILE) {
      document.getElementById("mobile-controls").style.display = "flex";
      // simple joystick
      const joy = document.getElementById("joystick");
      const knob = document.getElementById("knob");
      let active=false, sx, sy;
      joy.addEventListener("touchstart", e => {
        e.preventDefault(); active=true;
        sx = e.touches[0].clientX; sy = e.touches[0].clientY;
      });
      joy.addEventListener("touchmove", e => {
        if (!active) return; e.preventDefault();
        const dx = e.touches[0].clientX - sx;
        const dy = e.touches[0].clientY - sy;
        const max=30, len=Math.min(Math.hypot(dx,dy),max);
        const a=Math.atan2(dy,dx);
        knob.style.transform=`translate(${Math.cos(a)*len}px,${Math.sin(a)*len}px)`;
        this.mobileMove.set(Math.cos(a)*(len/max), Math.sin(a)*(len/max));
      });
      const end=()=>{active=false;knob.style.transform="translate(0,0)";this.mobileMove.set(0,0);};
      joy.addEventListener("touchend",end);
      document.getElementById("btn-jump").addEventListener("touchstart", e=>{e.preventDefault();this.jump=true;});
      document.getElementById("btn-jump").addEventListener("touchend", ()=>this.jump=false);
    }

    window.addEventListener("resize", ()=>{
      this.camera.aspect=innerWidth/innerHeight;
      this.camera.updateProjectionMatrix();
      this.renderer.setSize(innerWidth,innerHeight);
    });
  }

  update(dt) {
    // Player input
    const move = new THREE.Vector3();
    if (this.keys["KeyW"] || this.mobileMove.y < -0.25) move.z -= 1;
    if (this.keys["KeyS"] || this.mobileMove.y > 0.25) move.z += 1;
    if (this.keys["KeyA"] || this.mobileMove.x < -0.25) move.x -= 1;
    if (this.keys["KeyD"] || this.mobileMove.x > 0.25) move.x += 1;

    const speed = IS_LOW ? 15 : 21;
    if (move.lengthSq() > 0) {
      move.normalize().multiplyScalar(speed);
      this.playerBody.velocity.x = move.x;
      this.playerBody.velocity.z = move.z;
    } else {
      this.playerBody.velocity.x *= 0.86;
      this.playerBody.velocity.z *= 0.86;
    }

    if ((this.keys["Space"] || this.jump) && this.playerBody.onGround) {
      this.playerBody.velocity.y = 14.2;
      this.playerBody.onGround = false;
      this.jump = false;
    }

    // Physics
    this.physics.step(dt);
    this.playerMesh.position.copy(this.playerBody.position);

    // Smart AI
    this.aiAgents.forEach(a => {
      a.update(dt, this.playerBody.position);
      a.mesh.position.copy(a.body.position);
    });

    // Super Art animation
    const t = this.clock.elapsedTime;
    this.artObjects.forEach(o => SuperArt.updateLiving(o, t));

    // Auto glitch fix
    this.guardian.update();

    // Camera
    const camTarget = this.playerBody.position.clone().add(new THREE.Vector3(0, 7.2, 15.5));
    this.camera.position.lerp(camTarget, 0.09);
    this.camera.lookAt(this.playerBody.position.x, this.playerBody.position.y + 1.3, this.playerBody.position.z);

    // Status
    document.getElementById("status").textContent =
      `AI agents: ${this.aiAgents.length} | Super Art: ${this.artObjects.length} | Glitch Guardian: Active`;
  }

  animate() {
    requestAnimationFrame(() => this.animate());
    this.update(this.clock.getDelta());
    this.renderer.render(this.scene, this.camera);
  }
}

// Launch
new AISuperArtEngine();
</script>
</body>
</html>